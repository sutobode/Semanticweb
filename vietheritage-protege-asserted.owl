    <skos:altLabel xml:lang="vi">Lễ hội Lồng tồng</skos:altLabel>
    <rdfs:label xml:lang="vi">Lễ hội Lồng tồng của người Tày</rdfs:label>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lễ hội Lồng tồng</vh:sourceTitle>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789"/>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_L%E1%BB%93ng_t%E1%BB%93ng"/>
