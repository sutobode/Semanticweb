    <rdfs:label xml:lang="vi">Chữ Nôm của người Dao</rdfs:label>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/NationalIntangibleHeritage"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/IntangibleHeritage"/>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <vh:locatedIn rdf:resource="http://localhost:3030/vietheritage/resource/area-name-e163ea76112a"/>
    <skos:altLabel xml:lang="vi">Chữ Nôm Dao</skos:altLabel>
    <rdfs:comment xml:lang="vi">Chữ Nôm Dao là chữ viết của người Dao, dựa trên chữ Hán và đã được Dao hóa. Chữ Nôm Dao cũng được viết tại Quế Bình, Vân Nam, Long Thắng, Lăng Vân (Bách Sắc, Quảng Tây),huyện Tân Ninh (Thiệu Dương, Hồ Nam) ở Trung Quốc.&#13;
Chữ Nôm Dao (tại các tỉnh Lào Cai, Thái Nguyên) là di sản văn hóa phi vật thể cấp quốc gia của Việt Nam.</rdfs:comment>
    <dcterms:subject>national_intangible</dcterms:subject>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chữ Nôm Dao</vh:sourceTitle>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14440663</vh:sourcePageId>
    <dcterms:description xml:lang="vi">Chữ Nôm Dao là chữ viết của người Dao, dựa trên chữ Hán và đã được Dao hóa. Chữ Nôm Dao cũng được viết tại Quế Bình, Vân Nam, Long Thắng, Lăng Vân (Bách Sắc, Quảng Tây),huyện Tân Ninh (Thiệu Dương, Hồ Nam) ở Trung Quốc.&#13;
Chữ Nôm Dao (tại các tỉnh Lào Cai, Thái Nguyên) là di sản văn hóa phi vật thể cấp quốc gia của Việt Nam.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/intangible-fcdbfd38cf2d">
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quận Đồ Sơn, Tp. Hải Phòng</vh:address>
    <dcterms:description xml:lang="vi">Lễ hội chọi trâu Đồ Sơn là một tập tục cổ, có từ xa xưa, là một lễ hội truyền thống của người dân vạn chài tại vùng biển Đồ Sơn, Hải Phòng; diễn ra vào ngày 9 tháng 8 Âm lịch hàng năm; là di sản văn hóa phi vật thể quốc gia năm 2020 của Việt Nam. Đây là một lễ hội với lễ nghi trang trọng, rước kiệu thần, có lọng che, phường bát âm....&#13;
Trong văn hóa cộng đồng người dân Hải Phòng, còn lưu truyền câu ca cổ: "Dù ai buôn đâu bán đâu / Mùng chín tháng tám chọi Trâu thì về"</dcterms:description>
    <rdfs:label xml:lang="vi">Lễ hội Chọi trâu Đồ Sơn</rdfs:label>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q10788557"/>
