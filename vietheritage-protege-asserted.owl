    <skos:altLabel xml:lang="vi">Chùa Long Đọi Sơn</skos:altLabel>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chùa Long Đọi Sơn</vh:sourceTitle>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <dcterms:subject>national_special_monuments</dcterms:subject>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HeritageSite"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HistoricalSite"/>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2017</vh:recognitionYear>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/Ch%C3%B9a_Long_%C4%90%E1%BB%8Di_S%C6%A1n"/>
    <dcterms:description xml:lang="vi">Chùa Long Đọi Sơn hay Chùa Đọi Sơn là một ngôi chùa cổ từ thời Lý, đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam. Chùa Đọi Sơn còn giữ được nhiều hiện vật có giá trị đặc biệt như: Bia Sùng Thiện Diên Linh và bộ tượng Kim Cương đã được Thủ tướng Chính phủ ký Quyết định công nhận là Bảo vật quốc gia.&#13;
Chùa nằm trên đỉnh núi Đọi, hiện nay thuộc địa phận phường Tiên Sơn, tỉnh Ninh Bình. Chùa cách trung tâm tỉnh Ninh Bình 42 km về phía bắc, cách thủ đô Hà Nội 50 km về phía nam.</dcterms:description>
    <rdfs:label xml:lang="vi">DTLS Chùa Đọi Sơn</rdfs:label>
    <rdfs:comment xml:lang="vi">Chùa Long Đọi Sơn hay Chùa Đọi Sơn là một ngôi chùa cổ từ thời Lý, đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam. Chùa Đọi Sơn còn giữ được nhiều hiện vật có giá trị đặc biệt như: Bia Sùng Thiện Diên Linh và bộ tượng Kim Cương đã được Thủ tướng Chính phủ ký Quyết định công nhận là Bảo vật quốc gia.&#13;
Chùa nằm trên đỉnh núi Đọi, hiện nay thuộc địa phận phường Tiên Sơn, tỉnh Ninh Bình. Chùa cách trung tâm tỉnh Ninh Bình 42 km về phía bắc, cách thủ đô Hà Nội 50 km về phía nam.</rdfs:comment>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1469958</vh:sourcePageId>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-fd240c2575e5">
    <vh:locatedIn rdf:resource="http://localhost:3030/vietheritage/resource/area-name-cff49d8e0895"/>
