    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chùa Bút Tháp</vh:sourceTitle>
    <skos:altLabel xml:lang="vi">Chùa Bút Tháp</skos:altLabel>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
