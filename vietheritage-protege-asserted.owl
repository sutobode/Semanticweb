  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/intangible-edfcb45ac84a">
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/H%E1%BB%99i_Gi%C3%B3ng"/>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/hoi-giong-o-den-phu-dong-va-den-soc-486"/>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789"/>
    <skos:altLabel xml:lang="vi">Hội Gióng</skos:altLabel>
    <skos:altLabel xml:lang="vi">Hội Gióng đền Phù Đổng và đền Sóc</skos:altLabel>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
