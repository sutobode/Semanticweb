  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-ea4bcd24fbcb">
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q10807145"/>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/Qu%E1%BA%A7n_th%E1%BB%83_di_t%C3%ADch_Ph%E1%BB%91_Hi%E1%BA%BFn"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-khu-di-tich-pho-hien-2992"/>
    <dcterms:description xml:lang="vi">Phố Hiến (chữ Nôm: 庯憲) là một địa danh lịch sử nổi tiếng ở tỉnh Hưng Yên. Vào các thế kỷ XVI - XVII, nơi đây từng là một thương cảng sầm uất và lớn bậc nhất của nước Đại Việt. Khi đó, Phố Hiến phát triển thành một đô thị phồn thịnh, trải dài dọc theo bờ tả ngạn sông Hồng. Đây là điểm giao thương kinh tế quan trọng, nơi quy tụ nhiều thương nhân và thuyền buôn trong nước cũng như nước ngoài, chủ yếu đến từ các quốc gia như Nhật Bản, Trung Quốc, Hà Lan, Anh, Pháp, Bồ Đào Nha...&#13;
Bên cạnh kinh đô Thăng Long - Kẻ Chợ là thủ đô phồn vinh nhất nước, Phố Hiến được xem là một đô thị nổi bật đứng ở vị trí thứ hai. Danh tiếng của Phố Hiến được dân gian tương truyền qua câu ca: "Thứ nhất Kinh Kỳ, thứ nhì Phố Hiến". Văn bia chùa Thiên Ứng, dựng năm Vĩnh Tộ thứ 7 (1625) đời vua Lê Thần Tông, đã ghi: "Phố Hiến nổi tiếng trong bốn phương là một tiểu Tràng An" - tức một kinh đô thu nhỏ.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
