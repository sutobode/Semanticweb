    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/ArchitecturalSite"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HeritageSite"/>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q1069757"/>
