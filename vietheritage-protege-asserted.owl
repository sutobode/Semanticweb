    <rdfs:label xml:lang="vi">Thạp đồng Đào Thịnh</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/Th%E1%BA%A1p_%C4%91%E1%BB%93ng_%C4%90%C3%A0o_Th%E1%BB%8Bnh"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/bao-vat-quoc-gia-1758"/>
    <dcterms:description xml:lang="vi">Thạp đồng Đào Thịnh là một hiện vật bằng đồng thuộc nền văn hóa Đông Sơn. Thạp được phát hiện năm 1961, được xác định có niên đại từ 2500 - 2000 năm cách ngày nay. Thạp là một trong những bảo vật quốc gia đầu tiên của Việt Nam được Thủ tướng Chính phủ công nhận năm 2012, hiện đang lưu giữ ở Bảo tàng Lịch sử Quốc gia Việt Nam.</dcterms:description>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thạp đồng Đào Thịnh</vh:sourceTitle>
