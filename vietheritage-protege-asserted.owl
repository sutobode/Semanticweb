    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Thanh Hóa</vh:address>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/Hang_Con_Moong"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/di-tich-khao-co-hang-con-moong-va-cac-di-tich-phu-can-1284"/>
    <geo1:long rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">105.605</geo1:long>
    <dcterms:description xml:lang="vi">Hang Con Moong (theo tiếng địa phương có nghĩa là "hang con thú") là một hang đá trong Vườn quốc gia Cúc Phương. Tuy Vườn quốc gia Cúc Phương phần lớn thuộc tỉnh Ninh Bình nhưng hang Con Moong lại thuộc xã Thành Vinh, tỉnh Thanh Hóa. Ngày 23/11/2016, hang Con Moong và các di tích phụ cận đã được công nhận là Di tích quốc gia đặc biệt.</dcterms:description>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">41571</vh:sourcePageId>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <dcterms:subject>national_special_monuments</dcterms:subject>
    <rdfs:comment xml:lang="vi">Hang Con Moong (theo tiếng địa phương có nghĩa là "hang con thú") là một hang đá trong Vườn quốc gia Cúc Phương. Tuy Vườn quốc gia Cúc Phương phần lớn thuộc tỉnh Ninh Bình nhưng hang Con Moong lại thuộc xã Thành Vinh, tỉnh Thanh Hóa. Ngày 23/11/2016, hang Con Moong và các di tích phụ cận đã được công nhận là Di tích quốc gia đặc biệt.</rdfs:comment>
    <rdfs:label xml:lang="vi">DTKC Hang con Moong và các di tích phụ cận</rdfs:label>
