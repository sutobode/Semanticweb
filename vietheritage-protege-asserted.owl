  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/period-950fb3bb2b11">
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-06T00:00:00</dcterms:modified>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HistoricalPeriod"/>
    <rdfs:comment xml:lang="vi">gắn liền với tên tuổi của ba anh em Nguyễn Nhạc, Nguyễn Huệ và Nguyễn Lữ của phong trào khởi nghĩa Tây Sơn, triều đại Tây Sơn cuối thế kỷ XVIII, tiêu biểu là vị anh hùng dân tộc Quang Trung - Nguyễn Huệ.</rdfs:comment>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/di-tich-lich-su-khu-den-tho-tay-son-tam-kiet-2985"/>
    <skos:altLabel xml:lang="vi">Triều đại Tây Sơn</skos:altLabel>
    <rdfs:label xml:lang="vi">Nhà Tây Sơn</rdfs:label>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <dcterms:description xml:lang="vi">gắn liền với tên tuổi của ba anh em Nguyễn Nhạc, Nguyễn Huệ và Nguyễn Lữ của phong trào khởi nghĩa Tây Sơn, triều đại Tây Sơn cuối thế kỷ XVIII, tiêu biểu là vị anh hùng dân tộc Quang Trung - Nguyễn Huệ.</dcterms:description>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/di-tich-lich-su-khu-den-tho-tay-son-tam-kiet-2985"/>
