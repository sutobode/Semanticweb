  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/intangible-d835862e04c5">
    <dcterms:subject>national_intangible</dcterms:subject>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/IntangibleHeritage"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/NationalIntangibleHeritage"/>
    <rdfs:comment xml:lang="vi">Xẩm là một loại hình dân ca của Việt Nam, phổ biến ở đồng bằng và trung du Bắc Bộ. "Xẩm" còn được dùng để chỉ những người hành nghề hát xẩm. Nghệ nhân Hà Thị Cầu (1928–2013) được coi là người hát xẩm cuối cùng của thế kỷ XX và tỉnh Ninh Bình đang có những nỗ lực đệ trình UNESCO công nhận hát xẩm là di sản văn hóa thế giới cần được bảo vệ khẩn cấp.&#13;
Hát Xẩm xưa thường là một hình thức mưu sinh của những người dân, ngày nay nghệ thuật xẩm được sân khấu hóa và đưa vào phục vụ khách du lịch. Xẩm đa số được biểu diễn ở chợ, đường phố, nơi đông người qua lại. Hát xẩm có tính ngẫu hứng và người biểu diễn có thể bật ra câu hát ngay khi thể hiện.</rdfs:comment>
    <rdfs:label xml:lang="vi">Nghệ thuật Hát Xẩm</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/X%E1%BA%A9m"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789"/>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Ninh Bình</vh:address>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/X%E1%BA%A9m"/>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789"/>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xẩm</vh:sourceTitle>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q10836741"/>
    <skos:altLabel xml:lang="vi">Xẩm</skos:altLabel>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2022</vh:recognitionYear>
    <vh:locatedIn rdf:resource="http://localhost:3030/vietheritage/resource/area-name-dca800e51853"/>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">214452</vh:sourcePageId>
    <dcterms:description xml:lang="vi">Xẩm là một loại hình dân ca của Việt Nam, phổ biến ở đồng bằng và trung du Bắc Bộ. "Xẩm" còn được dùng để chỉ những người hành nghề hát xẩm. Nghệ nhân Hà Thị Cầu (1928–2013) được coi là người hát xẩm cuối cùng của thế kỷ XX và tỉnh Ninh Bình đang có những nỗ lực đệ trình UNESCO công nhận hát xẩm là di sản văn hóa thế giới cần được bảo vệ khẩn cấp.&#13;
Hát Xẩm xưa thường là một hình thức mưu sinh của những người dân, ngày nay nghệ thuật xẩm được sân khấu hóa và đưa vào phục vụ khách du lịch. Xẩm đa số được biểu diễn ở chợ, đường phố, nơi đông người qua lại. Hát xẩm có tính ngẫu hứng và người biểu diễn có thể bật ra câu hát ngay khi thể hiện.</dcterms:description>
  </rdf:Description>
