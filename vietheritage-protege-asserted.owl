  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-ce4d3b80da77">
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q3917231"/>
    <vh:associatedWithEvent rdf:resource="http://localhost:3030/vietheritage/resource/event-51a97bb466db"/>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/Th%C3%A0nh_%C4%90i%E1%BB%87n_H%E1%BA%A3i"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <rdfs:comment xml:lang="vi">Thành Điện Hải là một di tích quốc gia đặc biệt tọa lạc tại thành phố Đà Nẵng, Việt Nam. Tòa thành được xây dựng lần đầu vào năm Gia Long thứ 12 (năm 1813) với mục đích kiểm soát tàu thuyền và trấn giữ Đà Nẵng. Đến năm Minh Mạng thứ 4 (năm 1823), thành được di dời và xây dựng lại theo kiến trúc kiểu Vauban. Đây là thành lũy có vai trò vô cùng quan trọng góp phần đánh bại cuộc tấn công của thực dân Pháp vào Đà Nẵng những năm 1858–1860.</rdfs:comment>
    <vh:builtBy rdf:resource="http://localhost:3030/vietheritage/resource/person-wikidata-q210417"/>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19562172</vh:sourcePageId>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thành Điện Hải</vh:sourceTitle>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
