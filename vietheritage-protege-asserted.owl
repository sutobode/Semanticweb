    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đền Trần Thương</vh:sourceTitle>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <geo1:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20.5761573</geo1:lat>
    <rdfs:label xml:lang="vi">DTLS và KTNT Đền Trần Thương</rdfs:label>
    <rdfs:comment xml:lang="vi">Đền Trần Thương là một ngôi đền thờ Trần Hưng Đạo được dựng lên ngay trên phần đất khi xưa ông dùng làm kho lương phục vụ cuộc kháng chiến chống quân Nguyên - Mông lần 2. Đền Trần Thương nằm ở xã Trần Thương, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới đền Trần Thương 50 km. Đây là ngôi đền lớn thờ Trần Hưng Đạo đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam và gắn với lễ hội phát lương Đức Thánh Trần diễn ra hàng năm.</rdfs:comment>
    <skos:altLabel xml:lang="vi">Đền Trần Thương</skos:altLabel>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <dcterms:subject>national_special_monuments</dcterms:subject>
    <dcterms:description xml:lang="vi">Đền Trần Thương là một ngôi đền thờ Trần Hưng Đạo được dựng lên ngay trên phần đất khi xưa ông dùng làm kho lương phục vụ cuộc kháng chiến chống quân Nguyên - Mông lần 2. Đền Trần Thương nằm ở xã Trần Thương, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới đền Trần Thương 50 km. Đây là ngôi đền lớn thờ Trần Hưng Đạo đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam và gắn với lễ hội phát lương Đức Thánh Trần diễn ra hàng năm.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-den-tran-thuong-1313"/>
