  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/intangible-9df53d7c8bfa">
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789"/>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/X%C3%B2e_Th%C3%A1i"/>
    <dcterms:description xml:lang="vi">Xòe Thái hay xòe, xe, hay ít phổ biến hơn là mố, múa xòe, múa then, hát then là loại hình văn hóa dân gian của người Thái tại Việt Nam. Ngày 15/ 12/2021 tại Phiên họp Uỷ ban Liên Chính phủ Công ước 2003 về bảo vệ di sản văn hóa phi vật thể lần thứ 16 của UNESCO diễn ra tại Paris, thủ đô nước Cộng hòa Pháp, di sản Nghệ thuật Xòe Thái của Việt Nam chính thức được UNESCO ghi danh vào Danh sách Di sản văn hóa phi vật thể đại diện của nhân loại.&#13;
&#13;
Người Thái có câu:&#13;
&#13;
Không xòe, không tốt lúa&#13;
Không xòe, thóc cạn bồ&#13;
Không xòe, hoa sẽ tàn héo&#13;
Không xòe, trai gái không thành đôi</dcterms:description>
    <skos:altLabel xml:lang="vi">Xòe Thái</skos:altLabel>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789"/>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/X%C3%B2e_Th%C3%A1i"/>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2015</vh:recognitionYear>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Sơn La</vh:address>
    <dcterms:subject>national_intangible</dcterms:subject>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/NationalIntangibleHeritage"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/IntangibleHeritage"/>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19608258</vh:sourcePageId>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xòe Thái</vh:sourceTitle>
