  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-b55651032efb">
    <dcterms:source rdf:resource="https://dsvh.gov.vn/di-tich-khao-co-hang-con-moong-va-cac-di-tich-phu-can-1284"/>
