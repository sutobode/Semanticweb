  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-6164fd1b14fb">
    <dcterms:subject>national_special_monuments</dcterms:subject>
    <rdfs:label xml:lang="vi">DTLS và DLTC Quần thể Hương Sơn</rdfs:label>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Hà Nội</vh:address>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/Ch%C3%B9a_H%C6%B0%C6%A1ng"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24774</vh:sourcePageId>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/Ch%C3%B9a_H%C6%B0%C6%A1ng"/>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <vh:locatedIn rdf:resource="http://localhost:3030/vietheritage/resource/area-name-8de4ed043a59"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HeritageSite"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HistoricalSite"/>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q7168306"/>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2017</vh:recognitionYear>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <dcterms:description xml:lang="vi">Chùa Hương (cách gọi dân gian) hay Hương Sơn là một quần thể văn hóa - tôn giáo của Việt Nam, gồm hàng chục ngôi chùa thờ Phật, các ngôi đền thờ Thần và các ngôi đình thờ tín ngưỡng nông nghiệp. Trung tâm của cụm đình đền chùa này là chùa Hương (tức chùa Trong) nằm trong động Hương Tích ở hữu ngạn sông Đáy, thuộc xã Hương Sơn, Hà Nội. Quần thể Hương Sơn là một trong 21 Khu du lịch Quốc gia của Việt Nam và là Di tích Quốc gia Đặc biệt theo quyết định 2082/QĐ-TTg năm 2017.</dcterms:description>
    <rdfs:comment xml:lang="vi">Chùa Hương (cách gọi dân gian) hay Hương Sơn là một quần thể văn hóa - tôn giáo của Việt Nam, gồm hàng chục ngôi chùa thờ Phật, các ngôi đền thờ Thần và các ngôi đình thờ tín ngưỡng nông nghiệp. Trung tâm của cụm đình đền chùa này là chùa Hương (tức chùa Trong) nằm trong động Hương Tích ở hữu ngạn sông Đáy, thuộc xã Hương Sơn, Hà Nội. Quần thể Hương Sơn là một trong 21 Khu du lịch Quốc gia của Việt Nam và là Di tích Quốc gia Đặc biệt theo quyết định 2082/QĐ-TTg năm 2017.</rdfs:comment>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chùa Hương</vh:sourceTitle>
    <skos:altLabel xml:lang="vi">Chùa Hương</skos:altLabel>
  </rdf:Description>
