    <vh:locatedIn rdf:resource="http://localhost:3030/vietheritage/resource/area-name-8de4ed043a59"/>
    <vh:associatedWithPerson rdf:resource="http://localhost:3030/vietheritage/resource/person-wikidata-q25418141"/>
    <vh:associatedWithPerson rdf:resource="http://localhost:3030/vietheritage/resource/person-wikidata-q25418142"/>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2013</vh:recognitionYear>
    <dcterms:description xml:lang="vi">Đền Hai Bà Trưng còn gọi là đền Hạ Lôi ở thôn Hạ Lôi xã Mê Linh, thành phố Hà Nội. Đền thờ hai vị liệt nữ - anh hùng dân tộc là Trưng Trắc và Trưng Nhị.&#13;
Để tưởng nhớ công đức của Hai Bà, nhân dân đã lập đền thờ tại thôn Hạ Lôi, xã Mê Linh, huyện Mê Linh, hàng năm tổ chức lễ hội tưởng nhớ công đức của Hai Bà và các tướng lĩnh từ ngày mùng 4 đến mùng 10 tháng Giêng.&#13;
Đền thờ Hai Bà Trưng được công nhận di tích lịch sử - văn hóa cấp quốc gia năm 1980.</dcterms:description>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14584334</vh:sourcePageId>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
