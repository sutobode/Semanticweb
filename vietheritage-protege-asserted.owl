    <dcterms:subject>national_special_monuments</dcterms:subject>
    <rdfs:comment xml:lang="vi">Đền Phù Đổng hay còn gọi là đền Gióng thờ Thánh Gióng – Phù Đổng Thiên Vương, nằm ở xã Phù Đổng, ngoại thành Hà Nội.&#13;
Đền Phù Đổng còn được gọi là đền Thượng, tương truyền được dựng trên nền nhà cũ của Thánh Gióng, bên trong đê sông Đuống, còn đền Hạ (đền mẫu) thờ mẹ của Thánh Gióng nằm ngoài đê, gần nơi được cho là có dấu chân khổng lồ mà bà đã ướm thử rồi sinh ra Thánh Gióng. Năm 1010 khi dời đô về Thăng Long, Lý Thái Tổ đã cho dựng đền, đến nay đã được trùng tu nhiều lần.</rdfs:comment>
    <skos:altLabel xml:lang="vi">Đền Phù Đổng</skos:altLabel>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đền Phù Đổng</vh:sourceTitle>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HistoricalSite"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HeritageSite"/>
    <dcterms:description xml:lang="vi">Đền Phù Đổng hay còn gọi là đền Gióng thờ Thánh Gióng – Phù Đổng Thiên Vương, nằm ở xã Phù Đổng, ngoại thành Hà Nội.&#13;
Đền Phù Đổng còn được gọi là đền Thượng, tương truyền được dựng trên nền nhà cũ của Thánh Gióng, bên trong đê sông Đuống, còn đền Hạ (đền mẫu) thờ mẹ của Thánh Gióng nằm ngoài đê, gần nơi được cho là có dấu chân khổng lồ mà bà đã ướm thử rồi sinh ra Thánh Gióng. Năm 1010 khi dời đô về Thăng Long, Lý Thái Tổ đã cho dựng đền, đến nay đã được trùng tu nhiều lần.</dcterms:description>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q10841695"/>
    <vh:associatedWithPerson rdf:resource="http://localhost:3030/vietheritage/resource/person-wikidata-q7799843"/>
    <vh:builtBy rdf:resource="http://localhost:3030/vietheritage/resource/person-wikidata-q716945"/>
    <rdfs:label xml:lang="vi">DTLS Đền Phù Đổng</rdfs:label>
    <vh:hasRelatedSite rdf:resource="http://localhost:3030/vietheritage/resource/site-14c37bbb06ef"/>
  </rdf:Description>
