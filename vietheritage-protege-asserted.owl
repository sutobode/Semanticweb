  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-4e7253030836">
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">108941</vh:sourcePageId>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <vh:associatedWithPerson rdf:resource="http://localhost:3030/vietheritage/resource/person-wikidata-q10788162"/>
    <vh:locatedIn rdf:resource="http://localhost:3030/vietheritage/resource/area-name-8de4ed043a59"/>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đình Chèm</vh:sourceTitle>
    <skos:altLabel xml:lang="vi">Đình Chèm</skos:altLabel>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/ArchitecturalSite"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HeritageSite"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Ch%C3%A8m"/>
    <dcterms:description xml:lang="vi">Đình Chèm là ngôi đình của làng Thụy Phương (tên Nôm là Chèm), nay thuộc phường Đông Ngạc, thành phố Hà Nội. Đình thờ Thượng đẳng Thiên vương Lý Ông Trọng và Hoàng phi Bạch Tĩnh Cung, đều vào thời An Dương Vương. Đình Chèm được xem là một trong những ngôi đình cổ nhất Việt Nam, và là một công trình kiến trúc có nghệ thuật chạm khắc độc đáo. Ngoài làng Thụy Phương, đình còn là nơi thờ tự của người dân hai làng lân cận, Hoàng Xá và Liên Mạc.&#13;
Đình Chèm không chỉ là một công trình với kiến trúc cổ kính, mà còn mang trong mình sự tích về một vị tướng tài đức, có công dẹp giặc cứu nước.</dcterms:description>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2017</vh:recognitionYear>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Ch%C3%A8m"/>
    <rdfs:comment xml:lang="vi">Đình Chèm là ngôi đình của làng Thụy Phương (tên Nôm là Chèm), nay thuộc phường Đông Ngạc, thành phố Hà Nội. Đình thờ Thượng đẳng Thiên vương Lý Ông Trọng và Hoàng phi Bạch Tĩnh Cung, đều vào thời An Dương Vương. Đình Chèm được xem là một trong những ngôi đình cổ nhất Việt Nam, và là một công trình kiến trúc có nghệ thuật chạm khắc độc đáo. Ngoài làng Thụy Phương, đình còn là nơi thờ tự của người dân hai làng lân cận, Hoàng Xá và Liên Mạc.&#13;
Đình Chèm không chỉ là một công trình với kiến trúc cổ kính, mà còn mang trong mình sự tích về một vị tướng tài đức, có công dẹp giặc cứu nước.</rdfs:comment>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thành phố Hà Nội</vh:address>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <rdfs:label xml:lang="vi">DTKTNT Đình Chèm</rdfs:label>
