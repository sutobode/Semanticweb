  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-3afaf3a72b8b">
    <dcterms:source rdf:resource="https://dsvh.gov.vn/thac-luong-tinh-ha-giang-3410"/>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/Th%C3%A1c_Lu%E1%BB%93ng"/>
    <rdfs:label xml:lang="vi">Thác Luồng</rdfs:label>
    <dcterms:description xml:lang="vi">Thác Luồng là thác trên suối Nậm Luồng ở vùng đất bản Bo xã Khuôn Lùng tỉnh Tuyên Quang, Việt Nam.&#13;
Thác Luồng đặt tên theo suối Nậm Luồng. Thác Luồng ở độ cao gần 1.000 m so với mực nước biển, trải ra 11 tầng thác lớn nhỏ với chiều dài tổng cộng gần 1 km, rộng cỡ 10 m - 20 m, chảy uốn lượn trong rừng già. Thác được Bộ Văn hóa, Thể thao và Du lịch xếp hạng là di tích quốc gia tại Quyết định 1978/QÐ-BVHTTDL ngày 29/06/2021.</dcterms:description>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2021</vh:recognitionYear>
