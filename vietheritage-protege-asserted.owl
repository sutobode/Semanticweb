  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-d5e0a793e774">
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q24957059"/>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2013</vh:recognitionYear>
    <rdfs:comment xml:lang="vi">Rừng Trần Hưng Đạo là khu rừng nằm dưới chân núi Slam Cao thuộc xã Tam Kim, tỉnh Cao Bằng, nằm ở phía Tây Nam và cách phường Thục Phán khoảng 50 km. Khu rừng hiện được công nhận là Di tích quốc gia đặc biệt này là nơi từng diễn ra sự kiện thành lập Đội Việt Nam Tuyên truyền Giải phóng quân, tiền thân của Quân đội Nhân dân Việt Nam vào ngày 22 tháng 12 năm 1944.</rdfs:comment>
    <dcterms:subject>national_special_monuments</dcterms:subject>
    <skos:altLabel xml:lang="vi">Rừng Trần Hưng Đạo</skos:altLabel>
    <rdfs:label xml:lang="vi">DTLS Rừng Trần Hưng Đạo</rdfs:label>
