  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/site-5a1d8aef0c7c">
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2018</vh:recognitionYear>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Vĩnh Phúc</vh:address>
    <rdfs:label xml:lang="vi">DTKTNT Đình Thổ Tang</rdfs:label>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-08T00:00:00</dcterms:modified>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q10831650"/>
    <dcterms:description xml:lang="vi">Đình Thổ Tang là ngôi đình của làng Thổ Tang, nay là xã Thổ Tang, tỉnh Phú Thọ, Việt Nam.&#13;
Đây là một trong những ngôi đình cổ nhất của tỉnh Vĩnh Phúc, đình được xây dựng từ thế kỷ XVII, là nơi thờ cúng Lân Hổ Hầu đô thống Đại Vương - một vị tướng có công giúp vua Trần Nhân Tông đánh tan quân Nguyên Mông xâm lược Việt Nam vào thế kỷ XII.&#13;
Đình Thổ Tang được xếp hạng di tích lịch sử văn hóa cấp Quốc gia năm 1964. Ngày 24 tháng 12 năm 2018, Thủ tướng Chính phủ đã xếp hạng ngôi đình là di tích quốc gia đặc biệt.</dcterms:description>
    <prov:wasGeneratedBy rdf:resource="http://localhost:3030/vietheritage/resource/activity-run-72d2e0bf8a9b"/>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/dinh-tho-tang-tinh-vinh-phuc-3252"/>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Th%E1%BB%95_Tang"/>
    <geo1:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.254636</geo1:lat>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/ArchitecturalSite"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HeritageSite"/>
    <rdfs:comment xml:lang="vi">Đình Thổ Tang là ngôi đình của làng Thổ Tang, nay là xã Thổ Tang, tỉnh Phú Thọ, Việt Nam.&#13;
Đây là một trong những ngôi đình cổ nhất của tỉnh Vĩnh Phúc, đình được xây dựng từ thế kỷ XVII, là nơi thờ cúng Lân Hổ Hầu đô thống Đại Vương - một vị tướng có công giúp vua Trần Nhân Tông đánh tan quân Nguyên Mông xâm lược Việt Nam vào thế kỷ XII.&#13;
Đình Thổ Tang được xếp hạng di tích lịch sử văn hóa cấp Quốc gia năm 1964. Ngày 24 tháng 12 năm 2018, Thủ tướng Chính phủ đã xếp hạng ngôi đình là di tích quốc gia đặc biệt.</rdfs:comment>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đình Thổ Tang</vh:sourceTitle>
    <dcterms:subject>national_special_monuments</dcterms:subject>
    <geo1:long rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">105.489701</geo1:long>
    <skos:altLabel xml:lang="vi">Đình Thổ Tang</skos:altLabel>
