    <geo1:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">11.601831</geo1:lat>
    <geo1:long rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">108.9442935</geo1:long>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2016</vh:recognitionYear>
    <rdfs:label xml:lang="vi">DTKTNT và KC Tháp Pô Klong Garai</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/Th%C3%A1p_Po_Klong_Garai"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-thap-po-klong-garai-2995"/>
