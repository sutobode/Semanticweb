  <rdf:Description rdf:about="http://localhost:3030/vietheritage/resource/intangible-e094bc25d96c">
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/NationalIntangibleHeritage"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/IntangibleHeritage"/>
    <dcterms:description xml:lang="vi">Hiện nay, đồng bào Nùng phía bắc còn bảo tồn được Nghi lễ cấp sắc; với người Nùng nơi đây, chỉ có những người làm nghề thày cúng mới được cấp sắc, trước khi được cấp sắc, người được cấp sắc phải đảm bảo rất nhiều yêu cầu, nhiều tiêu chuẩn khác nhau, phải có đạo đức tốt, lối sống lành mạnh, khiêm tốn, sống hòa nhã với mọi người. Lễ cấp sắc thông thường có 3 cấp khác nhau, từ thấp lên cao, cấp 1 là cấp thấp nhất, cấp 3 là cấp cao nhất.</dcterms:description>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Thái Nguyên</vh:address>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18220851</vh:sourcePageId>
