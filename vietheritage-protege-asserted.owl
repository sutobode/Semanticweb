    <rdfs:label xml:lang="vi">DTKTNT Chùa Bút Tháp</rdfs:label>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/ArchitecturalSite"/>
    <rdf:type rdf:resource="http://localhost:3030/vietheritage/ontology/HeritageSite"/>
    <dcterms:description xml:lang="vi">Chùa Bút Tháp (Ninh Phúc tự 寧福寺) nằm ở bên đê hữu ngạn sông Đuống, khu Bút Tháp, phường Trí Quả, thành phố Bắc Ninh. Ngoài ra, nhân dân trong vùng còn gọi là chùa Nhạn Tháp, chùa Thấp. Tên cũ của chùa trước đây gồm có: Thiếu Lâm Tự, Hoàng Cung Tự.&#13;
Trong chùa có tượng Quan Âm thiên thủ thiên nhãn bằng gỗ lớn nhất Việt Nam. Đây cũng là một di tích quốc gia đặc biệt của Việt Nam được xếp hạng đợt 4.</dcterms:description>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Bắc Ninh</vh:address>
    <geo1:long rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">106.0222</geo1:long>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <vh:locatedIn rdf:resource="http://localhost:3030/vietheritage/resource/area-name-34bf35f4ea37"/>
    <geo1:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.06083</geo1:lat>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-chua-but-thap-huyen-thuan-thanh-tinh-bac-ninh-2980"/>
