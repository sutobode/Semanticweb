    <vh:recognizedBy rdf:resource="http://localhost:3030/vietheritage/resource/organization-unesco"/>
    <vh:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỉnh Thanh Hóa</vh:address>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <prov:wasDerivedFrom rdf:resource="https://whc.unesco.org/en/list/1358/"/>
    <prov:wasDerivedFrom rdf:resource="https://dsvh.gov.vn/di-tich-thanh-nha-ho-481"/>
    <prov:wasDerivedFrom rdf:resource="https://vi.wikipedia.org/wiki/Th%C3%A0nh_nh%C3%A0_H%E1%BB%93"/>
    <vh:sourcePageId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">84491</vh:sourcePageId>
    <vh:recognitionYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</vh:recognitionYear>
    <dcterms:source rdf:resource="https://whc.unesco.org/en/list/1358/"/>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752"/>
    <dcterms:source rdf:resource="https://vi.wikipedia.org/wiki/Th%C3%A0nh_nh%C3%A0_H%E1%BB%93"/>
    <dcterms:source rdf:resource="https://dsvh.gov.vn/di-tich-thanh-nha-ho-481"/>
    <vh:sourceTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thành nhà Hồ</vh:sourceTitle>
    <rdfs:comment xml:lang="vi">Thành nhà Hồ (hay còn gọi là thành Tây Đô, thành An Tôn, thành Tây Kinh hay thành Tây Giai) là kinh đô nước Đại Ngu (quốc hiệu Việt Nam dưới thời nhà Hồ), nằm trên địa phận tỉnh Thanh Hóa. Đây là tòa thành kiên cố với kiến trúc độc đáo bằng đá có quy mô lớn hiếm hoi ở Việt Nam, có giá trị và độc đáo nhất, duy nhất còn lại ở tại Đông Nam Á và là một trong rất ít những thành lũy bằng đá còn lại trên thế giới. Thành được xây dựng trong thời gian ngắn, chỉ khoảng 3 tháng (từ tháng Giêng đến tháng 3 năm 1397) và cho đến nay, dù đã tồn tại hơn 6 thế kỷ nhưng một số đoạn của tòa thành này còn lại tương đối nguyên vẹn.&#13;
Ngày 27 tháng 6 năm 2011, sau 6 năm đệ trình hồ sơ, Thành nhà Hồ đã được UNESCO công nhận là di sản văn hóa thế giới, thành cũng được CNN đánh giá là một trong 21 di sản nổi bật và vĩ đại nhất thế giới. Hiện nay, nơi đây đã được thủ tướng chính phủ Việt Nam đưa vào danh sách xếp hạng 62 di tích quốc gia đặc biệt. Từ tháng 12 năm 2018 đến tháng 6 năm 2020, Quỹ Bảo tồn Văn hóa của Đại sứ Hoa Kỳ (AFCP) đã tài trợ 92,500 USD vào dự án bảo tồn Cổng Nam, Thành nhà Hồ.</rdfs:comment>
    <vh:hasMember rdf:resource="http://localhost:3030/vietheritage/resource/site-c7bf6641dd4b"/>
    <vh:hasMember rdf:resource="http://localhost:3030/vietheritage/resource/site-4d19a4ce38d6"/>
    <vh:hasMember rdf:resource="http://localhost:3030/vietheritage/resource/site-b300f9a5ca4f"/>
    <owl:sameAs rdf:resource="https://www.wikidata.org/entity/Q190060"/>
    <dcterms:subject>world_heritage</dcterms:subject>
    <skos:altLabel xml:lang="vi">DTLS và KTNT Thành Nhà Hồ</skos:altLabel>
    <dcterms:description xml:lang="vi">Thành nhà Hồ (hay còn gọi là thành Tây Đô, thành An Tôn, thành Tây Kinh hay thành Tây Giai) là kinh đô nước Đại Ngu (quốc hiệu Việt Nam dưới thời nhà Hồ), nằm trên địa phận tỉnh Thanh Hóa. Đây là tòa thành kiên cố với kiến trúc độc đáo bằng đá có quy mô lớn hiếm hoi ở Việt Nam, có giá trị và độc đáo nhất, duy nhất còn lại ở tại Đông Nam Á và là một trong rất ít những thành lũy bằng đá còn lại trên thế giới. Thành được xây dựng trong thời gian ngắn, chỉ khoảng 3 tháng (từ tháng Giêng đến tháng 3 năm 1397) và cho đến nay, dù đã tồn tại hơn 6 thế kỷ nhưng một số đoạn của tòa thành này còn lại tương đối nguyên vẹn.&#13;
Ngày 27 tháng 6 năm 2011, sau 6 năm đệ trình hồ sơ, Thành nhà Hồ đã được UNESCO công nhận là di sản văn hóa thế giới, thành cũng được CNN đánh giá là một trong 21 di sản nổi bật và vĩ đại nhất thế giới. Hiện nay, nơi đây đã được thủ tướng chính phủ Việt Nam đưa vào danh sách xếp hạng 62 di tích quốc gia đặc biệt. Từ tháng 12 năm 2018 đến tháng 6 năm 2020, Quỹ Bảo tồn Văn hóa của Đại sứ Hoa Kỳ (AFCP) đã tài trợ 92,500 USD vào dự án bảo tồn Cổng Nam, Thành nhà Hồ.</dcterms:description>
