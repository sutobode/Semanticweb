    vh:sourceTitle "Hồ Ba Bể"^^xsd:string ;
    dcterms:description "Hồ Ba Bể là một hồ nước ngọt ở Thái Nguyên, Việt Nam. Đây là hồ nước ngọt tự nhiên lớn nhất Việt Nam và là một trong một trăm hồ nước ngọt lớn nhất thế giới. Hồ nằm trong Vườn quốc gia Ba Bể, nơi đây được công nhận là khu du lịch quốc gia Việt Nam."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-lam-thang-canh-ho-ba-be-2967>,
        <https://vi.wikipedia.org/wiki/H%E1%BB%93_Ba_B%E1%BB%83> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Hồ Ba Bể là một hồ nước ngọt ở Thái Nguyên, Việt Nam. Đây là hồ nước ngọt tự nhiên lớn nhất Việt Nam và là một trong một trăm hồ nước ngọt lớn nhất thế giới. Hồ nằm trong Vườn quốc gia Ba Bể, nơi đây được công nhận là khu du lịch quốc gia Việt Nam."@vi ;
