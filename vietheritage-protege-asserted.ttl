vhr:registry-535519ce64d1 a vh:ArchitecturalSite,
        vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS và KTNT Đền Trần Thương"@vi ;
    vh:address "Tỉnh Hà Nam"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q511375 ;
    vh:locatedIn vhr:area-name-dca800e51853 ;
    vh:recognitionYear "2015"^^xsd:gYear ;
    vh:sourcePageId 362694 ;
    vh:sourceTitle "Đền Trần Thương"^^xsd:string ;
    dcterms:description "Đền Trần Thương là một ngôi đền thờ Trần Hưng Đạo được dựng lên ngay trên phần đất khi xưa ông dùng làm kho lương phục vụ cuộc kháng chiến chống quân Nguyên - Mông lần 2. Đền Trần Thương nằm ở xã Trần Thương, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới đền Trần Thương 50 km. Đây là ngôi đền lớn thờ Trần Hưng Đạo đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam và gắn với lễ hội phát lương Đức Thánh Trần diễn ra hàng năm."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-den-tran-thuong-1313>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Tr%E1%BA%A7n_Th%C6%B0%C6%A1ng> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Đền Trần Thương là một ngôi đền thờ Trần Hưng Đạo được dựng lên ngay trên phần đất khi xưa ông dùng làm kho lương phục vụ cuộc kháng chiến chống quân Nguyên - Mông lần 2. Đền Trần Thương nằm ở xã Trần Thương, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới đền Trần Thương 50 km. Đây là ngôi đền lớn thờ Trần Hưng Đạo đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam và gắn với lễ hội phát lương Đức Thánh Trần diễn ra hàng năm."@vi ;
