vhr:registry-da36c0d9c6bc a vh:ArchitecturalSite,
        vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS và KTNT Đền Trần và Chùa Phổ Minh"@vi ;
    vh:address "Tỉnh Nam Định"^^xsd:string ;
    vh:constructionYear "1695"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-dca800e51853 ;
    vh:recognitionYear "2012"^^xsd:gYear ;
    vh:sourcePageId 327419 ;
    vh:sourceTitle "Đền Trần (Nam Định)"^^xsd:string ;
    dcterms:description """Đền Trần (陳廟 - Trần Miếu) là một quần thể đền thờ tại đường Trần Thừa, phường Nam Định, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới đền Trần 33 km. Đền nằm sát quốc lộ 10, là nơi thờ các vua Trần cùng các quan lại có công phù tá nhà Trần. Đền Trần được xây dựng từ năm 1695, trên nền Thái miếu cũ của nhà Trần đã bị quân Minh phá hủy vào thế kỷ XV.\r
Đền Trần bao gồm 3 công trình kiến trúc chính là đền Thiên Trường (hay đền Thượng), đền Cố Trạch (hay đền Hạ) và đền Trùng Hoa. Trước khi vào đền, phải qua hệ thống cổng ngũ môn. Trên cổng ghi các chữ Hán Chính nam môn (正南門 - cổng chính phía nam) và Trần Miếu (陳廟 - Miếu thờ nhà Trần). Qua cổng là một hồ nước hình chữ nhật. Chính giữa phía sau hồ nước là khu đền Thiên Trường. Phía Tây đền Thiên Trường là đền Trùng Hoa, phía Đông là đền Cố Trạch.\r
Cả ba đền đều có kiến trúc chung, và quy mô ngang nhau. Mỗi đền gồm tòa tiền đường 5 gian, tòa trung đường 5 gian và tòa chính tẩm 3 gian. Nối tiền đường và trung đường là kinh đàn (thiêu hương) và 2 gian tả hữu."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-den-tran-va-chua-pho-minh-2959>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Tr%E1%BA%A7n_(Nam_%C4%90%E1%BB%8Bnh)> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đền Trần (陳廟 - Trần Miếu) là một quần thể đền thờ tại đường Trần Thừa, phường Nam Định, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới đền Trần 33 km. Đền nằm sát quốc lộ 10, là nơi thờ các vua Trần cùng các quan lại có công phù tá nhà Trần. Đền Trần được xây dựng từ năm 1695, trên nền Thái miếu cũ của nhà Trần đã bị quân Minh phá hủy vào thế kỷ XV.\r
Đền Trần bao gồm 3 công trình kiến trúc chính là đền Thiên Trường (hay đền Thượng), đền Cố Trạch (hay đền Hạ) và đền Trùng Hoa. Trước khi vào đền, phải qua hệ thống cổng ngũ môn. Trên cổng ghi các chữ Hán Chính nam môn (正南門 - cổng chính phía nam) và Trần Miếu (陳廟 - Miếu thờ nhà Trần). Qua cổng là một hồ nước hình chữ nhật. Chính giữa phía sau hồ nước là khu đền Thiên Trường. Phía Tây đền Thiên Trường là đền Trùng Hoa, phía Đông là đền Cố Trạch.\r
Cả ba đền đều có kiến trúc chung, và quy mô ngang nhau. Mỗi đền gồm tòa tiền đường 5 gian, tòa trung đường 5 gian và tòa chính tẩm 3 gian. Nối tiền đường và trung đường là kinh đàn (thiêu hương) và 2 gian tả hữu."""@vi ;
    geo1:lat 20.456854 ;
    geo1:long 106.167306 ;
    skos:altLabel "Đền Trần (Nam Định)"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-den-tran-va-chua-pho-minh-2959>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Tr%E1%BA%A7n_(Nam_%C4%90%E1%BB%8Bnh)> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

