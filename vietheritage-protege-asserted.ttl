vhr:registry-0d6aeb5591c2 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Hội Gióng đền Phù Đổng và đền Sóc"@vi ;
    vh:address "Tp. Hà Nội"^^xsd:string ;
    vh:locatedIn vhr:area-name-8de4ed043a59 ;
    vh:sourcePageId 228226 ;
    vh:sourceTitle "Hội Gióng"^^xsd:string ;
    dcterms:description """Lễ Hội Gióng là một lễ hội truyền thống hàng năm ở nhiều nơi thuộc vùng Hà Nội để tưởng niệm và ca ngợi chiến công của người anh hùng truyền thuyết Thánh Gióng, một trong tứ bất tử của tín ngưỡng dân gian Việt Nam.\r
Có 2 hội Gióng tiêu biểu ở Hà Nội là hội Gióng Sóc Sơn ở đền Sóc xã Phù Linh, huyện Sóc Sơn và hội Gióng Phù Đổng ở đền Phù Đổng, xã Phù Đông huyện Gia Lâm đã được UNESCO ghi danh là di sản văn hóa phi vật thể của nhân loại. Ngoài ra còn hơn 10 hội Gióng cũng thuộc địa bàn Hà Nội (gọi là vùng lan tỏa vì chưa được UNESCO công nhận) như: hội Gióng Bộ Đầu xã Thống Nhất, huyện Thường Tín; lễ hội thờ Thánh Gióng ở các làng Đổng Xuyên, Chi Nam (huyện Gia Lâm); các làng Phù Lỗ Đoài, Thanh Nhàn, Xuân Lai (huyện Sóc Sơn); Sơn Du, Cán Khê, Đống Đồ (huyện Đông Anh); Xuân Tảo (Phường Xuân Đỉnh, Quận Bắc Từ Liêm); làng Hội Xá (Quận Long Biên).\r
Giá trị nổi bật toàn cầu ở hội Gióng chính là một hiện tượng văn hóa được bảo lưu, trao truyền khá liên tục và toàn vẹn qua nhiều thế hệ. Mặc dù ở gần trung tâm thủ đô và đời sống cộng đồng trải qua nhiều biến động do chiến tranh, do sự xâm nhập và tiếp biến văn hóa, hội Gióng vẫn tồn tại một cách độc lập và bền vững, không bị nhà nước hóa, thương mại hóa."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/H%E1%BB%99i_Gi%C3%B3ng> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Lễ Hội Gióng là một lễ hội truyền thống hàng năm ở nhiều nơi thuộc vùng Hà Nội để tưởng niệm và ca ngợi chiến công của người anh hùng truyền thuyết Thánh Gióng, một trong tứ bất tử của tín ngưỡng dân gian Việt Nam.\r
Có 2 hội Gióng tiêu biểu ở Hà Nội là hội Gióng Sóc Sơn ở đền Sóc xã Phù Linh, huyện Sóc Sơn và hội Gióng Phù Đổng ở đền Phù Đổng, xã Phù Đông huyện Gia Lâm đã được UNESCO ghi danh là di sản văn hóa phi vật thể của nhân loại. Ngoài ra còn hơn 10 hội Gióng cũng thuộc địa bàn Hà Nội (gọi là vùng lan tỏa vì chưa được UNESCO công nhận) như: hội Gióng Bộ Đầu xã Thống Nhất, huyện Thường Tín; lễ hội thờ Thánh Gióng ở các làng Đổng Xuyên, Chi Nam (huyện Gia Lâm); các làng Phù Lỗ Đoài, Thanh Nhàn, Xuân Lai (huyện Sóc Sơn); Sơn Du, Cán Khê, Đống Đồ (huyện Đông Anh); Xuân Tảo (Phường Xuân Đỉnh, Quận Bắc Từ Liêm); làng Hội Xá (Quận Long Biên).\r
Giá trị nổi bật toàn cầu ở hội Gióng chính là một hiện tượng văn hóa được bảo lưu, trao truyền khá liên tục và toàn vẹn qua nhiều thế hệ. Mặc dù ở gần trung tâm thủ đô và đời sống cộng đồng trải qua nhiều biến động do chiến tranh, do sự xâm nhập và tiếp biến văn hóa, hội Gióng vẫn tồn tại một cách độc lập và bền vững, không bị nhà nước hóa, thương mại hóa."""@vi ;
    skos:altLabel "Hội Gióng"@vi,
        "Hội Gióng (Đền Phù Đổng và đền Sóc)"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/H%E1%BB%99i_Gi%C3%B3ng> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

