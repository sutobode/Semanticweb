vhr:registry-4705920b4c79 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS An toàn khu (ATK) Định Hóa"@vi ;
    vh:address "Tỉnh Thái Nguyên"^^xsd:string ;
    vh:locatedIn vhr:area-name-8872895663b7 ;
    vh:recognitionYear "2012"^^xsd:gYear ;
    vh:sourcePageId 1278826 ;
    vh:sourceTitle "An toàn khu Định Hóa"^^xsd:string ;
    dcterms:description """An toàn khu Định Hóa (ATK Định Hóa) là một khu di tích rộng lớn nằm ở tỉnh Thái Nguyên. Khu di tích này đã được công nhận là di tích quốc gia đặc biệt quan trọng của Việt Nam. Đây là nơi Chủ tịch Hồ Chí Minh và các nhà lãnh đạo Đảng, Nhà nước Việt Nam đã sống và làm việc từ 20/5/1947 - 1954 để lãnh đạo cuộc kháng chiến 9 năm chống thực dân Pháp.\r
Hiện nay, ATK còn nhiều di tích về nơi ở và làm việc của Chủ Tịch Hồ Chí Minh như nền nhà, hầm làm việc, cây râm bụt Bác trồng, phiến đá Bác thường nằm nghỉ trưa..."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-an-toan-khu-atk-dinh-hoa-2948>,
        <https://vi.wikipedia.org/wiki/An_to%C3%A0n_khu_%C4%90%E1%BB%8Bnh_H%C3%B3a> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """An toàn khu Định Hóa (ATK Định Hóa) là một khu di tích rộng lớn nằm ở tỉnh Thái Nguyên. Khu di tích này đã được công nhận là di tích quốc gia đặc biệt quan trọng của Việt Nam. Đây là nơi Chủ tịch Hồ Chí Minh và các nhà lãnh đạo Đảng, Nhà nước Việt Nam đã sống và làm việc từ 20/5/1947 - 1954 để lãnh đạo cuộc kháng chiến 9 năm chống thực dân Pháp.\r
Hiện nay, ATK còn nhiều di tích về nơi ở và làm việc của Chủ Tịch Hồ Chí Minh như nền nhà, hầm làm việc, cây râm bụt Bác trồng, phiến đá Bác thường nằm nghỉ trưa..."""@vi ;
    skos:altLabel "An toàn khu Định Hóa"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-an-toan-khu-atk-dinh-hoa-2948>,
        <https://vi.wikipedia.org/wiki/An_to%C3%A0n_khu_%C4%90%E1%BB%8Bnh_H%C3%B3a> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

