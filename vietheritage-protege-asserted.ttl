    vh:address "Tỉnh Hưng Yên"^^xsd:string ;
    vh:locatedIn vhr:area-name-d9cd26c7e761 ;
    vh:recognitionYear "2018"^^xsd:gYear ;
    vh:sourcePageId 14129342 ;
    vh:sourceTitle "Chùa Thái Lạc"^^xsd:string ;
    dcterms:description "Chùa Thái Lạc ở xã Như Quỳnh, tỉnh Hưng Yên. Chùa thuộc hệ thống chùa Tứ Pháp, thờ Phật và Pháp Vân. Chùa nổi tiếng vì có các bức chạm gõ từ đời Trần."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
