vhr:registry-5d0cea2ddae1 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Khu lăng mộ và đền thờ các vị vua triều Trần"@vi ;
    vh:address "Tỉnh Thái Bình"^^xsd:string ;
    vh:locatedIn vhr:area-name-d9cd26c7e761 ;
    vh:recognitionYear "2014"^^xsd:gYear ;
    vh:sourcePageId 419558 ;
    vh:sourceTitle "Đền Trần (Long Hưng)"^^xsd:string ;
    dcterms:description "Đền Trần Thái Bình (Khu lăng mộ và đền thờ các vị vua triều Trần) là một quần thể di tích gồm các đền thờ và lăng mộ thờ các vị vua, quan nhà Trần. Đền thờ các vua Trần trên đất phát tích Long Hưng (còn gọi là Thái Đường Lăng) thuộc làng Tam Đường, xã Long Hưng, tỉnh Hưng Yên (tức xã Tiến Đức, huyện Hưng Hà, tỉnh Thái Bình cũ). Hệ thống các di tích lịch sử ở đây gồm Khu lăng mộ và đền thờ các vị vua triều Trần đều đã được chính phủ Việt Nam xếp hạng di tích quốc gia đặc biệt quan trọng."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-khu-lang-mo-va-den-tho-cac-vi-vua-trieu-tran-2984>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Tr%E1%BA%A7n_(Long_H%C6%B0ng)> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Đền Trần Thái Bình (Khu lăng mộ và đền thờ các vị vua triều Trần) là một quần thể di tích gồm các đền thờ và lăng mộ thờ các vị vua, quan nhà Trần. Đền thờ các vua Trần trên đất phát tích Long Hưng (còn gọi là Thái Đường Lăng) thuộc làng Tam Đường, xã Long Hưng, tỉnh Hưng Yên (tức xã Tiến Đức, huyện Hưng Hà, tỉnh Thái Bình cũ). Hệ thống các di tích lịch sử ở đây gồm Khu lăng mộ và đền thờ các vị vua triều Trần đều đã được chính phủ Việt Nam xếp hạng di tích quốc gia đặc biệt quan trọng."@vi ;
    geo1:lat 20.601857 ;
    geo1:long 106.14369 ;
    skos:altLabel "Đền Trần (Long Hưng)"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-khu-lang-mo-va-den-tho-cac-vi-vua-trieu-tran-2984>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Tr%E1%BA%A7n_(Long_H%C6%B0ng)> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

