vhr:registry-af0d3127bdec a vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKTNT Tháp Chăm Dương Long"@vi ;
    vh:address "Tỉnh Bình Định"^^xsd:string ;
    vh:locatedIn vhr:area-name-574f21fd28ba ;
    vh:recognitionYear "2015"^^xsd:gYear ;
    vh:sourcePageId 125544 ;
    vh:sourceTitle "Tháp Dương Long"^^xsd:string ;
    dcterms:description """Tháp Dương Long là cụm di tích gồm ba tháp Chăm thẳng hàng trên một gò cao thuộc xã Bình An, tỉnh Gia Lai.\r
Tháp Dương Long được xây dựng vào cuối thế kỷ 12. Đây là thời kỳ phát triển rực rỡ nhất của nền văn hóa Chăm Pa. Kiến trúc của ngôi tháp được các nhà nghiên cứu cho rằng xây theo kiến trúc Khmer từ ngôi đền Angkor Wat, sau khi Champa xăm chiếm đế chế Khmer.\r
Cụm tháp này gồm ba tháp: Tháp giữa cao 39 mét, hai tháp bên cao 32 mét. Phần thân của các tháp xây bằng gạch, các góc được ghép bởi những tảng đá lớn chạm trổ công phu. Tính quy mô của tháp Dương Long được thể hiện không chỉ ở chiều cao của tháp (cao nhất trong các tháp Chăm còn lại ở Việt Nam) mà còn ở lối kiến trúc độc đáo, đặc biệt là các hoa văn, họa tiết được khắc tạc trực tiếp trên những tảng đá đồ sộ đặt ngay trên đỉnh tháp.\r
Dương Long nằm bên cạnh một khu thành dân sự - thành Phú Phong, mặc dù đã trở thành phế tích. Ngoài các tháp, trong khu vực chính dường như còn có một tòa nhà dài ở phía nam mà nay chỉ còn là một đống gạch vụn.\r
Người Pháp gọi tháp này là "Tour d' Ivoire" (Tháp Ngà).\r
Tháp ở trong tình trạng đe dọa vì đã nhiều lần bị phá hoại bởi những nhóm người đi tìm vàng, một số hộ dân quanh đấy cũng đã lấy gạch của tháp về xây nhà trong quá khứ."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-thap-duong-long-1289>,
        <https://vi.wikipedia.org/wiki/Th%C3%A1p_D%C6%B0%C6%A1ng_Long> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Tháp Dương Long là cụm di tích gồm ba tháp Chăm thẳng hàng trên một gò cao thuộc xã Bình An, tỉnh Gia Lai.\r
Tháp Dương Long được xây dựng vào cuối thế kỷ 12. Đây là thời kỳ phát triển rực rỡ nhất của nền văn hóa Chăm Pa. Kiến trúc của ngôi tháp được các nhà nghiên cứu cho rằng xây theo kiến trúc Khmer từ ngôi đền Angkor Wat, sau khi Champa xăm chiếm đế chế Khmer.\r
Cụm tháp này gồm ba tháp: Tháp giữa cao 39 mét, hai tháp bên cao 32 mét. Phần thân của các tháp xây bằng gạch, các góc được ghép bởi những tảng đá lớn chạm trổ công phu. Tính quy mô của tháp Dương Long được thể hiện không chỉ ở chiều cao của tháp (cao nhất trong các tháp Chăm còn lại ở Việt Nam) mà còn ở lối kiến trúc độc đáo, đặc biệt là các hoa văn, họa tiết được khắc tạc trực tiếp trên những tảng đá đồ sộ đặt ngay trên đỉnh tháp.\r
Dương Long nằm bên cạnh một khu thành dân sự - thành Phú Phong, mặc dù đã trở thành phế tích. Ngoài các tháp, trong khu vực chính dường như còn có một tòa nhà dài ở phía nam mà nay chỉ còn là một đống gạch vụn.\r
Người Pháp gọi tháp này là "Tour d' Ivoire" (Tháp Ngà).\r
Tháp ở trong tình trạng đe dọa vì đã nhiều lần bị phá hoại bởi những nhóm người đi tìm vàng, một số hộ dân quanh đấy cũng đã lấy gạch của tháp về xây nhà trong quá khứ."""@vi ;
    skos:altLabel "Tháp Dương Long"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-thap-duong-long-1289>,
        <https://vi.wikipedia.org/wiki/Th%C3%A1p_D%C6%B0%C6%A1ng_Long> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

