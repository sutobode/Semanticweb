vhr:registry-24c63b39d00d a vh:HeritageSite ;
    rdfs:label "Chiến trường Điện Biên Phủ"@vi ;
    vh:address "Tỉnh Điện Biên"^^xsd:string ;
    vh:locatedIn vhr:area-name-9276a97b39cb ;
    vh:recognitionYear "2009"^^xsd:gYear ;
    vh:sourcePageId 455219 ;
    vh:sourceTitle "Khu di tích chiến trường Điện Biên Phủ"^^xsd:string ;
    dcterms:description """Quần thể di tích chiến trường Điện Biên Phủ là một quần thể các di tích lịch sử nằm tại tỉnh Điện Biên, ghi lại chiến công của Quân đội nhân dân Việt Nam trong chiến dịch Điện Biên Phủ. Đây là một trong 130 di tích quốc gia đặc biệt của Việt Nam. Quần thể bao gồm 46 di tích thành phần đã được công nhận và 4 di tích đề xuất bổ sung, trải rộng trên địa bàn 10 xã, phường của tỉnh Điện Biên.\r
Các di tích nổi bật của chiến trường Điện Biên Phủ bao gồm đồi A1, C1, C2, D1, cứ điểm Hồng Cúm, Him Lam, đồi Độc Lập, cầu Mường Thanh, sân bay Mường Thanh (nay là sân bay Điện Biên Phủ) và hầm chỉ huy tập đoàn cứ điểm Điện Biên Phủ."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Khu_di_t%C3%ADch_chi%E1%BA%BFn_tr%C6%B0%E1%BB%9Dng_%C4%90i%E1%BB%87n_Bi%C3%AAn_Ph%E1%BB%A7> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Quần thể di tích chiến trường Điện Biên Phủ là một quần thể các di tích lịch sử nằm tại tỉnh Điện Biên, ghi lại chiến công của Quân đội nhân dân Việt Nam trong chiến dịch Điện Biên Phủ. Đây là một trong 130 di tích quốc gia đặc biệt của Việt Nam. Quần thể bao gồm 46 di tích thành phần đã được công nhận và 4 di tích đề xuất bổ sung, trải rộng trên địa bàn 10 xã, phường của tỉnh Điện Biên.\r
Các di tích nổi bật của chiến trường Điện Biên Phủ bao gồm đồi A1, C1, C2, D1, cứ điểm Hồng Cúm, Him Lam, đồi Độc Lập, cầu Mường Thanh, sân bay Mường Thanh (nay là sân bay Điện Biên Phủ) và hầm chỉ huy tập đoàn cứ điểm Điện Biên Phủ."""@vi ;
