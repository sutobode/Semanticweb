vhr:registry-b09f2b4c1884 a vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "Trụ sở Ủy ban nhân dân thành phố Hồ Chí Minh"@vi ;
    vh:address "Thành phố Hồ Chí Minh, phường Bến Nghé, quận 1, thành phố Hồ Chí Minh"^^xsd:string ;
    vh:constructionYear "1898"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-01ecaf4d6cda ;
    vh:recognitionYear "2020"^^xsd:gYear ;
    vh:sourcePageId 63148 ;
    vh:sourceTitle "Trụ sở Ủy ban nhân dân Thành phố Hồ Chí Minh"^^xsd:string ;
    dcterms:description """Trụ sở Ủy ban nhân dân Thành phố Hồ Chí Minh là một trong những công trình kiến trúc cổ điển ở Thành phố Hồ Chí Minh, được xây dựng từ năm 1898 đến 1908, khánh thành năm 1909. Thời Pháp thuộc, tòa nhà này có tên là Hôtel de ville trong tiếng Pháp hay Dinh xã Tây trong tiếng Việt. Đến thời Việt Nam Cộng hòa, nó được gọi là Tòa đô chánh Sài Gòn vì là nơi làm việc và hội họp của chính quyền thủ đô. Từ sau ngày Việt Nam thống nhất đến nay, tòa nhà là nơi làm việc của Ủy ban nhân dân Thành phố Hồ Chí Minh, Hội đồng nhân dân Thành phố Hồ Chí Minh và một số cơ quan khác.\r
Địa chỉ hiện nay là số 86 đường Lê Thánh Tôn, phường Sài Gòn, nằm ngay đầu đường Nguyễn Huệ hướng ra sông Sài Gòn. Năm 2020, tòa nhà này đã được Bộ trưởng Bộ Văn hóa, Thể thao và Du lịch xếp hạng là di tích kiến trúc nghệ thuật cấp quốc gia. Hiện cũng có phương án thiết kế tòa nhà mới của Trụ sở Ủy ban nhân dân Thành phố. Dịp lễ 30 tháng 4 năm 2023, Trụ sở Ủy ban lần đầu tiên cho phép đón khách tham quan. Trước đó, du khách trong và ngoài nước chỉ được đứng quan sát và chụp hình từ bên ngoài."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/tru-so-uy-ban-nhan-dan-thanh-pho-ho-chi-minh-3468>,
        <https://vi.wikipedia.org/wiki/Tr%E1%BB%A5_s%E1%BB%9F_%E1%BB%A6y_ban_nh%C3%A2n_d%C3%A2n_Th%C3%A0nh_ph%E1%BB%91_H%E1%BB%93_Ch%C3%AD_Minh> ;
    dcterms:subject "national_monuments" ;
    rdfs:comment """Trụ sở Ủy ban nhân dân Thành phố Hồ Chí Minh là một trong những công trình kiến trúc cổ điển ở Thành phố Hồ Chí Minh, được xây dựng từ năm 1898 đến 1908, khánh thành năm 1909. Thời Pháp thuộc, tòa nhà này có tên là Hôtel de ville trong tiếng Pháp hay Dinh xã Tây trong tiếng Việt. Đến thời Việt Nam Cộng hòa, nó được gọi là Tòa đô chánh Sài Gòn vì là nơi làm việc và hội họp của chính quyền thủ đô. Từ sau ngày Việt Nam thống nhất đến nay, tòa nhà là nơi làm việc của Ủy ban nhân dân Thành phố Hồ Chí Minh, Hội đồng nhân dân Thành phố Hồ Chí Minh và một số cơ quan khác.\r
Địa chỉ hiện nay là số 86 đường Lê Thánh Tôn, phường Sài Gòn, nằm ngay đầu đường Nguyễn Huệ hướng ra sông Sài Gòn. Năm 2020, tòa nhà này đã được Bộ trưởng Bộ Văn hóa, Thể thao và Du lịch xếp hạng là di tích kiến trúc nghệ thuật cấp quốc gia. Hiện cũng có phương án thiết kế tòa nhà mới của Trụ sở Ủy ban nhân dân Thành phố. Dịp lễ 30 tháng 4 năm 2023, Trụ sở Ủy ban lần đầu tiên cho phép đón khách tham quan. Trước đó, du khách trong và ngoài nước chỉ được đứng quan sát và chụp hình từ bên ngoài."""@vi ;
    geo1:lat 10.77638889 ;
    geo1:long 106.70111111 ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/tru-so-uy-ban-nhan-dan-thanh-pho-ho-chi-minh-3468>,
        <https://vi.wikipedia.org/wiki/Tr%E1%BB%A5_s%E1%BB%9F_%E1%BB%A6y_ban_nh%C3%A2n_d%C3%A2n_Th%C3%A0nh_ph%E1%BB%91_H%E1%BB%93_Ch%C3%AD_Minh> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

