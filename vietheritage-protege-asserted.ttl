vhr:registry-098ac344f344 a vh:ArchitecturalSite,
        vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS và KTNT Cố đô Hoa Lư"@vi ;
    vh:address "Tỉnh Ninh Bình"^^xsd:string ;
    vh:locatedIn vhr:area-name-dca800e51853 ;
    vh:recognitionYear "2012"^^xsd:gYear ;
    vh:sourcePageId 19778578 ;
    vh:sourceTitle "Cố đô Hoa Lư"^^xsd:string ;
    dcterms:description "Cố đô Hoa Lư (chữ Hán: 華閭) là kinh đô của Việt Nam trong giai đoạn 968-1010. Đây là kinh đô đầu tiên của nhà nước phong kiến Trung ương tập quyền ở Việt Nam và là quê hương của vị Anh hùng dân tộc Đinh Bộ Lĩnh. Kinh đô Hoa Lư tồn tại 42 năm, gắn với sự nghiệp của ba triều đại liên tiếp là nhà Đinh, nhà Tiền Lê và nhà Lý với các dấu ấn lịch sử: thống nhất đất nước, đánh Tống - dẹp Chiêm và phát tích quá trình định đô Hà Nội. Năm 1010 vua Lý Thái Tổ dời kinh đô từ Hoa Lư (Ninh Bình) về Thăng Long (Hà Nội), Hoa Lư trở thành Cố đô. Các triều vua Lý, Trần, Lê, Nguyễn sau đó dù không đóng đô ở Hoa Lư nữa nhưng vẫn cho xây dựng thêm ở đây nhiều công trình kiến trúc như đền, lăng, đình, chùa, phủ,... Hiện nay, Cố đô Hoa Lư vẫn còn nhiều di tích nằm trong Quần thể di sản thế giới Tràng An thuộc địa bàn tỉnh Ninh Bình."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-co-do-hoa-lu-2952>,
        <https://vi.wikipedia.org/wiki/C%E1%BB%91_%C4%91%C3%B4_Hoa_L%C6%B0> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Cố đô Hoa Lư (chữ Hán: 華閭) là kinh đô của Việt Nam trong giai đoạn 968-1010. Đây là kinh đô đầu tiên của nhà nước phong kiến Trung ương tập quyền ở Việt Nam và là quê hương của vị Anh hùng dân tộc Đinh Bộ Lĩnh. Kinh đô Hoa Lư tồn tại 42 năm, gắn với sự nghiệp của ba triều đại liên tiếp là nhà Đinh, nhà Tiền Lê và nhà Lý với các dấu ấn lịch sử: thống nhất đất nước, đánh Tống - dẹp Chiêm và phát tích quá trình định đô Hà Nội. Năm 1010 vua Lý Thái Tổ dời kinh đô từ Hoa Lư (Ninh Bình) về Thăng Long (Hà Nội), Hoa Lư trở thành Cố đô. Các triều vua Lý, Trần, Lê, Nguyễn sau đó dù không đóng đô ở Hoa Lư nữa nhưng vẫn cho xây dựng thêm ở đây nhiều công trình kiến trúc như đền, lăng, đình, chùa, phủ,... Hiện nay, Cố đô Hoa Lư vẫn còn nhiều di tích nằm trong Quần thể di sản thế giới Tràng An thuộc địa bàn tỉnh Ninh Bình."@vi ;
    skos:altLabel "Cố đô Hoa Lư"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-co-do-hoa-lu-2952>,
        <https://vi.wikipedia.org/wiki/C%E1%BB%91_%C4%91%C3%B4_Hoa_L%C6%B0> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

