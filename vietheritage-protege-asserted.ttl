vhr:registry-c307cf647441 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "Khu di tích Bạch Đằng Giang"@vi ;
    vh:address "thị trấn Minh Đức, huyện Thủy Nguyên, thành phố Hải Phòng"^^xsd:string ;
    vh:locatedIn vhr:area-name-4f99714e585c ;
    vh:recognitionYear "2020"^^xsd:gYear ;
    vh:sourcePageId 3377398 ;
    vh:sourceTitle "Quần thể di tích – danh thắng Tràng Kênh"^^xsd:string ;
    dcterms:description "Quần thể di tích và danh thắng Tràng Kênh thuộc phường Minh Đức, thành phố Thủy Nguyên, cách trung tâm thành phố Hải Phòng 20 km về phía Đông Bắc; là vùng đất có bề dày lịch sử văn hóa, một danh thắng được tạo bởi hệ thống núi đá vôi, hang động, và sông ngòi; được nhà nước xếp hạng di tích lịch sử văn hóa và danh lam thắng cảnh cấp quốc gia năm 1962."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/khu-di-tich-bach-dang-giang-thanh-pho-hai-phong-22042>,
        <https://vi.wikipedia.org/wiki/Qu%E1%BA%A7n_th%E1%BB%83_di_t%C3%ADch_%E2%80%93_danh_th%E1%BA%AFng_Tr%C3%A0ng_K%C3%AAnh> ;
    dcterms:subject "national_monuments" ;
    rdfs:comment "Quần thể di tích và danh thắng Tràng Kênh thuộc phường Minh Đức, thành phố Thủy Nguyên, cách trung tâm thành phố Hải Phòng 20 km về phía Đông Bắc; là vùng đất có bề dày lịch sử văn hóa, một danh thắng được tạo bởi hệ thống núi đá vôi, hang động, và sông ngòi; được nhà nước xếp hạng di tích lịch sử văn hóa và danh lam thắng cảnh cấp quốc gia năm 1962."@vi ;
    skos:altLabel "Quần thể di tích – danh thắng Tràng Kênh"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/khu-di-tich-bach-dang-giang-thanh-pho-hai-phong-22042>,
