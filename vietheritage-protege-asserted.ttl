vhr:registry-f5c20a16045c a vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKTNT Đình Thổ Tang"@vi ;
    vh:address "Tỉnh Vĩnh Phúc"^^xsd:string ;
    vh:locatedIn vhr:area-name-261633bcd11d ;
    vh:recognitionYear "2018"^^xsd:gYear ;
    vh:sourcePageId 19565901 ;
    vh:sourceTitle "Đình Thổ Tang"^^xsd:string ;
    dcterms:description """Đình Thổ Tang là ngôi đình của làng Thổ Tang, nay là xã Thổ Tang, tỉnh Phú Thọ, Việt Nam.\r
Đây là một trong những ngôi đình cổ nhất của tỉnh Vĩnh Phúc, đình được xây dựng từ thế kỷ XVII, là nơi thờ cúng Lân Hổ Hầu đô thống Đại Vương - một vị tướng có công giúp vua Trần Nhân Tông đánh tan quân Nguyên Mông xâm lược Việt Nam vào thế kỷ XII.\r
Đình Thổ Tang được xếp hạng di tích lịch sử văn hóa cấp Quốc gia năm 1964. Ngày 24 tháng 12 năm 2018, Thủ tướng Chính phủ đã xếp hạng ngôi đình là di tích quốc gia đặc biệt."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/dinh-tho-tang-tinh-vinh-phuc-3252>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Th%E1%BB%95_Tang> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đình Thổ Tang là ngôi đình của làng Thổ Tang, nay là xã Thổ Tang, tỉnh Phú Thọ, Việt Nam.\r
Đây là một trong những ngôi đình cổ nhất của tỉnh Vĩnh Phúc, đình được xây dựng từ thế kỷ XVII, là nơi thờ cúng Lân Hổ Hầu đô thống Đại Vương - một vị tướng có công giúp vua Trần Nhân Tông đánh tan quân Nguyên Mông xâm lược Việt Nam vào thế kỷ XII.\r
Đình Thổ Tang được xếp hạng di tích lịch sử văn hóa cấp Quốc gia năm 1964. Ngày 24 tháng 12 năm 2018, Thủ tướng Chính phủ đã xếp hạng ngôi đình là di tích quốc gia đặc biệt."""@vi ;
    geo1:lat 21.254636 ;
    geo1:long 105.489701 ;
    skos:altLabel "Đình Thổ Tang"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/dinh-tho-tang-tinh-vinh-phuc-3252>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Th%E1%BB%95_Tang> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

