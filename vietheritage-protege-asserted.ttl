vhr:registry-5c757a879cc5 a vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKTNT Đình Tường Phiêu"@vi ;
    vh:address "Thành phố Hà Nội"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q1155843 ;
    vh:constructionYear "1435"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-8de4ed043a59 ;
    vh:recognitionYear "2018"^^xsd:gYear ;
    vh:sourcePageId 19744525 ;
    vh:sourceTitle "Đình Tường Phiêu"^^xsd:string ;
    dcterms:description "Đình Tường Phiêu (tên gọi khác là Đình Cả) là một ngôi đình có vị trí nằm ở xã Tích Giang, huyện Phúc Thọ, thành phố Hà Nội. Ngôi đình này được Thủ tướng Chính phủ Việt Nam quyết định xếp hạng và công nhận là di tích quốc gia đặc biệt vào năm 2020. Với nhiều giá trị văn hóa, lịch sử và mỹ thuật, đình Tường Phiêu thường được xem là công trình kiến trúc mang tính biểu tượng của Xứ Đoài."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_T%C6%B0%E1%BB%9Dng_Phi%C3%AAu> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Đình Tường Phiêu (tên gọi khác là Đình Cả) là một ngôi đình có vị trí nằm ở xã Tích Giang, huyện Phúc Thọ, thành phố Hà Nội. Ngôi đình này được Thủ tướng Chính phủ Việt Nam quyết định xếp hạng và công nhận là di tích quốc gia đặc biệt vào năm 2020. Với nhiều giá trị văn hóa, lịch sử và mỹ thuật, đình Tường Phiêu thường được xem là công trình kiến trúc mang tính biểu tượng của Xứ Đoài."@vi ;
    geo1:lat 21.11708408 ;
    geo1:long 105.51670657 ;
    skos:altLabel "Đình Tường Phiêu"@vi ;
