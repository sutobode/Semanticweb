vhr:registry-6ced0fd3e045 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Nghệ thuật Hát Xẩm"@vi ;
    vh:address "Tỉnh Ninh Bình"^^xsd:string ;
    vh:locatedIn vhr:area-name-dca800e51853 ;
    vh:sourcePageId 214452 ;
    vh:sourceTitle "Xẩm"^^xsd:string ;
    dcterms:description """Xẩm là một loại hình dân ca của Việt Nam, phổ biến ở đồng bằng và trung du Bắc Bộ. "Xẩm" còn được dùng để chỉ những người hành nghề hát xẩm. Nghệ nhân Hà Thị Cầu (1928–2013) được coi là người hát xẩm cuối cùng của thế kỷ XX và tỉnh Ninh Bình đang có những nỗ lực đệ trình UNESCO công nhận hát xẩm là di sản văn hóa thế giới cần được bảo vệ khẩn cấp.\r
Hát Xẩm xưa thường là một hình thức mưu sinh của những người dân, ngày nay nghệ thuật xẩm được sân khấu hóa và đưa vào phục vụ khách du lịch. Xẩm đa số được biểu diễn ở chợ, đường phố, nơi đông người qua lại. Hát xẩm có tính ngẫu hứng và người biểu diễn có thể bật ra câu hát ngay khi thể hiện."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/X%E1%BA%A9m> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Xẩm là một loại hình dân ca của Việt Nam, phổ biến ở đồng bằng và trung du Bắc Bộ. "Xẩm" còn được dùng để chỉ những người hành nghề hát xẩm. Nghệ nhân Hà Thị Cầu (1928–2013) được coi là người hát xẩm cuối cùng của thế kỷ XX và tỉnh Ninh Bình đang có những nỗ lực đệ trình UNESCO công nhận hát xẩm là di sản văn hóa thế giới cần được bảo vệ khẩn cấp.\r
Hát Xẩm xưa thường là một hình thức mưu sinh của những người dân, ngày nay nghệ thuật xẩm được sân khấu hóa và đưa vào phục vụ khách du lịch. Xẩm đa số được biểu diễn ở chợ, đường phố, nơi đông người qua lại. Hát xẩm có tính ngẫu hứng và người biểu diễn có thể bật ra câu hát ngay khi thể hiện."""@vi ;
    skos:altLabel "Xẩm"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/X%E1%BA%A9m> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-6d2fa2175bbe a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Bạch Đằng"@vi ;
    vh:address "Tỉnh Quảng Nình"^^xsd:string ;
    vh:locatedIn vhr:area-name-cff49d8e0895 ;
    vh:recognitionYear "2012"^^xsd:gYear ;
    vh:sourcePageId 19709455 ;
    vh:sourceTitle "Khu di tích lịch sử Bạch Đằng"^^xsd:string ;
    dcterms:description """Khu di tích lịch sử Bạch Đằng là một quần thể gồm 10 điểm di tích nằm ở tả ngạn sông Bạch Đằng thuộc địa bàn các phường Quảng Yên, Phong Cốc, Uông Bí của thành phố Quảng Ninh. Đây là các di tích gắn với trận Bạch Đằng (1288) và Trần Hưng Đạo trong Chiến tranh Nguyên Mông – Đại Việt lần 3.\r
Ngày 27 tháng 9 năm 2012, di tích lịch sử Bạch Đằng được Thủ tướng Chính phủ xếp hạng di tích quốc gia đặc biệt trong Quyết định số 1419/QĐ-TTg. Trong Khu di tích lịch sử Bạch Đằng có Bãi cọc Yên Giang thuộc Quần thể di tích và danh thắng Yên Tử – Vĩnh Nghiêm – Côn Sơn, Kiếp Bạc đã được UNESCO công nhận là Di sản văn hoá của thế giới"""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-bach-dang-2960>,
        <https://vi.wikipedia.org/wiki/Khu_di_t%C3%ADch_l%E1%BB%8Bch_s%E1%BB%AD_B%E1%BA%A1ch_%C4%90%E1%BA%B1ng> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Khu di tích lịch sử Bạch Đằng là một quần thể gồm 10 điểm di tích nằm ở tả ngạn sông Bạch Đằng thuộc địa bàn các phường Quảng Yên, Phong Cốc, Uông Bí của thành phố Quảng Ninh. Đây là các di tích gắn với trận Bạch Đằng (1288) và Trần Hưng Đạo trong Chiến tranh Nguyên Mông – Đại Việt lần 3.\r
Ngày 27 tháng 9 năm 2012, di tích lịch sử Bạch Đằng được Thủ tướng Chính phủ xếp hạng di tích quốc gia đặc biệt trong Quyết định số 1419/QĐ-TTg. Trong Khu di tích lịch sử Bạch Đằng có Bãi cọc Yên Giang thuộc Quần thể di tích và danh thắng Yên Tử – Vĩnh Nghiêm – Côn Sơn, Kiếp Bạc đã được UNESCO công nhận là Di sản văn hoá của thế giới"""@vi ;
    skos:altLabel "Khu di tích lịch sử Bạch Đằng"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-bach-dang-2960>,
        <https://vi.wikipedia.org/wiki/Khu_di_t%C3%ADch_l%E1%BB%8Bch_s%E1%BB%AD_B%E1%BA%A1ch_%C4%90%E1%BA%B1ng> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

