vhr:registry-a011486f3195 a vh:ArchaeologicalSite,
        vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKC và KTNT Óc Eo - Ba Thê"@vi ;
    vh:address "Tỉnh An Giang"^^xsd:string ;
    vh:locatedIn vhr:area-name-1ae6e41a89aa ;
    vh:recognitionYear "2012"^^xsd:gYear ;
    vh:sourcePageId 5277 ;
    vh:sourceTitle "Óc Eo"^^xsd:string ;
    dcterms:description "Óc Eo là một di chỉ khảo cổ tại khu vực núi Ba Thê, thuộc xã Óc Eo, tỉnh An Giang, Việt Nam. Di chỉ này do nhà khảo cổ học người Pháp Louis Malleret ở trường Viễn Đông Bác Cổ chủ trì khai quật lần đầu tiên vào năm 1944."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-khao-co-va-kien-truc-nghe-thuat-oc-eo-ba-the-2965>,
        <https://vi.wikipedia.org/wiki/%C3%93c_Eo> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Óc Eo là một di chỉ khảo cổ tại khu vực núi Ba Thê, thuộc xã Óc Eo, tỉnh An Giang, Việt Nam. Di chỉ này do nhà khảo cổ học người Pháp Louis Malleret ở trường Viễn Đông Bác Cổ chủ trì khai quật lần đầu tiên vào năm 1944."@vi ;
    geo1:lat 10.232944 ;
