vhr:registry-e2626eec5cfe a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Khu lưu niệm Nguyễn Du"@vi ;
    vh:address "Tỉnh Hà Tĩnh"^^xsd:string ;
    vh:locatedIn vhr:area-name-b93dd0ed3491 ;
    vh:recognitionYear "2012"^^xsd:gYear ;
    vh:sourcePageId 19820798 ;
    vh:sourceTitle "Khu lưu niệm Đại thi hào Nguyễn Du"^^xsd:string ;
    dcterms:description """Khu lưu niệm Đại thi hào Nguyễn Du là quần thể những di tích liên quan đến cuộc đời, sự nghiệp của Đại thi hào và dòng họ Nguyễn Tiên Điền. Các điểm di tích phân bố trên địa bàn xã Tiên Điền, huyện Nghi Xuân, tỉnh Hà Tĩnh. Là một quần thể di tích vườn, mà ở đó vừa có sự tách bạch, vừa có sự liên hoàn trong một tổng thể không gian khép kín, là một trong những khu di tích đậm tính nguyên bản của sự mộc mạc của nét làng Việt cổ. Ngày 27/9/2012, Thủ tướng Chính phủ đã ký Quyết định số 1419/QĐ-TTg, xếp hạng Khu lưu niệm Đại thi hào Nguyễn Du là Di tích quốc gia đặc biệt.\r
Quần thể di tích gồm: Khu lưu niệm chính; Mộ đại thi hào Nguyễn Du; Đền thờ và mộ Nguyễn Nghiễm; Đền thờ Nguyễn Trọng; Khu lăng văn sự.\r
Cuối năm 2015, tại di tích Quốc gia đặc biệt này đã diễn ra các hoạt động kỷ niệm 250 năm ngày sinh của danh nhân văn hóa thế giới Nguyễn Du."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-khu-luu-niem-nguyen-du-huyen-nghi-xuan-tinh-ha-tinh-2963>,
        <https://vi.wikipedia.org/wiki/Khu_l%C6%B0u_ni%E1%BB%87m_%C4%90%E1%BA%A1i_thi_h%C3%A0o_Nguy%E1%BB%85n_Du> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Khu lưu niệm Đại thi hào Nguyễn Du là quần thể những di tích liên quan đến cuộc đời, sự nghiệp của Đại thi hào và dòng họ Nguyễn Tiên Điền. Các điểm di tích phân bố trên địa bàn xã Tiên Điền, huyện Nghi Xuân, tỉnh Hà Tĩnh. Là một quần thể di tích vườn, mà ở đó vừa có sự tách bạch, vừa có sự liên hoàn trong một tổng thể không gian khép kín, là một trong những khu di tích đậm tính nguyên bản của sự mộc mạc của nét làng Việt cổ. Ngày 27/9/2012, Thủ tướng Chính phủ đã ký Quyết định số 1419/QĐ-TTg, xếp hạng Khu lưu niệm Đại thi hào Nguyễn Du là Di tích quốc gia đặc biệt.\r
Quần thể di tích gồm: Khu lưu niệm chính; Mộ đại thi hào Nguyễn Du; Đền thờ và mộ Nguyễn Nghiễm; Đền thờ Nguyễn Trọng; Khu lăng văn sự.\r
Cuối năm 2015, tại di tích Quốc gia đặc biệt này đã diễn ra các hoạt động kỷ niệm 250 năm ngày sinh của danh nhân văn hóa thế giới Nguyễn Du."""@vi ;
    skos:altLabel "Khu lưu niệm Đại thi hào Nguyễn Du"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-khu-luu-niem-nguyen-du-huyen-nghi-xuan-tinh-ha-tinh-2963>,
        <https://vi.wikipedia.org/wiki/Khu_l%C6%B0u_ni%E1%BB%87m_%C4%90%E1%BA%A1i_thi_h%C3%A0o_Nguy%E1%BB%85n_Du> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-e2653026213b a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Nhà đày Buôn Mê Thuột"@vi ;
    vh:address "Tỉnh Đắk Lắk"^^xsd:string ;
    vh:locatedIn vhr:area-name-8cb9d0c6b939 ;
    vh:recognitionYear "2018"^^xsd:gYear ;
    vh:sourcePageId 123492 ;
    vh:sourceTitle "Nhà đày Buôn Ma Thuột"^^xsd:string ;
    dcterms:description "Nhà Đày Buôn Ma Thuột là một di tích lịch sử tại Đắk Lắk, Việt Nam với kết cấu là một di tích hệ thống nhà tù (nhà đày) cũ từ thời Pháp thuộc, hiện đang do Sở Văn hóa-Thể thao và Du lịch tỉnh Đắk Lắk quản lý. Trước đó, từ 1975 đến 1979 Nhà đày được giao cho Công an Đắk Lắk quản lý. Từ năm 1979, Nhà đày thuộc sự quản lý của Công ty Văn hoá - Thông tin Đắk Lắk. Ngày 10 tháng 7 năm 1980 Nhà đày được Bộ Văn hóa - Thông tin công nhận là di tích cấp quốc gia."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Nh%C3%A0_%C4%91%C3%A0y_Bu%C3%B4n_Ma_Thu%E1%BB%99t> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Nhà Đày Buôn Ma Thuột là một di tích lịch sử tại Đắk Lắk, Việt Nam với kết cấu là một di tích hệ thống nhà tù (nhà đày) cũ từ thời Pháp thuộc, hiện đang do Sở Văn hóa-Thể thao và Du lịch tỉnh Đắk Lắk quản lý. Trước đó, từ 1975 đến 1979 Nhà đày được giao cho Công an Đắk Lắk quản lý. Từ năm 1979, Nhà đày thuộc sự quản lý của Công ty Văn hoá - Thông tin Đắk Lắk. Ngày 10 tháng 7 năm 1980 Nhà đày được Bộ Văn hóa - Thông tin công nhận là di tích cấp quốc gia."@vi ;
    skos:altLabel "Nhà đày Buôn Ma Thuột"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Nh%C3%A0_%C4%91%C3%A0y_Bu%C3%B4n_Ma_Thu%E1%BB%99t> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

