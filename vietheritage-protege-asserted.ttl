vhr:registry-e85d7323b189 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Chữ Nôm của người Dao"@vi ;
    vh:address "Tỉnh Lào Cai"^^xsd:string ;
    vh:locatedIn vhr:area-name-e163ea76112a ;
    vh:sourcePageId 14440663 ;
    vh:sourceTitle "Chữ Nôm Dao"^^xsd:string ;
    dcterms:description """Chữ Nôm Dao là chữ viết của người Dao, dựa trên chữ Hán và đã được Dao hóa. Chữ Nôm Dao cũng được viết tại Quế Bình, Vân Nam, Long Thắng, Lăng Vân (Bách Sắc, Quảng Tây),huyện Tân Ninh (Thiệu Dương, Hồ Nam) ở Trung Quốc.\r
Chữ Nôm Dao (tại các tỉnh Lào Cai, Thái Nguyên) là di sản văn hóa phi vật thể cấp quốc gia của Việt Nam."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Ch%E1%BB%AF_N%C3%B4m_Dao> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Chữ Nôm Dao là chữ viết của người Dao, dựa trên chữ Hán và đã được Dao hóa. Chữ Nôm Dao cũng được viết tại Quế Bình, Vân Nam, Long Thắng, Lăng Vân (Bách Sắc, Quảng Tây),huyện Tân Ninh (Thiệu Dương, Hồ Nam) ở Trung Quốc.\r
Chữ Nôm Dao (tại các tỉnh Lào Cai, Thái Nguyên) là di sản văn hóa phi vật thể cấp quốc gia của Việt Nam."""@vi ;
