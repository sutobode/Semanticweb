vhr:registry-b7cb354049f4 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Nghệ thuật Xòe Thái"@vi ;
    vh:address "Tỉnh Lai Châu"^^xsd:string ;
    vh:locatedIn vhr:area-name-267dbeb38a9d ;
    vh:sourcePageId 19608258 ;
    vh:sourceTitle "Xòe Thái"^^xsd:string ;
    dcterms:description """Xòe Thái hay xòe, xe, hay ít phổ biến hơn là mố, múa xòe, múa then, hát then là loại hình văn hóa dân gian của người Thái tại Việt Nam. Ngày 15/ 12/2021 tại Phiên họp Uỷ ban Liên Chính phủ Công ước 2003 về bảo vệ di sản văn hóa phi vật thể lần thứ 16 của UNESCO diễn ra tại Paris, thủ đô nước Cộng hòa Pháp, di sản Nghệ thuật Xòe Thái của Việt Nam chính thức được UNESCO ghi danh vào Danh sách Di sản văn hóa phi vật thể đại diện của nhân loại.\r
\r
Người Thái có câu:\r
\r
Không xòe, không tốt lúa\r
Không xòe, thóc cạn bồ\r
Không xòe, hoa sẽ tàn héo\r
Không xòe, trai gái không thành đôi"""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/X%C3%B2e_Th%C3%A1i> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Xòe Thái hay xòe, xe, hay ít phổ biến hơn là mố, múa xòe, múa then, hát then là loại hình văn hóa dân gian của người Thái tại Việt Nam. Ngày 15/ 12/2021 tại Phiên họp Uỷ ban Liên Chính phủ Công ước 2003 về bảo vệ di sản văn hóa phi vật thể lần thứ 16 của UNESCO diễn ra tại Paris, thủ đô nước Cộng hòa Pháp, di sản Nghệ thuật Xòe Thái của Việt Nam chính thức được UNESCO ghi danh vào Danh sách Di sản văn hóa phi vật thể đại diện của nhân loại.\r
\r
Người Thái có câu:\r
\r
Không xòe, không tốt lúa\r
Không xòe, thóc cạn bồ\r
Không xòe, hoa sẽ tàn héo\r
Không xòe, trai gái không thành đôi"""@vi ;
    skos:altLabel "Xòe Thái"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/X%C3%B2e_Th%C3%A1i> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

