vhr:registry-069da54d9cc1 a vh:ArchitecturalSite,
        vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS và KTNT Chùa Bổ Đà"@vi ;
    vh:address "Tỉnh Bắc Giang"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q16480384,
        vhr:person-wikidata-q4604 ;
    vh:locatedIn vhr:area-name-34bf35f4ea37 ;
    vh:recognitionYear "2016"^^xsd:gYear ;
    vh:sourcePageId 18968 ;
    vh:sourceTitle "Chùa Bổ Đà"^^xsd:string ;
    dcterms:description """Chùa Bổ Đà còn được gọi là chùa Bổ, chùa Tam Giáo, còn có tên chữ là Tứ Ân tự (四恩寺) toạ lạc trên ngọn núi Phượng Hoàng (Bổ Đà sơn), bờ tả dòng sông Cầu, thuộc địa phận tổ dân phố Thượng Lát, phường Vân Hà, thành phố Bắc Ninh (thời phong kiến là xã Tiên Lát, tổng Tiên Lát, huyện Yên Việt, phủ Bắc Hà, trấn Kinh Bắc xưa). Chùa Bổ Đà là một trong những ngôi chùa độc đáo nhất vùng đất Kinh Bắc, là trung tâm Phật giáo lớn - chốn Tổ của dòng thiền Trúc Lâm Yên Tử. Chùa đã được công nhận là Di tích quốc gia đặc biệt năm 2016 và bộ kinh phật khắc trên gỗ thị lưu giữ trong chùa được đánh giá là cổ nhất của dòng thiền Lâm Tế,...\r
Chùa Bổ Đà là 1 trong 12 cụm di tích thuộc Quần thể di tích và danh thắng Yên Tử – Vĩnh Nghiêm – Côn Sơn, Kiếp Bạc đã được UNESCO công nhận là Di sản văn hoá thế giới năm 2025."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-chua-bo-da-2998>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_B%E1%BB%95_%C4%90%C3%A0> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Chùa Bổ Đà còn được gọi là chùa Bổ, chùa Tam Giáo, còn có tên chữ là Tứ Ân tự (四恩寺) toạ lạc trên ngọn núi Phượng Hoàng (Bổ Đà sơn), bờ tả dòng sông Cầu, thuộc địa phận tổ dân phố Thượng Lát, phường Vân Hà, thành phố Bắc Ninh (thời phong kiến là xã Tiên Lát, tổng Tiên Lát, huyện Yên Việt, phủ Bắc Hà, trấn Kinh Bắc xưa). Chùa Bổ Đà là một trong những ngôi chùa độc đáo nhất vùng đất Kinh Bắc, là trung tâm Phật giáo lớn - chốn Tổ của dòng thiền Trúc Lâm Yên Tử. Chùa đã được công nhận là Di tích quốc gia đặc biệt năm 2016 và bộ kinh phật khắc trên gỗ thị lưu giữ trong chùa được đánh giá là cổ nhất của dòng thiền Lâm Tế,...\r
Chùa Bổ Đà là 1 trong 12 cụm di tích thuộc Quần thể di tích và danh thắng Yên Tử – Vĩnh Nghiêm – Côn Sơn, Kiếp Bạc đã được UNESCO công nhận là Di sản văn hoá thế giới năm 2025."""@vi ;
    skos:altLabel "Chùa Bổ Đà"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-chua-bo-da-2998>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_B%E1%BB%95_%C4%90%C3%A0> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

