vhr:registry-c842907c028e a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Khu đền thờ Tây Sơn - Tam Kiệt"@vi ;
    vh:address "Tỉnh Bình Định"^^xsd:string ;
    vh:locatedIn vhr:area-name-574f21fd28ba ;
    vh:recognitionYear "2014"^^xsd:gYear ;
    vh:sourcePageId 19476663 ;
    vh:sourceTitle "Bảo tàng Quang Trung"^^xsd:string ;
    dcterms:description """Bảo tàng Quang Trung là một bảo tàng nằm ở Khối 1, xã Tây Sơn, tỉnh Gia Lai, Việt Nam, đối diện sông Côn, bao quanh bởi đường tỉnh lộ 636, Quốc lộ 19B, đường Ngọc Hân Công chúa, đường Nguyễn Nhạc, đường Đống Đa. Bảo tàng được xây dựng trên nền nhà cũ của anh em Nhà Tây Sơn, vùng đất quê hương của Tây Sơn tam kiệt, vị trí bao quanh Đền thờ Tây Sơn tam kiệt hay Điện Tây Sơn. Ngày nay, tên của bảo tàng được đặt theo Tây Sơn Thái Tổ, Hoàng đế Quang Trung.\r
Bảo tàng Quang Trung tập trung thờ và tưởng niệm anh hùng áo vải Nguyễn Huệ, lưu giữ những hiện vật lịch sử liên quan đến Cuộc khởi nghĩa Tây Sơn, dấu tích ba anh em Nhà Tây Sơn: Nguyễn Huệ, Nguyễn Nhạc, Nguyễn Lữ. Bảo tàng Quang Trung là địa chỉ hấp dẫn các nhà nghiên cứu, du khách trong và ngoài nước khi đến với vùng đất Nam Trung Bộ, một trong những bảo tàng thu hút được đông đảo khách tham quan du lịch và tìm hiểu về lịch sử nhiều nhất ở Việt Nam."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-khu-den-tho-tay-son-tam-kiet-2985>,
        <https://vi.wikipedia.org/wiki/B%E1%BA%A3o_t%C3%A0ng_Quang_Trung> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Bảo tàng Quang Trung là một bảo tàng nằm ở Khối 1, xã Tây Sơn, tỉnh Gia Lai, Việt Nam, đối diện sông Côn, bao quanh bởi đường tỉnh lộ 636, Quốc lộ 19B, đường Ngọc Hân Công chúa, đường Nguyễn Nhạc, đường Đống Đa. Bảo tàng được xây dựng trên nền nhà cũ của anh em Nhà Tây Sơn, vùng đất quê hương của Tây Sơn tam kiệt, vị trí bao quanh Đền thờ Tây Sơn tam kiệt hay Điện Tây Sơn. Ngày nay, tên của bảo tàng được đặt theo Tây Sơn Thái Tổ, Hoàng đế Quang Trung.\r
Bảo tàng Quang Trung tập trung thờ và tưởng niệm anh hùng áo vải Nguyễn Huệ, lưu giữ những hiện vật lịch sử liên quan đến Cuộc khởi nghĩa Tây Sơn, dấu tích ba anh em Nhà Tây Sơn: Nguyễn Huệ, Nguyễn Nhạc, Nguyễn Lữ. Bảo tàng Quang Trung là địa chỉ hấp dẫn các nhà nghiên cứu, du khách trong và ngoài nước khi đến với vùng đất Nam Trung Bộ, một trong những bảo tàng thu hút được đông đảo khách tham quan du lịch và tìm hiểu về lịch sử nhiều nhất ở Việt Nam."""@vi ;
    skos:altLabel "Bảo tàng Quang Trung"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-khu-den-tho-tay-son-tam-kiet-2985>,
        <https://vi.wikipedia.org/wiki/B%E1%BA%A3o_t%C3%A0ng_Quang_Trung> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

