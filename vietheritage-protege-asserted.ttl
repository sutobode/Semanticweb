vhr:registry-dfc07d4f4ef2 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Lễ hội Katê của người Chăm"@vi ;
    vh:address "Tỉnh Bình Thuận"^^xsd:string ;
    vh:locatedIn vhr:area-name-0963f7238f98 ;
    vh:sourcePageId 308056 ;
    vh:sourceTitle "Lễ hội Katé"^^xsd:string ;
    dcterms:description "Lễ hội Katé còn được gọi là Mbang Katé là một lễ hội của đồng bào dân tộc Chăm. Đây là một lễ hội dân gian thiêng liêng đặc sắc và rất quan trọng. Lễ hội tổ chức nhằm tưởng nhớ đến những người đã khuất, tưởng nhớ đến các vị anh hùng dân tộc (được người Chăm tôn vinh làm thần). Thường được tổ chức vào 1 tháng 7 theo lịch của người Chăm (khoảng 25/9 đến 25/10 dương lịch). Người dân tập trung tại các đền tháp cổ kính, thưởng thức các điệu múa nhạc dân gian trong kho tàng âm nhạc của người Chăm. Mọi người nghỉ ngơi và tràn ngập niềm vui, đi thăm viếng chúc tụng lẫn nhau. Lễ hội được chia làm hai phần là phần lễ và phần hội"@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_Kat%C3%A9> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment "Lễ hội Katé còn được gọi là Mbang Katé là một lễ hội của đồng bào dân tộc Chăm. Đây là một lễ hội dân gian thiêng liêng đặc sắc và rất quan trọng. Lễ hội tổ chức nhằm tưởng nhớ đến những người đã khuất, tưởng nhớ đến các vị anh hùng dân tộc (được người Chăm tôn vinh làm thần). Thường được tổ chức vào 1 tháng 7 theo lịch của người Chăm (khoảng 25/9 đến 25/10 dương lịch). Người dân tập trung tại các đền tháp cổ kính, thưởng thức các điệu múa nhạc dân gian trong kho tàng âm nhạc của người Chăm. Mọi người nghỉ ngơi và tràn ngập niềm vui, đi thăm viếng chúc tụng lẫn nhau. Lễ hội được chia làm hai phần là phần lễ và phần hội"@vi ;
    skos:altLabel "Lễ hội Katé"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_Kat%C3%A9> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-dfcef178d549 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Đền Hai Bà Trưng"@vi ;
    vh:address "Thành phố Hà Nội"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q25418141,
        vhr:person-wikidata-q25418142 ;
    vh:locatedIn vhr:area-name-8de4ed043a59 ;
    vh:recognitionYear "2013"^^xsd:gYear ;
    vh:sourcePageId 14584334 ;
    vh:sourceTitle "Đền Hai Bà Trưng (Hạ Lôi)"^^xsd:string ;
    dcterms:description """Đền Hai Bà Trưng còn gọi là đền Hạ Lôi ở thôn Hạ Lôi xã Mê Linh, thành phố Hà Nội. Đền thờ hai vị liệt nữ - anh hùng dân tộc là Trưng Trắc và Trưng Nhị.\r
Để tưởng nhớ công đức của Hai Bà, nhân dân đã lập đền thờ tại thôn Hạ Lôi, xã Mê Linh, huyện Mê Linh, hàng năm tổ chức lễ hội tưởng nhớ công đức của Hai Bà và các tướng lĩnh từ ngày mùng 4 đến mùng 10 tháng Giêng.\r
Đền thờ Hai Bà Trưng được công nhận di tích lịch sử - văn hóa cấp quốc gia năm 1980."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-den-hai-ba-trung-2970>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Hai_B%C3%A0_Tr%C6%B0ng_(H%E1%BA%A1_L%C3%B4i)> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đền Hai Bà Trưng còn gọi là đền Hạ Lôi ở thôn Hạ Lôi xã Mê Linh, thành phố Hà Nội. Đền thờ hai vị liệt nữ - anh hùng dân tộc là Trưng Trắc và Trưng Nhị.\r
Để tưởng nhớ công đức của Hai Bà, nhân dân đã lập đền thờ tại thôn Hạ Lôi, xã Mê Linh, huyện Mê Linh, hàng năm tổ chức lễ hội tưởng nhớ công đức của Hai Bà và các tướng lĩnh từ ngày mùng 4 đến mùng 10 tháng Giêng.\r
Đền thờ Hai Bà Trưng được công nhận di tích lịch sử - văn hóa cấp quốc gia năm 1980."""@vi ;
    geo1:lat 21.160542 ;
    geo1:long 105.739047 ;
    skos:altLabel "Đền Hai Bà Trưng (Hạ Lôi)"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-den-hai-ba-trung-2970>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Hai_B%C3%A0_Tr%C6%B0ng_(H%E1%BA%A1_L%C3%B4i)> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

