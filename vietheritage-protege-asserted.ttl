vhr:registry-86f42708d93f a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Khu di tích Nhà Trần tại Đông Triều"@vi ;
    vh:address "Tỉnh Quảng Ninh"^^xsd:string ;
    vh:locatedIn vhr:area-name-cff49d8e0895 ;
    vh:recognitionYear "2013"^^xsd:gYear ;
    vh:sourcePageId 1742855 ;
    vh:sourceTitle "Khu di tích nhà Trần tại Đông Triều"^^xsd:string ;
    dcterms:description "Khu di tích nhà Trần tại Đông Triều, thành phố Quảng Ninh được Thủ tướng Chính phủ Việt Nam xếp hạng di tích Quốc gia đặc biệt quan trọng. Đây là di tích quan trọng bậc nhất của vương triều Trần khi nằm trên quê hương đất tổ, nơi lưu giữ Thái miếu nhà Trần và lăng mộ của các Vua cùng tông thất nhà Trần bên cạnh các di tích chiến thắng Bạch Đằng và Trúc Lâm Yên Tử. Khu di tích này có 2 di tích là thái miếu nhà Trần và chùa Ngoạ Vân nằm trong Quần thể di tích và danh thắng Yên Tử – Vĩnh Nghiêm – Côn Sơn, Kiếp Bạc đã được UNESCO công nhận là di sản thế giới từ năm 2025."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/khu-di-tich-lich-su-nha-tran-tai-dong-trieu-2972>,
        <https://vi.wikipedia.org/wiki/Khu_di_t%C3%ADch_nh%C3%A0_Tr%E1%BA%A7n_t%E1%BA%A1i_%C4%90%C3%B4ng_Tri%E1%BB%81u> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Khu di tích nhà Trần tại Đông Triều, thành phố Quảng Ninh được Thủ tướng Chính phủ Việt Nam xếp hạng di tích Quốc gia đặc biệt quan trọng. Đây là di tích quan trọng bậc nhất của vương triều Trần khi nằm trên quê hương đất tổ, nơi lưu giữ Thái miếu nhà Trần và lăng mộ của các Vua cùng tông thất nhà Trần bên cạnh các di tích chiến thắng Bạch Đằng và Trúc Lâm Yên Tử. Khu di tích này có 2 di tích là thái miếu nhà Trần và chùa Ngoạ Vân nằm trong Quần thể di tích và danh thắng Yên Tử – Vĩnh Nghiêm – Côn Sơn, Kiếp Bạc đã được UNESCO công nhận là di sản thế giới từ năm 2025."@vi ;
    skos:altLabel "Khu di tích nhà Trần tại Đông Triều"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/khu-di-tich-lich-su-nha-tran-tai-dong-trieu-2972>,
        <https://vi.wikipedia.org/wiki/Khu_di_t%C3%ADch_nh%C3%A0_Tr%E1%BA%A7n_t%E1%BA%A1i_%C4%90%C3%B4ng_Tri%E1%BB%81u> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

