vhr:registry-2daf70c29214 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Lễ hội Gầu tào"@vi ;
    vh:address "Tỉnh Lào Cai Tỉnh Hà Giang"^^xsd:string ;
    vh:locatedIn vhr:area-name-99be0b794c77,
        vhr:area-name-e163ea76112a ;
    vh:sourcePageId 317932 ;
    vh:sourceTitle "Lễ hội gầu tào"^^xsd:string ;
    dcterms:description """Lễ hội Gầu tào là một lễ hội của người đồng bào dân tộc H'Mông. Nội dung chính cho lễ hội là Cầu phúc hoặc cầu mệnh.\r
\r
Hội cầu phúc: Một gia chủ nào đó không có con, thưa con hoặc sinh con một bề, sẽ làm lễ nhờ thầy cúng bói xin cho mở hội Gầu tào nhằm cầu mong có con.\r
Hội cầu mệnh: Một gia chủ nào đó bị ốm đau bệnh tật, con cái yếu ớt, thậm chí có con bị chết, mùa màng, vật nuôi lụi dần, cũng nhờ thầy cúng bói xin mở hội Gầu tào."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/le-hoi-gau-tao-cua-nguoi-mong-o-lao-cai-3158>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_g%E1%BA%A7u_t%C3%A0o> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Lễ hội Gầu tào là một lễ hội của người đồng bào dân tộc H'Mông. Nội dung chính cho lễ hội là Cầu phúc hoặc cầu mệnh.\r
\r
Hội cầu phúc: Một gia chủ nào đó không có con, thưa con hoặc sinh con một bề, sẽ làm lễ nhờ thầy cúng bói xin cho mở hội Gầu tào nhằm cầu mong có con.\r
Hội cầu mệnh: Một gia chủ nào đó bị ốm đau bệnh tật, con cái yếu ớt, thậm chí có con bị chết, mùa màng, vật nuôi lụi dần, cũng nhờ thầy cúng bói xin mở hội Gầu tào."""@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/le-hoi-gau-tao-cua-nguoi-mong-o-lao-cai-3158>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_g%E1%BA%A7u_t%C3%A0o> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

