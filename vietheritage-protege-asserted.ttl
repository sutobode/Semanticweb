vhr:registry-fd03e1f1662c-53c105 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "Chùa Giám"@vi ;
    vh:address "Tỉnh Hải Dương"^^xsd:string ;
    vh:locatedIn vhr:area-name-4f99714e585c ;
    vh:recognitionYear "2017"^^xsd:gYear ;
    vh:sourcePageId 19608644 ;
    vh:sourceTitle "Chùa Giám"^^xsd:string ;
    dcterms:description "Chùa Giám (tên chữ là Nghiêm Quang Tự) (chữ Hán: 嚴光寺) là một ngôi chùa thuộc xã Cẩm Giàng, thành phố Hải Phòng. Đây là công trình Phật giáo độc đáo chỉ có duy nhất ở Việt Nam."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_Gi%C3%A1m> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Chùa Giám (tên chữ là Nghiêm Quang Tự) (chữ Hán: 嚴光寺) là một ngôi chùa thuộc xã Cẩm Giàng, thành phố Hải Phòng. Đây là công trình Phật giáo độc đáo chỉ có duy nhất ở Việt Nam."@vi ;
    skos:altLabel "DTLS Đền Xưa - Chùa Giám - Đền Bia"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_Gi%C3%A1m> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-fd03e1f1662c-f33488 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "Đền Bia"@vi ;
    vh:address "Tỉnh Hải Dương"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q10830179 ;
    vh:locatedIn vhr:area-name-4f99714e585c ;
    vh:recognitionYear "2017"^^xsd:gYear ;
    vh:sourcePageId 19567681 ;
    vh:sourceTitle "Đền Bia"^^xsd:string ;
    dcterms:description """Đền Bia một ngôi đền tại xã Tuệ Tĩnh, thành phố Hải Phòng, Việt Nam. Đây là một trong 3 di tích quốc gia đặc biệt thờ Đại danh y – Thiền sư Tuệ Tĩnh tại huyện Cẩm Giàng (cùng với Đền Xưa và Chùa Giám).\r
Đền Bia nằm trên cánh đồng phía tây thôn Văn Thai, xã Cẩm Văn. Trong đền có tấm bia đá từ thời Hậu Lê, là di vật kỷ niệm của danh y Tuệ Tĩnh nên đền có tên là Đền Bia.\r
Đền được xây dựng từ thời Lê, xây dựng lại vào năm 1936, theo kiểu tiền nhất Hậu chữ Đinh (丁) mặt tiền quay về hướng Bắc. Ngày nay đền Bia là một công trình khang trang bề thế tọa lạc trên một diện tích rộng 4 ha, được phân làm 3 khu vực với đầy đủ các hạng mục công trình chính và phụ trợ:\r
\r
Khu thờ tự gồm 5 công trình: nghi môn, thủy lăng, bức bình phong bằng đá, hai bên là hai dãy tả vu, hữu vu\r
Khu y xá gồm ba công trình: nhà bắt mạch kê đơn thuốc, nhà bốc thuốc và nhà chẩn trị\r
Khu vườn thuốc: đây là một vườn thuốc Nam rộng 1.200 m², được chia làm 9 ô tương ứng với 9 bài thuốc là 9 nhóm bệnh theo hướng dẫn của Bộ Y tế gồm: cảm sốt, mụn nhọt, điều kinh, đau nhức xương khớp, ho, kiết lỵ, tiêu chảy, sốt xuất huyết và viêm gan siêu vi trùng."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Bia> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đền Bia một ngôi đền tại xã Tuệ Tĩnh, thành phố Hải Phòng, Việt Nam. Đây là một trong 3 di tích quốc gia đặc biệt thờ Đại danh y – Thiền sư Tuệ Tĩnh tại huyện Cẩm Giàng (cùng với Đền Xưa và Chùa Giám).\r
