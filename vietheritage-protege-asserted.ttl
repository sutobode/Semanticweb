vhr:registry-3c300abb9903 a vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKTNT Chùa Keo Hành Thiện"@vi ;
    vh:address "Tỉnh Nam Định"^^xsd:string ;
    vh:constructionYear "1611"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-dca800e51853 ;
    vh:recognitionYear "2016"^^xsd:gYear ;
    vh:sourcePageId 530185 ;
    vh:sourceTitle "Chùa Keo Hành Thiện"^^xsd:string ;
    dcterms:description "Chùa Keo (tên chữ: Thần Quang tự 神 光 寺) là một ngôi chùa ở làng Hành Thiện, xã Xuân Hồng, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới chùa 57 km. Đây là một trong những ngôi chùa cổ ở Việt Nam được bảo tồn hầu như còn nguyên vẹn kiến trúc 400 năm tuổi. Chùa đã được xếp hạng di tích quốc gia đặc biệt từ năm 2016."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-chua-keo-hanh-thien-2997>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_Keo_H%C3%A0nh_Thi%E1%BB%87n> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Chùa Keo (tên chữ: Thần Quang tự 神 光 寺) là một ngôi chùa ở làng Hành Thiện, xã Xuân Hồng, tỉnh Ninh Bình, Việt Nam. Từ phường Hoa Lư, trung tâm tỉnh Ninh Bình tới chùa 57 km. Đây là một trong những ngôi chùa cổ ở Việt Nam được bảo tồn hầu như còn nguyên vẹn kiến trúc 400 năm tuổi. Chùa đã được xếp hạng di tích quốc gia đặc biệt từ năm 2016."@vi ;
    geo1:lat 20.34222222 ;
    geo1:long 106.32166667 ;
    skos:altLabel "Chùa Keo Hành Thiện"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-chua-keo-hanh-thien-2997>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_Keo_H%C3%A0nh_Thi%E1%BB%87n> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

