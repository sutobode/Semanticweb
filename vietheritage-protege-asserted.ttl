vhr:registry-8328a08abe0a a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Tranh dân gian Đông Hồ"@vi ;
    vh:address "Xã Song Hồ, huyện Thuận Thành, tỉnh Bắc Ninh"^^xsd:string ;
    vh:locatedIn vhr:area-name-34bf35f4ea37 ;
    vh:sourcePageId 7447 ;
    vh:sourceTitle "Tranh Đông Hồ"^^xsd:string ;
    dcterms:description """Tranh Đông Hồ, hay tên đầy đủ là tranh khắc gỗ Đông Hồ, là một dòng tranh dân gian Việt Nam với xuất xứ từ làng Đông Hồ (phường Thuận Thành, thành phố Bắc Ninh). Trước kia tranh được bán ra chủ yếu phục vụ cho dịp Tết Nguyên Đán, người dân nông thôn mua tranh về dán trên tường, hết năm lại lột bỏ, dùng tranh mới.\r
Nghề làm tranh dân gian Đông Hồ được UNESCO ghi danh là Di sản văn hóa phi vật thể cần bảo vệ khẩn cấp, đồng thời là Di sản văn hóa phi vật thể cấp Quốc gia.\r
Thơ Tú Xương có tranh Đông Hồ về ngày Tết là:\r
\r
Đì đoẹt ngoài sân tràng pháo chuột\r
Loẹt lòe trên vách bức tranh gà\r
Đó cũng là lí do để chứng minh rằng tranh gỗ dân gian Đông Hồ rất phổ biến.\r
Tại Bắc Ninh, có thể về làng tranh Đông Hồ, Song Hồ, Thuận Thành để xem tranh.\r
Tại Hà Nội, có thể xem tranh tại 19 ngõ 179 Hoàng Hoa Thám, Ba Đình, Hà Nội."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/tranh-dan-gian-dong-ho-3151>,
        <https://vi.wikipedia.org/wiki/Tranh_%C4%90%C3%B4ng_H%E1%BB%93> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Tranh Đông Hồ, hay tên đầy đủ là tranh khắc gỗ Đông Hồ, là một dòng tranh dân gian Việt Nam với xuất xứ từ làng Đông Hồ (phường Thuận Thành, thành phố Bắc Ninh). Trước kia tranh được bán ra chủ yếu phục vụ cho dịp Tết Nguyên Đán, người dân nông thôn mua tranh về dán trên tường, hết năm lại lột bỏ, dùng tranh mới.\r
Nghề làm tranh dân gian Đông Hồ được UNESCO ghi danh là Di sản văn hóa phi vật thể cần bảo vệ khẩn cấp, đồng thời là Di sản văn hóa phi vật thể cấp Quốc gia.\r
Thơ Tú Xương có tranh Đông Hồ về ngày Tết là:\r
\r
Đì đoẹt ngoài sân tràng pháo chuột\r
Loẹt lòe trên vách bức tranh gà\r
Đó cũng là lí do để chứng minh rằng tranh gỗ dân gian Đông Hồ rất phổ biến.\r
Tại Bắc Ninh, có thể về làng tranh Đông Hồ, Song Hồ, Thuận Thành để xem tranh.\r
Tại Hà Nội, có thể xem tranh tại 19 ngõ 179 Hoàng Hoa Thám, Ba Đình, Hà Nội."""@vi ;
    skos:altLabel "Tranh Đông Hồ"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/tranh-dan-gian-dong-ho-3151>,
        <https://vi.wikipedia.org/wiki/Tranh_%C4%90%C3%B4ng_H%E1%BB%93> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

