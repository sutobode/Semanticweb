vh:associatedWithPerson a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "associated with person"@en,
        "liên quan tới nhân vật"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range vh:HistoricalPerson .

vh:partOf a rdf:Property,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"@en,
        "thuộc quần thể"@vi ;
    rdfs:domain vh:CulturalHeritageEntity ;
    rdfs:range vh:HeritageComplex ;
    owl:inverseOf vh:hasPart .

vh:recognizedBy a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "recognized by"@en,
        "được công nhận bởi"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range vh:Organization .

