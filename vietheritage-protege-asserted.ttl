vhr:registry-a3ceed236a60 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Trại giam Phú Quốc"@vi ;
    vh:address "Tỉnh Kiên Giang"^^xsd:string ;
    vh:locatedIn vhr:area-name-1ae6e41a89aa ;
    vh:recognitionYear "2014"^^xsd:gYear ;
    vh:sourcePageId 17050 ;
    vh:sourceTitle "Nhà tù Phú Quốc"^^xsd:string ;
    dcterms:description """Trại giam Tù binh Chiến tranh Phú Quốc, hay Trại giam Tù binh Cộng sản Phú Quốc là một trại giam nằm tại khu vực An Thới ở phía nam đặc khu Phú Quốc. Trong Chiến tranh Đông Dương, trại giam này có tên là Nhà lao Cây Dừa. Đây là trại giam tù binh trung tâm toàn Việt Nam Cộng hòa, từng giam giữ hơn 32.000 tù binh (40.000 tù nhân nếu tính cả tù chính trị nhiều thời kỳ).\r
Trại giam Tù binh Chiến tranh Phú Quốc có tất cả là 12 khu (năm 1972) được đánh số từ khu 1 đến khu 12. Riêng khu 13, 14 được xây dựng thêm vào cuối năm 1972. Mỗi khu trại giam có khả năng chứa khoảng 3000 tù nhân. Năm 1972, có khoảng 36 000 tù nhân. Mỗi khu trại giam lại được chia làm nhiều phân khu. Thường thì có 4 phân khu, trong 1 khu. Một phân khu chứa được 950 tù binh. Riêng phân khu B2 dành riêng để giam giữ các sĩ quan. Tù binh có cấp bậc lớn nhất là Thượng tá. Trại giam Tù binh Chiến tranh Phú Quốc do 3 tiểu đoàn quân cảnh (7, 8, 12) canh giữ.\r
Ngoài ra, Nhà tù Phú Quốc cũng có một trại giam tù hình sự, giam giữ những tù nhân thường phạm bị kết án 10 năm trở lên, ở phường Dương Đông, mặt tây của đảo.\r
Hiện tại Nhà tù Phú Quốc là một trong những điểm du lịch lịch sử."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-trai-giam-phu-quoc-2988>,
        <https://vi.wikipedia.org/wiki/Nh%C3%A0_t%C3%B9_Ph%C3%BA_Qu%E1%BB%91c> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Trại giam Tù binh Chiến tranh Phú Quốc, hay Trại giam Tù binh Cộng sản Phú Quốc là một trại giam nằm tại khu vực An Thới ở phía nam đặc khu Phú Quốc. Trong Chiến tranh Đông Dương, trại giam này có tên là Nhà lao Cây Dừa. Đây là trại giam tù binh trung tâm toàn Việt Nam Cộng hòa, từng giam giữ hơn 32.000 tù binh (40.000 tù nhân nếu tính cả tù chính trị nhiều thời kỳ).\r
Trại giam Tù binh Chiến tranh Phú Quốc có tất cả là 12 khu (năm 1972) được đánh số từ khu 1 đến khu 12. Riêng khu 13, 14 được xây dựng thêm vào cuối năm 1972. Mỗi khu trại giam có khả năng chứa khoảng 3000 tù nhân. Năm 1972, có khoảng 36 000 tù nhân. Mỗi khu trại giam lại được chia làm nhiều phân khu. Thường thì có 4 phân khu, trong 1 khu. Một phân khu chứa được 950 tù binh. Riêng phân khu B2 dành riêng để giam giữ các sĩ quan. Tù binh có cấp bậc lớn nhất là Thượng tá. Trại giam Tù binh Chiến tranh Phú Quốc do 3 tiểu đoàn quân cảnh (7, 8, 12) canh giữ.\r
Ngoài ra, Nhà tù Phú Quốc cũng có một trại giam tù hình sự, giam giữ những tù nhân thường phạm bị kết án 10 năm trở lên, ở phường Dương Đông, mặt tây của đảo.\r
Hiện tại Nhà tù Phú Quốc là một trong những điểm du lịch lịch sử."""@vi ;
    geo1:lat 10.043948 ;
    geo1:long 104.018179 ;
    skos:altLabel "Nhà tù Phú Quốc"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-trai-giam-phu-quoc-2988>,
        <https://vi.wikipedia.org/wiki/Nh%C3%A0_t%C3%B9_Ph%C3%BA_Qu%E1%BB%91c> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

