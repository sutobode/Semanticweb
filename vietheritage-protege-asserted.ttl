vhr:registry-e4c164e3008e a vh:ArchaeologicalSite,
        vh:HeritageSite ;
    rdfs:label "DTKC Mộ Cự Thạch Hàng Gòn"@vi ;
    vh:address "Tỉnh Đồng Nai"^^xsd:string ;
    vh:locatedIn vhr:area-name-11e91641fb6c ;
    vh:recognitionYear "2015"^^xsd:gYear ;
    vh:sourcePageId 19521156 ;
    vh:sourceTitle "Mộ cự thạch Hàng Gòn"^^xsd:string ;
    dcterms:description "Mộ cự thạch Hàng Gòn (còn được gọi là Di chỉ Hàng Gòn 7, Mộ Đông Dương, Mả Ông Đá) là một di tích khảo cổ tại phường Hàng Gòn, thành phố Đồng Nai, Việt Nam. Đây là một ngôi mộ cổ được phát hiện và khai quật từ năm 1927, thuộc loại hình mộ táng Dolmen độc đáo trong hệ thống di chỉ khảo cổ học ở Việt Nam."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-khao-co-mo-cu-thach-hang-gon-1285>,
        <https://vi.wikipedia.org/wiki/M%E1%BB%99_c%E1%BB%B1_th%E1%BA%A1ch_H%C3%A0ng_G%C3%B2n> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Mộ cự thạch Hàng Gòn (còn được gọi là Di chỉ Hàng Gòn 7, Mộ Đông Dương, Mả Ông Đá) là một di tích khảo cổ tại phường Hàng Gòn, thành phố Đồng Nai, Việt Nam. Đây là một ngôi mộ cổ được phát hiện và khai quật từ năm 1927, thuộc loại hình mộ táng Dolmen độc đáo trong hệ thống di chỉ khảo cổ học ở Việt Nam."@vi ;
    geo1:lat 10.864361 ;
    geo1:long 107.230614 ;
    skos:altLabel "Mộ cự thạch Hàng Gòn"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-khao-co-mo-cu-thach-hang-gon-1285>,
        <https://vi.wikipedia.org/wiki/M%E1%BB%99_c%E1%BB%B1_th%E1%BA%A1ch_H%C3%A0ng_G%C3%B2n> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

