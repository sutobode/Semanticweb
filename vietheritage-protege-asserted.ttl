vhr:registry-00e726adaa7a a vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKTNT Đình Chèm"@vi ;
    vh:address "Thành phố Hà Nội"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q10788162 ;
    vh:locatedIn vhr:area-name-8de4ed043a59 ;
    vh:recognitionYear "2017"^^xsd:gYear ;
    vh:sourcePageId 108941 ;
    vh:sourceTitle "Đình Chèm"^^xsd:string ;
    dcterms:description """Đình Chèm là ngôi đình của làng Thụy Phương (tên Nôm là Chèm), nay thuộc phường Đông Ngạc, thành phố Hà Nội. Đình thờ Thượng đẳng Thiên vương Lý Ông Trọng và Hoàng phi Bạch Tĩnh Cung, đều vào thời An Dương Vương. Đình Chèm được xem là một trong những ngôi đình cổ nhất Việt Nam, và là một công trình kiến trúc có nghệ thuật chạm khắc độc đáo. Ngoài làng Thụy Phương, đình còn là nơi thờ tự của người dân hai làng lân cận, Hoàng Xá và Liên Mạc.\r
Đình Chèm không chỉ là một công trình với kiến trúc cổ kính, mà còn mang trong mình sự tích về một vị tướng tài đức, có công dẹp giặc cứu nước."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Ch%C3%A8m> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đình Chèm là ngôi đình của làng Thụy Phương (tên Nôm là Chèm), nay thuộc phường Đông Ngạc, thành phố Hà Nội. Đình thờ Thượng đẳng Thiên vương Lý Ông Trọng và Hoàng phi Bạch Tĩnh Cung, đều vào thời An Dương Vương. Đình Chèm được xem là một trong những ngôi đình cổ nhất Việt Nam, và là một công trình kiến trúc có nghệ thuật chạm khắc độc đáo. Ngoài làng Thụy Phương, đình còn là nơi thờ tự của người dân hai làng lân cận, Hoàng Xá và Liên Mạc.\r
Đình Chèm không chỉ là một công trình với kiến trúc cổ kính, mà còn mang trong mình sự tích về một vị tướng tài đức, có công dẹp giặc cứu nước."""@vi ;
    skos:altLabel "Đình Chèm"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Ch%C3%A8m> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

