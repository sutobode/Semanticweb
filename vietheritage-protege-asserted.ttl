vhr:registry-06fd74b2ed89-3a7ac2 a vh:HeritageSite ;
    rdfs:label "Đình Hoàng Mai"@vi ;
    vh:address "Thành phố Hà Nội"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q49056066,
        vhr:person-wikidata-q6669645 ;
    vh:constructionYear "1799"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-8de4ed043a59 ;
    vh:recognitionYear "1994"^^xsd:gYear ;
    vh:sourcePageId 1220447 ;
    vh:sourceTitle "Đình Hoàng Mai"^^xsd:string ;
    dcterms:description "Đình Hoàng Mai (tên chữ: Biểu Trung từ) có địa chỉ trên đường Hoàng Mai, phường Tương Mai, Hà Nội, tọa lạc trong ngõ 160 đường Hoàng Mai, phường Tương Mai, Hà Nội. Đình Hoàng Mai dựng năm 1799, dân gọi đình Cả, đình thờ Thượng tướng Trần Khát Chân và em là Trần Hãng (hay còn gọi là Trần Hương)."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/dinh-hoang-mai-chua-nga-my-thanh-pho-ha-noi-22276>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Ho%C3%A0ng_Mai> ;
    dcterms:subject "national_monuments" ;
    rdfs:comment "Đình Hoàng Mai (tên chữ: Biểu Trung từ) có địa chỉ trên đường Hoàng Mai, phường Tương Mai, Hà Nội, tọa lạc trong ngõ 160 đường Hoàng Mai, phường Tương Mai, Hà Nội. Đình Hoàng Mai dựng năm 1799, dân gọi đình Cả, đình thờ Thượng tướng Trần Khát Chân và em là Trần Hãng (hay còn gọi là Trần Hương)."@vi ;
    geo1:lat 20.990444 ;
    geo1:long 105.852604 ;
    skos:altLabel "Đình Hoàng Mai, chùa Nga My"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/dinh-hoang-mai-chua-nga-my-thanh-pho-ha-noi-22276>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%ACnh_Ho%C3%A0ng_Mai> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-06fd74b2ed89-d87046 a vh:HeritageSite ;
    rdfs:label "Chùa Nga My"@vi ;
    vh:address "Thành phố Hà Nội"^^xsd:string ;
    vh:locatedIn vhr:area-name-8de4ed043a59 ;
    vh:recognitionYear "1994"^^xsd:gYear ;
    vh:sourcePageId 482938 ;
    vh:sourceTitle "Chùa Nga My"^^xsd:string ;
    dcterms:description "Chùa Hoàng Mai (tên chữ: \"Nga My tự\") có địa chỉ tại số 8 đường Hoàng Mai, phường Tương Mai, Hà Nội (Xưa thuộc làng Hoàng Mai của vùng đất Kẻ Mơ), nhưng tọa lạc ở trong ngõ 160 và ngõ 94 đường Hoàng Mai, phường Tương Mai, Hà Nội. Theo bia đá trong chùa thì chùa được sửa chữa lớn vào năm Hồng Đức 28 (1497), gồm có tiền đường, nhà thiêu hương và thượng điện. Ngoài ra tấm bia còn cho biết ngôi chùa được xây dựng ngay sau khi vua Lý Công Uẩn dời đô từ Hoa Lư ra Thăng Long."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/dinh-hoang-mai-chua-nga-my-thanh-pho-ha-noi-22276>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_Nga_My> ;
    dcterms:subject "national_monuments" ;
    rdfs:comment "Chùa Hoàng Mai (tên chữ: \"Nga My tự\") có địa chỉ tại số 8 đường Hoàng Mai, phường Tương Mai, Hà Nội (Xưa thuộc làng Hoàng Mai của vùng đất Kẻ Mơ), nhưng tọa lạc ở trong ngõ 160 và ngõ 94 đường Hoàng Mai, phường Tương Mai, Hà Nội. Theo bia đá trong chùa thì chùa được sửa chữa lớn vào năm Hồng Đức 28 (1497), gồm có tiền đường, nhà thiêu hương và thượng điện. Ngoài ra tấm bia còn cho biết ngôi chùa được xây dựng ngay sau khi vua Lý Công Uẩn dời đô từ Hoa Lư ra Thăng Long."@vi ;
    skos:altLabel "Đình Hoàng Mai, chùa Nga My"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/dinh-hoang-mai-chua-nga-my-thanh-pho-ha-noi-22276>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_Nga_My> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-07620c963e29 a vh:HeritageSite ;
    rdfs:label "Khu đền tháp Mỹ Sơn"@vi ;
    vh:address "Tỉnh Quảng Nam"^^xsd:string ;
    vh:locatedIn vhr:area-name-352c0cff9935 ;
    vh:recognitionYear "2009"^^xsd:gYear ;
    vh:sourcePageId 4478 ;
    vh:sourceTitle "Thánh địa Mỹ Sơn"^^xsd:string ;
    dcterms:description """Thánh địa Mỹ Sơn thuộc xã Thu Bồn, thành phố Đà Nẵng, cách trung tâm thành phố khoảng 40 km (đường bộ) và gần thành cổ Trà Kiệu, bao gồm nhiều đền đài Chăm Pa, trong một thung lũng đường kính khoảng 2 km, bao quanh bởi đồi núi. Đây từng là nơi tổ chức cúng tế của vương triều Chăm Pa. Thánh địa Mỹ Sơn được coi là một trong những trung tâm đền đài chính của Ấn Độ giáo ở khu vực Đông Nam Á và là di sản duy nhất của thể loại này tại Việt Nam.\r
Thông thường người ta hay so sánh Thánh địa này với các tổ hợp đền đài chính khác ở Đông Nam Á như Borobudur (Java, Indonesia), Pagan (Myanmar), Wat Phou (Lào), Angkor Wat (Campuchia) và Prasat Hin Phimai (Thái Lan). Từ năm 1999, Thánh địa Mỹ Sơn đã được UNESCO chọn là một trong các di sản thế giới tân thời và hiện đại tại phiên họp thứ 23 của Ủy ban di sản thế giới theo tiêu chuẩn C (III) như là một ví dụ điển hình về trao đổi văn hoá và theo tiêu chuẩn C (III) như là bằng chứng duy nhất của nền văn minh châu Á đã biến mất. Hiện nay, nơi đây đã được thủ tướng chính phủ Việt Nam đưa vào danh sách xếp hạng 23 di tích quốc gia đặc biệt quan trọng.\r
\r
"""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Th%C3%A1nh_%C4%91%E1%BB%8Ba_M%E1%BB%B9_S%C6%A1n> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Thánh địa Mỹ Sơn thuộc xã Thu Bồn, thành phố Đà Nẵng, cách trung tâm thành phố khoảng 40 km (đường bộ) và gần thành cổ Trà Kiệu, bao gồm nhiều đền đài Chăm Pa, trong một thung lũng đường kính khoảng 2 km, bao quanh bởi đồi núi. Đây từng là nơi tổ chức cúng tế của vương triều Chăm Pa. Thánh địa Mỹ Sơn được coi là một trong những trung tâm đền đài chính của Ấn Độ giáo ở khu vực Đông Nam Á và là di sản duy nhất của thể loại này tại Việt Nam.\r
Thông thường người ta hay so sánh Thánh địa này với các tổ hợp đền đài chính khác ở Đông Nam Á như Borobudur (Java, Indonesia), Pagan (Myanmar), Wat Phou (Lào), Angkor Wat (Campuchia) và Prasat Hin Phimai (Thái Lan). Từ năm 1999, Thánh địa Mỹ Sơn đã được UNESCO chọn là một trong các di sản thế giới tân thời và hiện đại tại phiên họp thứ 23 của Ủy ban di sản thế giới theo tiêu chuẩn C (III) như là một ví dụ điển hình về trao đổi văn hoá và theo tiêu chuẩn C (III) như là bằng chứng duy nhất của nền văn minh châu Á đã biến mất. Hiện nay, nơi đây đã được thủ tướng chính phủ Việt Nam đưa vào danh sách xếp hạng 23 di tích quốc gia đặc biệt quan trọng.\r
\r
"""@vi ;
    geo1:lat 15.76666667 ;
    geo1:long 108.11666667 ;
    skos:altLabel "Khu di tích Chăm Mỹ Sơn"@vi,
        "Thánh địa Mỹ Sơn"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Th%C3%A1nh_%C4%91%E1%BB%8Ba_M%E1%BB%B9_S%C6%A1n> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

