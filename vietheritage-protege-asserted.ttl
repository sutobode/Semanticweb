vhr:registry-ea51124b7ac0 a vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKTNT Chùa Bút Tháp"@vi ;
    vh:address "Tỉnh Bắc Ninh"^^xsd:string ;
    vh:locatedIn vhr:area-name-34bf35f4ea37 ;
    vh:recognitionYear "2013"^^xsd:gYear ;
    vh:sourcePageId 23787 ;
    vh:sourceTitle "Chùa Bút Tháp"^^xsd:string ;
    dcterms:description """Chùa Bút Tháp (Ninh Phúc tự 寧福寺) nằm ở bên đê hữu ngạn sông Đuống, khu Bút Tháp, phường Trí Quả, thành phố Bắc Ninh. Ngoài ra, nhân dân trong vùng còn gọi là chùa Nhạn Tháp, chùa Thấp. Tên cũ của chùa trước đây gồm có: Thiếu Lâm Tự, Hoàng Cung Tự.\r
Trong chùa có tượng Quan Âm thiên thủ thiên nhãn bằng gỗ lớn nhất Việt Nam. Đây cũng là một di tích quốc gia đặc biệt của Việt Nam được xếp hạng đợt 4."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-chua-but-thap-huyen-thuan-thanh-tinh-bac-ninh-2980>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_B%C3%BAt_Th%C3%A1p> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Chùa Bút Tháp (Ninh Phúc tự 寧福寺) nằm ở bên đê hữu ngạn sông Đuống, khu Bút Tháp, phường Trí Quả, thành phố Bắc Ninh. Ngoài ra, nhân dân trong vùng còn gọi là chùa Nhạn Tháp, chùa Thấp. Tên cũ của chùa trước đây gồm có: Thiếu Lâm Tự, Hoàng Cung Tự.\r
Trong chùa có tượng Quan Âm thiên thủ thiên nhãn bằng gỗ lớn nhất Việt Nam. Đây cũng là một di tích quốc gia đặc biệt của Việt Nam được xếp hạng đợt 4."""@vi ;
    geo1:lat 21.06083 ;
    geo1:long 106.0222 ;
    skos:altLabel "Chùa Bút Tháp"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-chua-but-thap-huyen-thuan-thanh-tinh-bac-ninh-2980>,
