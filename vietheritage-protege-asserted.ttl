@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo1: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vh: <http://localhost:3030/vietheritage/ontology/> .
@prefix vhr: <http://localhost:3030/vietheritage/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vh: a owl:Ontology ;
    dcterms:created "2026-09-12"^^xsd:date ;
    dcterms:creator "VietHeritageLOD Team" ;
    dcterms:description "Ontology cho Knowledge Graph di sản văn hóa Việt Nam"@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-22"^^xsd:date ;
    dcterms:title "VietHeritageLOD Ontology"@en,
        "Ontology VietHeritageLOD"@vi ;
    owl:versionInfo "1.6.2" .

vh:Artisan a owl:Class ;
    rdfs:label "Artisan"@en,
        "Nghệ nhân"@vi ;
    rdfs:comment "Người thuộc danh sách nghệ nhân chính thức."@vi ;
    rdfs:subClassOf owl:Thing,
        foaf:Person ;
    owl:disjointWith vh:AdministrativeArea,
        vh:HeritageSite .

vh:ReligiousSite a owl:Class ;
    rdfs:label "Religious site"@en,
        "Di tích tôn giáo"@vi ;
    rdfs:comment "Site có chức năng/giá trị tôn giáo."@vi ;
    rdfs:subClassOf vh:HeritageSite .

vh:UNESCOHeritageSite a owl:Class ;
    rdfs:label "UNESCO heritage site"@en,
        "Di sản UNESCO"@vi ;
    rdfs:comment "Site được UNESCO công nhận."@vi ;
    rdfs:subClassOf vh:HeritageSite ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vh:HeritageSite [ a owl:Restriction ;
                        owl:hasValue vhr:organization-unesco ;
                        owl:onProperty vh:recognizedBy ] ) ] .

vh:address a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "address"@en,
        "địa chỉ"@vi ;
    rdfs:domain vh:CulturalHeritageEntity ;
    rdfs:range xsd:string .

vh:alternativeName a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "alternative name"@en,
        "tên thay thế"@vi ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

vh:areaLevel a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "area level"@en,
        "cấp hành chính"@vi ;
    rdfs:domain vh:AdministrativeArea ;
    rdfs:range xsd:string .

vh:associatedWithEvent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "associated with event"@en,
        "liên quan tới sự kiện"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range vh:HistoricalEvent .

vh:belongsToPeriod a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "belongs to period"@en,
        "thuộc thời kỳ"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range vh:HistoricalPeriod .

vh:birthYear a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "birth year"@en,
        "năm sinh"@vi ;
    rdfs:domain vh:HistoricalPerson ;
    rdfs:range xsd:gYear .

vh:builtBy a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "built by"@en,
        "được xây dựng bởi"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range vh:HistoricalPerson ;
    rdfs:subPropertyOf vh:associatedWithPerson .

vh:constructionYear a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "construction year"@en,
        "năm xây dựng"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range xsd:gYear .

vh:deathYear a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "death year"@en,
        "năm mất"@vi ;
    rdfs:domain vh:HistoricalPerson ;
    rdfs:range xsd:gYear .

vh:hasArchitecturalStyle a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has architectural style"@en,
        "có phong cách kiến trúc"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range vh:ArchitecturalStyle .

vh:hasHistoricalSuccessor a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has historical successor"@en,
        "có sự kiện kế tiếp"@vi ;
    rdfs:domain vh:HistoricalEvent ;
    rdfs:range vh:HistoricalEvent .

vh:hasMember a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has member"@en,
        "có thành viên"@vi ;
    rdfs:domain vh:HeritageComplex ;
    rdfs:range vh:CulturalHeritageEntity ;
    rdfs:subPropertyOf vh:hasPart .

vh:hasRelatedSite a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related site"@en,
        "có liên quan tới di sản"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range vh:HeritageSite .

vh:locatedIn a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "located in"@en,
        "nằm tại"@vi ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( vh:CulturalHeritageEntity vh:AdministrativeArea ) ] ;
    rdfs:range vh:AdministrativeArea .

vh:recognitionYear a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "recognition year"@en,
        "năm công nhận"@vi ;
    rdfs:domain vh:HeritageSite ;
    rdfs:range xsd:gYear .

vh:shortDescription a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "short description"@en,
        "mô tả ngắn"@vi ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

vh:sourcePageId a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "source page id"@en,
        "page ID nguồn"@vi ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf dcterms:identifier .

vh:sourceTitle a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "source title"@en,
        "tiêu đề nguồn"@vi ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title .

vhr:registry-006e43c89987 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Nghi lễ Then của người Tày, người Nùng"@vi ;
    vh:address "Tỉnh Bắc Giang"^^xsd:string ;
    vh:locatedIn vhr:area-name-34bf35f4ea37 ;
    vh:sourcePageId 2222332 ;
    vh:sourceTitle "Nghi lễ Then"^^xsd:string ;
    dcterms:description """Nghi lễ Then là hình thức văn hóa của cộng đồng các dân tộc Tày, Nùng, Thái, Giáy ở miền núi phía Bắc Việt Nam.\r
Then có nhiều nghi lễ, nghi thức như: Then cầu an giải hạn, thường tổ chức vào dịp đầu năm; Then nàng hang, diễn ra vào dịp Trung thu; Then cúng mụ, diễn ra vào dịp cúng đầy tháng; Then thôi tang; lẩu Then, đây là những nghi lễ lớn nhất của nhà Then và trong đó nghi lễ Then cấp cao nhất chính là Then "cấp sắc". Đặc điểm của Then là tính nghệ thuật gắn liền với yếu tố tâm linh. Việc thực hành nghi lễ then thường được gọi là "làm then", phần nghi lễ có yếu tố âm nhạc được gọi là "hát then".\r
Theo quan niệm của các dân tộc Thái, Tày, Nùng..., nghi lễ Then còn là nghi thức tâm linh của con người kết nối với đấng tối cao của mình là Trời. Nghi lễ này chủ yếu được lưu truyền qua các thế hệ bằng hình thức khẩu truyền. Thầy Then là người sáng tạo cả về lời ca và giai điệu, nghi lễ Then cũng hoàn toàn mang tính xã hội khi gắn liền với nhiều nghi thức cúng cầu gắn liền suốt cuộc đời con người.\r
Các thầy Then đóng vai trò chính yếu trong việc chuyển giao các kỹ năng và bí quyết liên quan, một số thầy Then thực hiện khoảng 200 nghi lễ Then một năm.\r
Nghi lễ then tại nhiều địa phương đã được ghi danh là di sản văn hóa phi vật thể của Việt Nam.\r
Nghi lễ Then của người Tày tại Lào Cai, Quảng Ninh và Tuyên Quang được ghi danh di sản của Việt Nam từ năm 2012, \r
đến năm 2014 là Nghi lễ Then của người Tày tại Cao Bằng, \r
năm 2015 là Nghi lễ Then của người Tày tại Hà Giang, \r
Nghi lễ Then của người Tày, người Nùng tại Bắc Giang và tại Lạng Sơn, Nghi lễ Then của người Tày huyện Định Hóa, Thái Nguyên\r
\r
Lễ Kin pang then của người Thái trắng tại thị xã Mường Lay, tỉnh Điện Biên được ghi danh năm 2015 và tại các huyện Quỳnh Nhai, Mai Sơn, tỉnh Sơn La được ghi danh năm 2020.\r
Nghi lễ Then Khoăn (Cầu thọ) của người Tày ở Văn Bàn, Lào Cai được ghi danh năm 2020.\r
Ngoài 3 dân tộc nêu trên, một số dân tộc cũng thực hành nghi lễ then, ví dụ nghi lễ của người Giáy tại huyện Bát Xát, Lào Cai đã được ghi danh năm 2019.\r
Lúc 15h23 ngày 12/12/2019 giờ địa phương (tức 3h23 ngày 13/12/2019 giờ Việt Nam), tại Phiên họp Ủy ban Liên Chính phủ Công ước 2003 về bảo vệ di sản văn hóa phi vật thể lần thứ 14 của Tổ chức Giáo dục, Khoa học và Văn hóa Liên hợp quốc (UNESCO) diễn ra tại Bogotá, Colombia, di sản Thực hành Then của người Tày, Nùng, Thái ở Việt Nam chính thức được UNESCO ghi danh vào Danh sách Di sản Văn hóa phi vật thể đại diện của nhân loại."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Nghi_l%E1%BB%85_Then> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Nghi lễ Then là hình thức văn hóa của cộng đồng các dân tộc Tày, Nùng, Thái, Giáy ở miền núi phía Bắc Việt Nam.\r
Then có nhiều nghi lễ, nghi thức như: Then cầu an giải hạn, thường tổ chức vào dịp đầu năm; Then nàng hang, diễn ra vào dịp Trung thu; Then cúng mụ, diễn ra vào dịp cúng đầy tháng; Then thôi tang; lẩu Then, đây là những nghi lễ lớn nhất của nhà Then và trong đó nghi lễ Then cấp cao nhất chính là Then "cấp sắc". Đặc điểm của Then là tính nghệ thuật gắn liền với yếu tố tâm linh. Việc thực hành nghi lễ then thường được gọi là "làm then", phần nghi lễ có yếu tố âm nhạc được gọi là "hát then".\r
Theo quan niệm của các dân tộc Thái, Tày, Nùng..., nghi lễ Then còn là nghi thức tâm linh của con người kết nối với đấng tối cao của mình là Trời. Nghi lễ này chủ yếu được lưu truyền qua các thế hệ bằng hình thức khẩu truyền. Thầy Then là người sáng tạo cả về lời ca và giai điệu, nghi lễ Then cũng hoàn toàn mang tính xã hội khi gắn liền với nhiều nghi thức cúng cầu gắn liền suốt cuộc đời con người.\r
Các thầy Then đóng vai trò chính yếu trong việc chuyển giao các kỹ năng và bí quyết liên quan, một số thầy Then thực hiện khoảng 200 nghi lễ Then một năm.\r
Nghi lễ then tại nhiều địa phương đã được ghi danh là di sản văn hóa phi vật thể của Việt Nam.\r
Nghi lễ Then của người Tày tại Lào Cai, Quảng Ninh và Tuyên Quang được ghi danh di sản của Việt Nam từ năm 2012, \r
đến năm 2014 là Nghi lễ Then của người Tày tại Cao Bằng, \r
năm 2015 là Nghi lễ Then của người Tày tại Hà Giang, \r
Nghi lễ Then của người Tày, người Nùng tại Bắc Giang và tại Lạng Sơn, Nghi lễ Then của người Tày huyện Định Hóa, Thái Nguyên\r
\r
Lễ Kin pang then của người Thái trắng tại thị xã Mường Lay, tỉnh Điện Biên được ghi danh năm 2015 và tại các huyện Quỳnh Nhai, Mai Sơn, tỉnh Sơn La được ghi danh năm 2020.\r
Nghi lễ Then Khoăn (Cầu thọ) của người Tày ở Văn Bàn, Lào Cai được ghi danh năm 2020.\r
Ngoài 3 dân tộc nêu trên, một số dân tộc cũng thực hành nghi lễ then, ví dụ nghi lễ của người Giáy tại huyện Bát Xát, Lào Cai đã được ghi danh năm 2019.\r
Lúc 15h23 ngày 12/12/2019 giờ địa phương (tức 3h23 ngày 13/12/2019 giờ Việt Nam), tại Phiên họp Ủy ban Liên Chính phủ Công ước 2003 về bảo vệ di sản văn hóa phi vật thể lần thứ 14 của Tổ chức Giáo dục, Khoa học và Văn hóa Liên hợp quốc (UNESCO) diễn ra tại Bogotá, Colombia, di sản Thực hành Then của người Tày, Nùng, Thái ở Việt Nam chính thức được UNESCO ghi danh vào Danh sách Di sản Văn hóa phi vật thể đại diện của nhân loại."""@vi ;
    skos:altLabel "Nghi lễ Then"@vi,
        "Nghi lễ Then của người Giáy"@vi,
        "Nghi lễ Then của người Tày"@vi,
        "Thực hành Then của người Tày, Nùng, Thái"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Nghi_l%E1%BB%85_Then> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-00a0f7887fe0 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Chữ Nôm của người Dao"@vi ;
    vh:address "Tỉnh Bắc Kạn"^^xsd:string ;
    vh:locatedIn vhr:area-name-8872895663b7 ;
    vh:sourcePageId 14440663 ;
    vh:sourceTitle "Chữ Nôm Dao"^^xsd:string ;
    dcterms:description """Chữ Nôm Dao là chữ viết của người Dao, dựa trên chữ Hán và đã được Dao hóa. Chữ Nôm Dao cũng được viết tại Quế Bình, Vân Nam, Long Thắng, Lăng Vân (Bách Sắc, Quảng Tây),huyện Tân Ninh (Thiệu Dương, Hồ Nam) ở Trung Quốc.\r
Chữ Nôm Dao (tại các tỉnh Lào Cai, Thái Nguyên) là di sản văn hóa phi vật thể cấp quốc gia của Việt Nam."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Ch%E1%BB%AF_N%C3%B4m_Dao> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Chữ Nôm Dao là chữ viết của người Dao, dựa trên chữ Hán và đã được Dao hóa. Chữ Nôm Dao cũng được viết tại Quế Bình, Vân Nam, Long Thắng, Lăng Vân (Bách Sắc, Quảng Tây),huyện Tân Ninh (Thiệu Dương, Hồ Nam) ở Trung Quốc.\r
Chữ Nôm Dao (tại các tỉnh Lào Cai, Thái Nguyên) là di sản văn hóa phi vật thể cấp quốc gia của Việt Nam."""@vi ;
    skos:altLabel "Chữ Nôm Dao"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Ch%E1%BB%AF_N%C3%B4m_Dao> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-00bac751086a a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Lễ hội Làng Thượng Liệt"@vi ;
    vh:address "Tỉnh Thái Bình"^^xsd:string ;
