vhr:registry-ac781f8e46c5 a vh:ArchaeologicalSite,
        vh:ArchitecturalSite,
        vh:HeritageSite ;
    rdfs:label "DTKTNT và KC Tháp Pô Klong Garai"@vi ;
    vh:address "Tỉnh Ninh Thuận"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q16481478 ;
    vh:locatedIn vhr:area-name-8128e9d1ccb4 ;
    vh:recognitionYear "2016"^^xsd:gYear ;
    vh:sourcePageId 67149 ;
    vh:sourceTitle "Tháp Po Klong Garai"^^xsd:string ;
    dcterms:description """Tháp Po Klong Garai là tên gọi chung cho một cụm tháp Chăm hùng vĩ và đẹp nhất còn lại ở Việt Nam, phụng thờ vua Po Klong Garai. Tháp Pô Klong Garai là một tổng thể gồm ba tháp: tháp chính (cao 20,5m), tháp lửa (cao 9,31m), tháp cổng (cao 8,56m). Công trình này có trình độ kiến trúc, nghệ thuật, điêu khắc đạt đến đỉnh cao. Di tích kiến trúc nghệ thuật này được Bộ Văn hóa xếp hạng di tích di tích quốc gia năm 1979 và được Thủ tướng Chính phủ xếp hạng di tích quốc gia đặc biệt.\r
Tháp Poklong Garai nằm trên đồi Trầu, thuộc phường Đô Vinh, tỉnh Khánh Hòa, được xây dựng vào cuối thế kỷ 13 đầu thế kỷ 14 (thời vua Shihavaman, người Việt gọi là Chế Mân) để thờ vua Po Klong Garai (1151-1205), vị vua đã có nhiều công lớn trong việc cai trị đất nước.\r
Chiều ngày 18 tháng 1 năm 2024, Phó Thủ tướng Chính Phủ Trần Hồng Hà đã ký quyết định (đợt thứ 12) công nhận 29 hiện vật, nhóm hiện vật là Bảo vật Quốc gia. Trong đó, tỉnh Ninh Thuận (nay là Khánh Hòa) có thêm 2 bảo vật là bia Phước Thiện và tượng thờ Vua Pô Klong Garai đặt trong tháp Po Klong Garai."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-thap-po-klong-garai-2995>,
        <https://vi.wikipedia.org/wiki/Th%C3%A1p_Po_Klong_Garai> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Tháp Po Klong Garai là tên gọi chung cho một cụm tháp Chăm hùng vĩ và đẹp nhất còn lại ở Việt Nam, phụng thờ vua Po Klong Garai. Tháp Pô Klong Garai là một tổng thể gồm ba tháp: tháp chính (cao 20,5m), tháp lửa (cao 9,31m), tháp cổng (cao 8,56m). Công trình này có trình độ kiến trúc, nghệ thuật, điêu khắc đạt đến đỉnh cao. Di tích kiến trúc nghệ thuật này được Bộ Văn hóa xếp hạng di tích di tích quốc gia năm 1979 và được Thủ tướng Chính phủ xếp hạng di tích quốc gia đặc biệt.\r
Tháp Poklong Garai nằm trên đồi Trầu, thuộc phường Đô Vinh, tỉnh Khánh Hòa, được xây dựng vào cuối thế kỷ 13 đầu thế kỷ 14 (thời vua Shihavaman, người Việt gọi là Chế Mân) để thờ vua Po Klong Garai (1151-1205), vị vua đã có nhiều công lớn trong việc cai trị đất nước.\r
Chiều ngày 18 tháng 1 năm 2024, Phó Thủ tướng Chính Phủ Trần Hồng Hà đã ký quyết định (đợt thứ 12) công nhận 29 hiện vật, nhóm hiện vật là Bảo vật Quốc gia. Trong đó, tỉnh Ninh Thuận (nay là Khánh Hòa) có thêm 2 bảo vật là bia Phước Thiện và tượng thờ Vua Pô Klong Garai đặt trong tháp Po Klong Garai."""@vi ;
    geo1:lat 11.601831 ;
    geo1:long 108.9442935 ;
    skos:altLabel "Tháp Po Klong Garai"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-kien-truc-nghe-thuat-thap-po-klong-garai-2995>,
        <https://vi.wikipedia.org/wiki/Th%C3%A1p_Po_Klong_Garai> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

