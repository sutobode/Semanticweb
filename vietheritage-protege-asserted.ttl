vhr:registry-49e23450854b a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Địa đạo Vịnh Mốc và hệ thống làng hầm Vĩnh Linh"@vi ;
    vh:address "Tỉnh Quảng Trị"^^xsd:string ;
    vh:locatedIn vhr:area-name-441134c12a3e ;
    vh:recognitionYear "2014"^^xsd:gYear ;
    vh:sourcePageId 36222 ;
    vh:sourceTitle "Địa đạo Vịnh Mốc"^^xsd:string ;
    dcterms:description """Địa đạo Vịnh Mốc (thôn Vịnh Mốc, xã Cửa Tùng, tỉnh Quảng Trị) là một công trình quân - dân sự trong Chiến tranh Việt Nam của phía Việt Nam Dân chủ Cộng hòa nhằm chống lại các cuộc tấn công của phía Việt Nam Cộng hòa và Hợp chúng quốc Hoa Kỳ. Hệ thống địa đạo tồn tại ở phía Bắc sông Bến Hải, cầu Hiền Lương trong suốt những năm 1965-1972.\r
\r
"""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-dia-dao-vinh-moc-va-he-thong-lang-ham-vinh-linh-2989>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%8Ba_%C4%91%E1%BA%A1o_V%E1%BB%8Bnh_M%E1%BB%91c> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Địa đạo Vịnh Mốc (thôn Vịnh Mốc, xã Cửa Tùng, tỉnh Quảng Trị) là một công trình quân - dân sự trong Chiến tranh Việt Nam của phía Việt Nam Dân chủ Cộng hòa nhằm chống lại các cuộc tấn công của phía Việt Nam Cộng hòa và Hợp chúng quốc Hoa Kỳ. Hệ thống địa đạo tồn tại ở phía Bắc sông Bến Hải, cầu Hiền Lương trong suốt những năm 1965-1972.\r
\r
"""@vi ;
    geo1:lat 17.073 ;
    geo1:long 107.111 ;
    skos:altLabel "Địa đạo Vịnh Mốc"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-dia-dao-vinh-moc-va-he-thong-lang-ham-vinh-linh-2989>,
