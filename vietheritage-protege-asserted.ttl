vhr:registry-58ccef360294 a vh:IntangibleHeritage,
        vh:RepresentativeIntangibleHeritage ;
    rdfs:label "Dân ca Ví, Giặm Nghệ Tĩnh"@vi ;
    vh:address "Tỉnh Nghệ An Tỉnh Hà Tĩnh"^^xsd:string ;
    vh:locatedIn vhr:area-name-b93dd0ed3491,
        vhr:area-name-d76be4e8346d ;
    vh:sourcePageId 280214 ;
    vh:sourceTitle "Dân ca ví, giặm Nghệ Tĩnh"^^xsd:string ;
    dcterms:description "Dân ca ví, giặm Nghệ - Tĩnh là một loại hình nghệ thuật trình diễn dân ca chiếm vị trí quan trọng trong đời sống văn hóa của người dân 2 tỉnh Nghệ An và Hà Tĩnh thuộc miền Trung Việt Nam. Dân ca ví giặm (cũng viết là giặm) tại Nghệ - Tĩnh là một di sản văn hóa phi vật thể cấp quốc gia đã được ghi danh là di sản văn hóa phi vật thể đại diện cho nhân loại tại kỳ họp thứ 9 của Ủy ban Liên Chính phủ Công ước UNESCO về bảo vệ di sản văn hóa phi vật thể ngày 27/11/2014 tại Paris (Pháp) Loại hình nghệ thuật này phổ biến trong đời sống của các cộng đồng xứ Nghệ, được hát trong hầu hết mọi hoạt động đời thường, từ ru con, dệt vải, trồng lúa... Lời ca của dân ca ví, giặm ca ngợi những giá trị sâu sắc và truyền thống như sự tôn trọng với các bậc cha mẹ, lòng chung thủy, tận tụy vì người khác cũng như ngợi ca đức tính thật thà và cách cư xử tử tế giữa con người với con người."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-san-van-hoa-phi-vat-the-dai-dien-cua-nhan-loai-1755>,
        <https://vi.wikipedia.org/wiki/D%C3%A2n_ca_v%C3%AD,_gi%E1%BA%B7m_Ngh%E1%BB%87_T%C4%A9nh> ;
    dcterms:subject "intangible_representative" ;
    rdfs:comment "Dân ca ví, giặm Nghệ - Tĩnh là một loại hình nghệ thuật trình diễn dân ca chiếm vị trí quan trọng trong đời sống văn hóa của người dân 2 tỉnh Nghệ An và Hà Tĩnh thuộc miền Trung Việt Nam. Dân ca ví giặm (cũng viết là giặm) tại Nghệ - Tĩnh là một di sản văn hóa phi vật thể cấp quốc gia đã được ghi danh là di sản văn hóa phi vật thể đại diện cho nhân loại tại kỳ họp thứ 9 của Ủy ban Liên Chính phủ Công ước UNESCO về bảo vệ di sản văn hóa phi vật thể ngày 27/11/2014 tại Paris (Pháp) Loại hình nghệ thuật này phổ biến trong đời sống của các cộng đồng xứ Nghệ, được hát trong hầu hết mọi hoạt động đời thường, từ ru con, dệt vải, trồng lúa... Lời ca của dân ca ví, giặm ca ngợi những giá trị sâu sắc và truyền thống như sự tôn trọng với các bậc cha mẹ, lòng chung thủy, tận tụy vì người khác cũng như ngợi ca đức tính thật thà và cách cư xử tử tế giữa con người với con người."@vi ;
    skos:altLabel "Dân ca Ví, Giặm xứ Nghệ"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-san-van-hoa-phi-vat-the-dai-dien-cua-nhan-loai-1755>,
        <https://vi.wikipedia.org/wiki/D%C3%A2n_ca_v%C3%AD,_gi%E1%BA%B7m_Ngh%E1%BB%87_T%C4%A9nh> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-5941413e7349 a vh:ArchitecturalSite,
        vh:HeritageSite ;
