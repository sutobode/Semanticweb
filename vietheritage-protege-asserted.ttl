vhr:registry-522fa9481918 a vh:ArchaeologicalSite,
        vh:HeritageSite ;
    rdfs:label "DTKC Hang con Moong và các di tích phụ cận"@vi ;
    vh:address "Tỉnh Thanh Hóa"^^xsd:string ;
    vh:locatedIn vhr:area-name-2035d470f202 ;
    vh:recognitionYear "2015"^^xsd:gYear ;
    vh:sourcePageId 41571 ;
    vh:sourceTitle "Hang Con Moong"^^xsd:string ;
    dcterms:description "Hang Con Moong (theo tiếng địa phương có nghĩa là \"hang con thú\") là một hang đá trong Vườn quốc gia Cúc Phương. Tuy Vườn quốc gia Cúc Phương phần lớn thuộc tỉnh Ninh Bình nhưng hang Con Moong lại thuộc xã Thành Vinh, tỉnh Thanh Hóa. Ngày 23/11/2016, hang Con Moong và các di tích phụ cận đã được công nhận là Di tích quốc gia đặc biệt."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-khao-co-hang-con-moong-va-cac-di-tich-phu-can-1284>,
        <https://vi.wikipedia.org/wiki/Hang_Con_Moong> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Hang Con Moong (theo tiếng địa phương có nghĩa là \"hang con thú\") là một hang đá trong Vườn quốc gia Cúc Phương. Tuy Vườn quốc gia Cúc Phương phần lớn thuộc tỉnh Ninh Bình nhưng hang Con Moong lại thuộc xã Thành Vinh, tỉnh Thanh Hóa. Ngày 23/11/2016, hang Con Moong và các di tích phụ cận đã được công nhận là Di tích quốc gia đặc biệt."@vi ;
    geo1:lat 20.2875 ;
    geo1:long 105.605 ;
    skos:altLabel "Hang Con Moong"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-khao-co-hang-con-moong-va-cac-di-tich-phu-can-1284>,
        <https://vi.wikipedia.org/wiki/Hang_Con_Moong> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

