    vh:recognitionYear "2016"^^xsd:gYear ;
    vh:sourcePageId 19784811 ;
    vh:sourceTitle "Lăng Nguyễn Đình Chiểu"^^xsd:string ;
    dcterms:description "Lăng Nguyễn Đình Chiểu là nơi an táng và thờ nhà thơ Nguyễn Đình Chiểu, cùng với vợ ông là bà Lê Thị Điền và con gái là nữ sĩ Sương Nguyệt Anh. Khu di tích hiện thuộc ấp 3, xã Ba Tri, tỉnh Vĩnh Long, được Thủ tướng Chính phủ Việt Nam xếp hạng di tích quốc gia đặc biệt vào cuối năm 2016."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-mo-va-khu-tuong-niem-nguyen-dinh-chieu-2999>,
        <https://vi.wikipedia.org/wiki/L%C4%83ng_Nguy%E1%BB%85n_%C4%90%C3%ACnh_Chi%E1%BB%83u> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Lăng Nguyễn Đình Chiểu là nơi an táng và thờ nhà thơ Nguyễn Đình Chiểu, cùng với vợ ông là bà Lê Thị Điền và con gái là nữ sĩ Sương Nguyệt Anh. Khu di tích hiện thuộc ấp 3, xã Ba Tri, tỉnh Vĩnh Long, được Thủ tướng Chính phủ Việt Nam xếp hạng di tích quốc gia đặc biệt vào cuối năm 2016."@vi ;
    skos:altLabel "Lăng Nguyễn Đình Chiểu"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-mo-va-khu-tuong-niem-nguyen-dinh-chieu-2999>,
