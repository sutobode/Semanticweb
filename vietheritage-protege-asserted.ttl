vhr:registry-b70dc5c6502d a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Đền Phù Đổng"@vi ;
    vh:address "Thành phố Hà Nội"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q7799843 ;
    vh:builtBy vhr:person-wikidata-q716945 ;
    vh:locatedIn vhr:area-name-8de4ed043a59 ;
    vh:recognitionYear "2013"^^xsd:gYear ;
    vh:sourcePageId 255474 ;
    vh:sourceTitle "Đền Phù Đổng"^^xsd:string ;
    dcterms:description """Đền Phù Đổng hay còn gọi là đền Gióng thờ Thánh Gióng – Phù Đổng Thiên Vương, nằm ở xã Phù Đổng, ngoại thành Hà Nội.\r
Đền Phù Đổng còn được gọi là đền Thượng, tương truyền được dựng trên nền nhà cũ của Thánh Gióng, bên trong đê sông Đuống, còn đền Hạ (đền mẫu) thờ mẹ của Thánh Gióng nằm ngoài đê, gần nơi được cho là có dấu chân khổng lồ mà bà đã ướm thử rồi sinh ra Thánh Gióng. Năm 1010 khi dời đô về Thăng Long, Lý Thái Tổ đã cho dựng đền, đến nay đã được trùng tu nhiều lần."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-den-phu-dong-huyen-gia-lam-thanh-pho-ha-noi-2977>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Ph%C3%B9_%C4%90%E1%BB%95ng> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đền Phù Đổng hay còn gọi là đền Gióng thờ Thánh Gióng – Phù Đổng Thiên Vương, nằm ở xã Phù Đổng, ngoại thành Hà Nội.\r
Đền Phù Đổng còn được gọi là đền Thượng, tương truyền được dựng trên nền nhà cũ của Thánh Gióng, bên trong đê sông Đuống, còn đền Hạ (đền mẫu) thờ mẹ của Thánh Gióng nằm ngoài đê, gần nơi được cho là có dấu chân khổng lồ mà bà đã ướm thử rồi sinh ra Thánh Gióng. Năm 1010 khi dời đô về Thăng Long, Lý Thái Tổ đã cho dựng đền, đến nay đã được trùng tu nhiều lần."""@vi ;
    geo1:lat 21.055 ;
    geo1:long 105.96 ;
    skos:altLabel "Đền Phù Đổng"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-va-kien-truc-nghe-thuat-den-phu-dong-huyen-gia-lam-thanh-pho-ha-noi-2977>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Ph%C3%B9_%C4%90%E1%BB%95ng> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

