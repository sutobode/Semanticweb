vhr:registry-99229e377814 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Kéo co"@vi ;
    vh:address "Xã Hòa Long, thành phố Bắc Ninh, tỉnh Bắc Ninh"^^xsd:string ;
    vh:locatedIn vhr:area-name-34bf35f4ea37 ;
    vh:sourcePageId 1180413 ;
    vh:sourceTitle "Kéo co"^^xsd:string ;
    dcterms:description "Kéo co hay kéo dây là một môn thể thao và là một trò chơi dân gian thông dụng và đơn giản trên thế giới hiện nay. Kéo co là môn thể thao mang tính đồng đội và thiên về sức mạnh. Kéo co không chỉ là môn thể thao rèn luyện sức khỏe, mà còn là trò chơi thể hiện tinh thần và mang tính đồng đội cao, đem lại niềm vui, sự thoải mái cho mọi người khi tham gia những trò chơi trong các dịp lễ hội. Ở Việt Nam, kéo co là một trò chơi dân gian truyền thống. Trong các hội hè dã ngoại, trò chơi này luôn hấp dẫn nhiều người tham gia. Vào các dịp lễ tết, kéo co lại là một phần quan trọng trong các lễ hội cổ truyền. Hiện nay, nghi lễ và trò chơi Kéo co ở Campuchia, Philippines, Hàn Quốc và Việt Nam đã được UNESCO ghi danh là Di sản văn hóa phi vật thể đa quốc gia đại diện của nhân loại."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/K%C3%A9o_co> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment "Kéo co hay kéo dây là một môn thể thao và là một trò chơi dân gian thông dụng và đơn giản trên thế giới hiện nay. Kéo co là môn thể thao mang tính đồng đội và thiên về sức mạnh. Kéo co không chỉ là môn thể thao rèn luyện sức khỏe, mà còn là trò chơi thể hiện tinh thần và mang tính đồng đội cao, đem lại niềm vui, sự thoải mái cho mọi người khi tham gia những trò chơi trong các dịp lễ hội. Ở Việt Nam, kéo co là một trò chơi dân gian truyền thống. Trong các hội hè dã ngoại, trò chơi này luôn hấp dẫn nhiều người tham gia. Vào các dịp lễ tết, kéo co lại là một phần quan trọng trong các lễ hội cổ truyền. Hiện nay, nghi lễ và trò chơi Kéo co ở Campuchia, Philippines, Hàn Quốc và Việt Nam đã được UNESCO ghi danh là Di sản văn hóa phi vật thể đa quốc gia đại diện của nhân loại."@vi ;
    skos:altLabel "Nghi lễ và trò chơi kéo co ở Việt Nam, Campuchia, Hàn Quốc và Philippin"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/K%C3%A9o_co> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

