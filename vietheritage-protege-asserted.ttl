    vh:sourcePageId 19562172 ;
    vh:sourceTitle "Thành Điện Hải"^^xsd:string ;
    dcterms:description "Thành Điện Hải là một di tích quốc gia đặc biệt tọa lạc tại thành phố Đà Nẵng, Việt Nam. Tòa thành được xây dựng lần đầu vào năm Gia Long thứ 12 (năm 1813) với mục đích kiểm soát tàu thuyền và trấn giữ Đà Nẵng. Đến năm Minh Mạng thứ 4 (năm 1823), thành được di dời và xây dựng lại theo kiến trúc kiểu Vauban. Đây là thành lũy có vai trò vô cùng quan trọng góp phần đánh bại cuộc tấn công của thực dân Pháp vào Đà Nẵng những năm 1858–1860."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Th%C3%A0nh_%C4%90i%E1%BB%87n_H%E1%BA%A3i> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Thành Điện Hải là một di tích quốc gia đặc biệt tọa lạc tại thành phố Đà Nẵng, Việt Nam. Tòa thành được xây dựng lần đầu vào năm Gia Long thứ 12 (năm 1813) với mục đích kiểm soát tàu thuyền và trấn giữ Đà Nẵng. Đến năm Minh Mạng thứ 4 (năm 1823), thành được di dời và xây dựng lại theo kiến trúc kiểu Vauban. Đây là thành lũy có vai trò vô cùng quan trọng góp phần đánh bại cuộc tấn công của thực dân Pháp vào Đà Nẵng những năm 1858–1860."@vi ;
    skos:altLabel "Thành Điện Hải"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Th%C3%A0nh_%C4%90i%E1%BB%87n_H%E1%BA%A3i> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

