vhr:registry-2caabaa02748 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Chùa Đọi Sơn"@vi ;
    vh:address "Tỉnh Hà Nam"^^xsd:string ;
    vh:locatedIn vhr:area-name-dca800e51853 ;
    vh:recognitionYear "2017"^^xsd:gYear ;
    vh:sourcePageId 1469958 ;
    vh:sourceTitle "Chùa Long Đọi Sơn"^^xsd:string ;
    dcterms:description """Chùa Long Đọi Sơn hay Chùa Đọi Sơn là một ngôi chùa cổ từ thời Lý, đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam. Chùa Đọi Sơn còn giữ được nhiều hiện vật có giá trị đặc biệt như: Bia Sùng Thiện Diên Linh và bộ tượng Kim Cương đã được Thủ tướng Chính phủ ký Quyết định công nhận là Bảo vật quốc gia.\r
Chùa nằm trên đỉnh núi Đọi, hiện nay thuộc địa phận phường Tiên Sơn, tỉnh Ninh Bình. Chùa cách trung tâm tỉnh Ninh Bình 42 km về phía bắc, cách thủ đô Hà Nội 50 km về phía nam."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/Ch%C3%B9a_Long_%C4%90%E1%BB%8Di_S%C6%A1n> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Chùa Long Đọi Sơn hay Chùa Đọi Sơn là một ngôi chùa cổ từ thời Lý, đã được xếp hạng Di tích quốc gia đặc biệt tại Việt Nam. Chùa Đọi Sơn còn giữ được nhiều hiện vật có giá trị đặc biệt như: Bia Sùng Thiện Diên Linh và bộ tượng Kim Cương đã được Thủ tướng Chính phủ ký Quyết định công nhận là Bảo vật quốc gia.\r
Chùa nằm trên đỉnh núi Đọi, hiện nay thuộc địa phận phường Tiên Sơn, tỉnh Ninh Bình. Chùa cách trung tâm tỉnh Ninh Bình 42 km về phía bắc, cách thủ đô Hà Nội 50 km về phía nam."""@vi ;
    skos:altLabel "Chùa Long Đọi Sơn"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
