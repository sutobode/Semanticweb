vhr:registry-579e94fa60af a vh:HeritageSite ;
    rdfs:label "DLTC Vườn Quốc gia Cát Tiên"@vi ;
    vh:address "Tỉnh Bình Phước"^^xsd:string ;
    vh:constructionYear "1992"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-11e91641fb6c ;
    vh:recognitionYear "2012"^^xsd:gYear ;
    vh:sourcePageId 59313 ;
    vh:sourceTitle "Vườn quốc gia Cát Tiên"^^xsd:string ;
    dcterms:description """Vườn quốc gia Cát Tiên là một khu bảo tồn thiên nhiên, vườn quốc gia tại Việt Nam. Nó nằm trên địa bàn Thành phố Đồng Nai, cách Thành phố Hồ Chí Minh 150 km về phía bắc. Điểm đặc trưng của vườn quốc gia này là rừng đất thấp ẩm ướt nhiệt đới. được thành lập theo quyết định số 08/CT ngày 13 tháng 1 năm 1992 của Thủ tướng chính phủ Việt Nam trên cơ sở kết nối khu rừng cấm Nam Cát Tiên (được thành lập theo quyết định số 360/TTg, ngày 7 tháng 7 năm 1978 của Thủ tướng chính phủ) và khu bảo tồn thiên nhiên Tây Cát Tiên (được thành lập theo quyết định số 194/CT, ngày 9 tháng 8 năm 1986 của Chủ tịch Hội đồng Bộ trưởng). Hiện nay, VQG Cát Tiên là một trong những khu dự trữ sinh quyển thế giới ở Việt Nam.\r
VQG là "ngôi nhà" của 300 loài chim chiếm gần 50% số loài tại Việt Nam. Hơn 450 loài bướm chiếm hơn 50% số loài tại Việt Nam.\r
Nơi đây còn có trạm cứu hộ linh trưởng nguy cấp Đảo Tiên (Đảo Tiên có diện tích là 57 ha) có nhiều loài động vật quý hiếm như : vượn đen má vàng Nam, voọc bạc, chà vá chân đen, cu li chậm lùn..."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-lam-thang-canh-vuon-quoc-gia-cat-tien-2968>,
        <https://vi.wikipedia.org/wiki/V%C6%B0%E1%BB%9Dn_qu%E1%BB%91c_gia_C%C3%A1t_Ti%C3%AAn> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Vườn quốc gia Cát Tiên là một khu bảo tồn thiên nhiên, vườn quốc gia tại Việt Nam. Nó nằm trên địa bàn Thành phố Đồng Nai, cách Thành phố Hồ Chí Minh 150 km về phía bắc. Điểm đặc trưng của vườn quốc gia này là rừng đất thấp ẩm ướt nhiệt đới. được thành lập theo quyết định số 08/CT ngày 13 tháng 1 năm 1992 của Thủ tướng chính phủ Việt Nam trên cơ sở kết nối khu rừng cấm Nam Cát Tiên (được thành lập theo quyết định số 360/TTg, ngày 7 tháng 7 năm 1978 của Thủ tướng chính phủ) và khu bảo tồn thiên nhiên Tây Cát Tiên (được thành lập theo quyết định số 194/CT, ngày 9 tháng 8 năm 1986 của Chủ tịch Hội đồng Bộ trưởng). Hiện nay, VQG Cát Tiên là một trong những khu dự trữ sinh quyển thế giới ở Việt Nam.\r
VQG là "ngôi nhà" của 300 loài chim chiếm gần 50% số loài tại Việt Nam. Hơn 450 loài bướm chiếm hơn 50% số loài tại Việt Nam.\r
Nơi đây còn có trạm cứu hộ linh trưởng nguy cấp Đảo Tiên (Đảo Tiên có diện tích là 57 ha) có nhiều loài động vật quý hiếm như : vượn đen má vàng Nam, voọc bạc, chà vá chân đen, cu li chậm lùn..."""@vi ;
    skos:altLabel "Vườn quốc gia Cát Tiên"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-lam-thang-canh-vuon-quoc-gia-cat-tien-2968>,
        <https://vi.wikipedia.org/wiki/V%C6%B0%E1%BB%9Dn_qu%E1%BB%91c_gia_C%C3%A1t_Ti%C3%AAn> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

