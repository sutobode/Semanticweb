vhr:registry-8c3a4e286883 a vh:HeritageSite ;
    rdfs:label "Vịnh Hạ Long - Quần đảo Cát Bà"@vi ;
    vh:address "Tỉnh Quảng Ninh - Hải Phòng"^^xsd:string ;
    vh:locatedIn vhr:area-name-4f99714e585c,
        vhr:area-name-cff49d8e0895 ;
    vh:recognitionYear "2023"^^xsd:gYear ;
    vh:recognizedBy vhr:organization-unesco ;
    vh:sourcePageId 19829973 ;
    vh:sourceTitle "Vịnh Hạ Long – quần đảo Cát Bà"^^xsd:string ;
    dcterms:description "Vịnh Hạ Long – quần đảo Cát Bà là một trong số 8 di sản thế giới tại Việt Nam. Đây là di sản thế giới liên tỉnh đầu tiên với địa bàn thuộc hai thành phố Quảng Ninh và  Hải Phòng. Di sản thiên nhiên thế giới này được công nhận lần đầu tiên cho vịnh Hạ Long vào năm 1994 với tiêu chí nổi bật toàn cầu về cảnh quan; tới lần thứ hai vào năm 2000, di sản được bổ sung thêm theo tiêu chí địa chất và đến lần thứ 3 năm 2023 thì được mở rộng thêm sang quần đảo Cát Bà."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/vinh-ha-long-quan-dao-cat-ba-tinh-quang-ninh-va-thanh-pho-hai-phong-duoc-unesco-cong-nhan-la-di-san-thien-nhien-the-gioi-tro-thanh-di-san-the-gioi-thuoc-dia-ban-hai-tinh-thanh-pho-dau-tien-o-viet-nam-22117>,
        <https://vi.wikipedia.org/wiki/V%E1%BB%8Bnh_H%E1%BA%A1_Long_%E2%80%93_qu%E1%BA%A7n_%C4%91%E1%BA%A3o_C%C3%A1t_B%C3%A0> ;
    dcterms:subject "world_heritage" ;
    rdfs:comment "Vịnh Hạ Long – quần đảo Cát Bà là một trong số 8 di sản thế giới tại Việt Nam. Đây là di sản thế giới liên tỉnh đầu tiên với địa bàn thuộc hai thành phố Quảng Ninh và  Hải Phòng. Di sản thiên nhiên thế giới này được công nhận lần đầu tiên cho vịnh Hạ Long vào năm 1994 với tiêu chí nổi bật toàn cầu về cảnh quan; tới lần thứ hai vào năm 2000, di sản được bổ sung thêm theo tiêu chí địa chất và đến lần thứ 3 năm 2023 thì được mở rộng thêm sang quần đảo Cát Bà."@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/vinh-ha-long-quan-dao-cat-ba-tinh-quang-ninh-va-thanh-pho-hai-phong-duoc-unesco-cong-nhan-la-di-san-thien-nhien-the-gioi-tro-thanh-di-san-the-gioi-thuoc-dia-ban-hai-tinh-thanh-pho-dau-tien-o-viet-nam-22117>,
        <https://vi.wikipedia.org/wiki/V%E1%BB%8Bnh_H%E1%BA%A1_Long_%E2%80%93_qu%E1%BA%A7n_%C4%91%E1%BA%A3o_C%C3%A1t_B%C3%A0> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

