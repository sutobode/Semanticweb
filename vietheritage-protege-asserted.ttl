vhr:registry-2a6c75ce60cc a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Lễ hội Chọi trâu Đồ Sơn"@vi ;
    vh:address "Quận Đồ Sơn, Tp. Hải Phòng"^^xsd:string ;
    vh:locatedIn vhr:area-name-4f99714e585c ;
    vh:sourcePageId 274464 ;
    vh:sourceTitle "Lễ hội chọi trâu Đồ Sơn"^^xsd:string ;
    dcterms:description """Lễ hội chọi trâu Đồ Sơn là một tập tục cổ, có từ xa xưa, là một lễ hội truyền thống của người dân vạn chài tại vùng biển Đồ Sơn, Hải Phòng; diễn ra vào ngày 9 tháng 8 Âm lịch hàng năm; là di sản văn hóa phi vật thể quốc gia năm 2020 của Việt Nam. Đây là một lễ hội với lễ nghi trang trọng, rước kiệu thần, có lọng che, phường bát âm....\r
Trong văn hóa cộng đồng người dân Hải Phòng, còn lưu truyền câu ca cổ: "Dù ai buôn đâu bán đâu / Mùng chín tháng tám chọi Trâu thì về\""""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_ch%E1%BB%8Di_tr%C3%A2u_%C4%90%E1%BB%93_S%C6%A1n> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Lễ hội chọi trâu Đồ Sơn là một tập tục cổ, có từ xa xưa, là một lễ hội truyền thống của người dân vạn chài tại vùng biển Đồ Sơn, Hải Phòng; diễn ra vào ngày 9 tháng 8 Âm lịch hàng năm; là di sản văn hóa phi vật thể quốc gia năm 2020 của Việt Nam. Đây là một lễ hội với lễ nghi trang trọng, rước kiệu thần, có lọng che, phường bát âm....\r
Trong văn hóa cộng đồng người dân Hải Phòng, còn lưu truyền câu ca cổ: "Dù ai buôn đâu bán đâu / Mùng chín tháng tám chọi Trâu thì về\""""@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_ch%E1%BB%8Di_tr%C3%A2u_%C4%90%E1%BB%93_S%C6%A1n> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

