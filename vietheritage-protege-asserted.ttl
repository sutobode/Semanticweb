vhr:registry-fb867e4b336e a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "DTLS Đường Trường Sơn - Đường Hồ Chí Minh"@vi ;
    vh:address "Nghệ An, Hà Tĩnh, Quảng Bình, Quảng Trị, Thừa Thiên Huế, Quảng Nam, Kon Tum, Gia Lai, Đắc Lắc, Đắc Nông, Bình Phước"^^xsd:string ;
    vh:associatedWithEvent vhr:event-46f796e3c0a8,
        vhr:event-6fa18c98b523,
        vhr:event-b79650374533 ;
    vh:constructionYear "1959"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-0963f7238f98,
        vhr:area-name-11e91641fb6c,
        vhr:area-name-352c0cff9935,
        vhr:area-name-441134c12a3e,
        vhr:area-name-574f21fd28ba,
        vhr:area-name-8cb9d0c6b939,
        vhr:area-name-b93dd0ed3491,
        vhr:area-name-c84501090b52,
        vhr:area-name-d493cd7e51ad,
        vhr:area-name-d76be4e8346d ;
    vh:recognitionYear "2013"^^xsd:gYear ;
    vh:sourcePageId 15170 ;
    vh:sourceTitle "Đường Trường Sơn"^^xsd:string ;
    dcterms:description """Đường Trường Sơn, Đường Hồ Chí Minh hay Đường 559, còn có biệt danh là Đường mòn Hồ Chí Minh hay Đường dây "Ông Cụ", là mạng lưới giao thông hậu cần quân sự chạy từ lãnh thổ miền Bắc vào miền Nam Việt Nam, được Quân đội nhân dân Việt Nam phát triển và mở rộng nhằm viện trợ nhân lực, vật lực cho cuộc nổi dậy của lực lượng Việt Minh ở lại và sau này là Mặt trận Dân tộc Giải phóng miền Nam Việt Nam trong Chiến tranh Việt Nam giai đoạn 1959–1975. Xương sống của mạng lưới chạy men theo dãy núi Trường Sơn, bao gồm các tuyến phía Đông ngang dọc Trung Bộ và Tây Nguyên trong khi các tuyến phía Tây tỏa nhánh chằng chịt ở Nam Lào và Đông Campuchia.\r
Trong chiến tranh Việt Nam, Mỹ đã tập trung đánh phá hệ thống giao thông này bằng hàng loạt các chiến dịch bộ binh và không quân. Hàng triệu tấn bom đạn đã được Mỹ ném xuống. Một hệ thống máy móc trinh sát điện tử, được gọi là Hàng rào điện tử McNamara, đã được sử dụng để trinh sát việc vận chuyển và chỉ điểm cho máy bay ném bom. Ngoài ra, quân đội Mỹ còn thường xuyên rải chất độc màu da cam cùng một số loại chất độc diệt cỏ khác để làm trụi rừng cây, các dự án tạo mưa và các chất hóa học tạo bùn cũng được Mỹ sử dụng để cản trở giao thông. Bất chấp tất cả những biện pháp tinh vi và đắt đỏ đó, đường Trường Sơn vẫn không bị cắt đứt mà ngày càng trở nên tinh vi và hoàn thiện hơn. Theo Cơ quan An ninh Quốc gia Hoa Kỳ (National Security Agency), đường Trường Sơn được quân đội Hoa Kỳ coi là "một trong những thành tựu kiến trúc quân sự vĩ đại nhất của thế kỷ 20".\r
Hệ thống đường Trường Sơn ban đầu có lẽ là những tuyến đường mòn thô sơ được thổ dân vùng cao Đông Dương sử dụng cho mục đích mậu dịch thương mại giữa các bản làng, hoặc là những "thượng đạo" kết nối các hậu cứ kháng chiến chống Pháp của phong trào Cần Vương (1885–1896) đời vua Hàm Nghi. Trong những năm tháng Chiến tranh Đông Dương (1945–1954), Việt Minh đã có ý tưởng khai phá con đường nội địa Đông Dương để chi viện cho cuộc kháng chiến chống Pháp ở Nam Bộ. Theo sau sự phân định hai vùng tập kết quân sự tại vĩ tuyến 17 vào năm 1954, lưu thông qua mạng lưới đường sụt giảm đáng kể trong tình hình chiến sự lắng xuống. Với sự sụp đổ của thỏa thuận tổng tuyển cử toàn quốc vào năm 1956 và chính sách đàn áp cộng sản của chế độ Ngô Đình Diệm ở miền Nam, Nghị quyết 15 của Đảng Lao động Việt Nam được thông qua vào năm 1959 tại Hà Nội, chủ trương sử dụng bạo lực cách mạng để đoạt chính quyền ở miền Nam; Đoàn 559 được thành lập, nhận nhiệm vụ mở đường Trường Sơn chi viện cho cuộc nổi dậy ở miền Nam Việt Nam."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-lich-su-duong-truong-son-duong-ho-chi-minh-2969>,
        <https://vi.wikipedia.org/wiki/%C4%90%C6%B0%E1%BB%9Dng_Tr%C6%B0%E1%BB%9Dng_S%C6%A1n> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đường Trường Sơn, Đường Hồ Chí Minh hay Đường 559, còn có biệt danh là Đường mòn Hồ Chí Minh hay Đường dây "Ông Cụ", là mạng lưới giao thông hậu cần quân sự chạy từ lãnh thổ miền Bắc vào miền Nam Việt Nam, được Quân đội nhân dân Việt Nam phát triển và mở rộng nhằm viện trợ nhân lực, vật lực cho cuộc nổi dậy của lực lượng Việt Minh ở lại và sau này là Mặt trận Dân tộc Giải phóng miền Nam Việt Nam trong Chiến tranh Việt Nam giai đoạn 1959–1975. Xương sống của mạng lưới chạy men theo dãy núi Trường Sơn, bao gồm các tuyến phía Đông ngang dọc Trung Bộ và Tây Nguyên trong khi các tuyến phía Tây tỏa nhánh chằng chịt ở Nam Lào và Đông Campuchia.\r
