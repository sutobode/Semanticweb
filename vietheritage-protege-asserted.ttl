vhr:registry-bed91e8d63f3 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Nghi lễ Cấp sắc của người Nùng"@vi ;
    vh:address "Tỉnh Thái Nguyên"^^xsd:string ;
    vh:locatedIn vhr:area-name-8872895663b7 ;
    vh:sourcePageId 18220851 ;
    vh:sourceTitle "Nghi lễ cấp sắc của người Nùng"^^xsd:string ;
    dcterms:description "Hiện nay, đồng bào Nùng phía bắc còn bảo tồn được Nghi lễ cấp sắc; với người Nùng nơi đây, chỉ có những người làm nghề thày cúng mới được cấp sắc, trước khi được cấp sắc, người được cấp sắc phải đảm bảo rất nhiều yêu cầu, nhiều tiêu chuẩn khác nhau, phải có đạo đức tốt, lối sống lành mạnh, khiêm tốn, sống hòa nhã với mọi người. Lễ cấp sắc thông thường có 3 cấp khác nhau, từ thấp lên cao, cấp 1 là cấp thấp nhất, cấp 3 là cấp cao nhất."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Nghi_l%E1%BB%85_c%E1%BA%A5p_s%E1%BA%AFc_c%E1%BB%A7a_ng%C6%B0%E1%BB%9Di_N%C3%B9ng> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment "Hiện nay, đồng bào Nùng phía bắc còn bảo tồn được Nghi lễ cấp sắc; với người Nùng nơi đây, chỉ có những người làm nghề thày cúng mới được cấp sắc, trước khi được cấp sắc, người được cấp sắc phải đảm bảo rất nhiều yêu cầu, nhiều tiêu chuẩn khác nhau, phải có đạo đức tốt, lối sống lành mạnh, khiêm tốn, sống hòa nhã với mọi người. Lễ cấp sắc thông thường có 3 cấp khác nhau, từ thấp lên cao, cấp 1 là cấp thấp nhất, cấp 3 là cấp cao nhất."@vi ;
