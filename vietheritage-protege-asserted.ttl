vhr:registry-efb11858cdd4 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Lễ hội Bà Thu Bồn"@vi ;
    vh:address "Tỉnh Quảng Nam"^^xsd:string ;
    vh:locatedIn vhr:area-name-352c0cff9935 ;
    vh:sourcePageId 19979633 ;
    vh:sourceTitle "Lễ hội Bà Thu Bồn"^^xsd:string ;
    dcterms:description "Lễ hội Bà Thu Bồn (còn được gọi với cái tên là Lệ Bà) là lễ hội truyền thống của cộng đồng cư dân dọc sông Thu Bồn ở Quảng Nam, tổ chức hằng năm từ ngày 10 đến ngày 12 tháng 2 (âm lịch). Không gian thực hành tập trung tại hai cơ sở thờ tự: Lăng Bà Thu Bồn ở xã Duy Tân (Duy Xuyên) và Dinh Bà Thu Bồn ở khu vực Trung Phước/Phường Rạnh thuộc xã Quế Trung. Ngày 30 tháng 9 năm 2020, Bộ Văn hóa, Thể thao và Du lịch ban hành Quyết định số 2731/QĐ-BVHTTDL đưa lễ hội vào Danh mục Di sản văn hóa phi vật thể quốc gia."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_B%C3%A0_Thu_B%E1%BB%93n> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment "Lễ hội Bà Thu Bồn (còn được gọi với cái tên là Lệ Bà) là lễ hội truyền thống của cộng đồng cư dân dọc sông Thu Bồn ở Quảng Nam, tổ chức hằng năm từ ngày 10 đến ngày 12 tháng 2 (âm lịch). Không gian thực hành tập trung tại hai cơ sở thờ tự: Lăng Bà Thu Bồn ở xã Duy Tân (Duy Xuyên) và Dinh Bà Thu Bồn ở khu vực Trung Phước/Phường Rạnh thuộc xã Quế Trung. Ngày 30 tháng 9 năm 2020, Bộ Văn hóa, Thể thao và Du lịch ban hành Quyết định số 2731/QĐ-BVHTTDL đưa lễ hội vào Danh mục Di sản văn hóa phi vật thể quốc gia."@vi ;
