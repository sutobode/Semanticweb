\r
"""@vi ;
    geo1:lat 21.3682242 ;
    geo1:long 105.3214424 ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-lich-su-den-hung-2939>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_H%C3%B9ng> ;
