vhr:registry-d7fe92e1ee10 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Lễ hội Ná nhèm"@vi ;
    vh:address "Xã Trấn Yên, huyện Bắc Sơn, tỉnh Lạng Sơn"^^xsd:string ;
    vh:locatedIn vhr:area-name-133867db9b91 ;
    vh:sourcePageId 19785485 ;
    vh:sourceTitle "Lễ hội Ná Nhèm"^^xsd:string ;
    dcterms:description "Lễ hội Ná Nhèm là một lễ hội phồn thực được tổ chức hàng năm vào mỗi ngày Rằm tháng Giêng âm lịch tại xã Hưng Vũ, tỉnh Lạng Sơn. Theo tiếng Tày, \"Nhá Nhèm\" được hiểu là mặt nhọ. Lễ hội là việc phục dựng lại câu chuyện đánh giặc ngoại xâm của nhân dân cùng các tín ngưỡng, phong tục tập quán địa phương. Đây cũng là lễ hội duy nhất mà con cháu nhà Mạc được hô vạn tế với vua tổ của mình là Mạc Thái Tổ và Mạc Thái Tông."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_N%C3%A1_Nh%C3%A8m> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment "Lễ hội Ná Nhèm là một lễ hội phồn thực được tổ chức hàng năm vào mỗi ngày Rằm tháng Giêng âm lịch tại xã Hưng Vũ, tỉnh Lạng Sơn. Theo tiếng Tày, \"Nhá Nhèm\" được hiểu là mặt nhọ. Lễ hội là việc phục dựng lại câu chuyện đánh giặc ngoại xâm của nhân dân cùng các tín ngưỡng, phong tục tập quán địa phương. Đây cũng là lễ hội duy nhất mà con cháu nhà Mạc được hô vạn tế với vua tổ của mình là Mạc Thái Tổ và Mạc Thái Tông."@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_N%C3%A1_Nh%C3%A8m> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

