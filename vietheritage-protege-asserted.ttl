vhr:registry-904980409990 a vh:ArchaeologicalSite,
        vh:HeritageSite ;
    rdfs:label "DTKC Phật viện Đồng Dương"@vi ;
    vh:address "Tỉnh Quảng Nam"^^xsd:string ;
    vh:locatedIn vhr:area-name-352c0cff9935 ;
    vh:recognitionYear "2016"^^xsd:gYear ;
    vh:sourcePageId 408900 ;
    vh:sourceTitle "Phật viện Đồng Dương"^^xsd:string ;
    dcterms:description "Tháp Đồng Dương là một di tích quan trọng vào bậc nhất của Chăm Pa, gồm có hệ thống các tháp nằm gần nhau, nằm ở làng Đồng Dương, xã Đồng Dương, thành phố Đà Nẵng. Tháp được xây dựng vào thời kỳ Chăm Pa còn bị ảnh hưởng của Phật giáo, nên có tính chất đặc biệt so với các tháp khác trong hệ thống tháp Chăm, nó được mệnh danh là tòa tu viện Phật giáo giữa đô thành. Hệ thống tháp Đồng Dương nằm ngay chính trung tâm đô thành Indrapura trong thời kỳ vương triều Indrapura."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/di-tich-khao-co-va-kien-truc-nghe-thuat-phat-vien-dong-duong-2996>,
        <https://vi.wikipedia.org/wiki/Ph%E1%BA%ADt_vi%E1%BB%87n_%C4%90%E1%BB%93ng_D%C6%B0%C6%A1ng> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment "Tháp Đồng Dương là một di tích quan trọng vào bậc nhất của Chăm Pa, gồm có hệ thống các tháp nằm gần nhau, nằm ở làng Đồng Dương, xã Đồng Dương, thành phố Đà Nẵng. Tháp được xây dựng vào thời kỳ Chăm Pa còn bị ảnh hưởng của Phật giáo, nên có tính chất đặc biệt so với các tháp khác trong hệ thống tháp Chăm, nó được mệnh danh là tòa tu viện Phật giáo giữa đô thành. Hệ thống tháp Đồng Dương nằm ngay chính trung tâm đô thành Indrapura trong thời kỳ vương triều Indrapura."@vi ;
    skos:altLabel "Phật viện Đồng Dương"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/di-tich-khao-co-va-kien-truc-nghe-thuat-phat-vien-dong-duong-2996>,
        <https://vi.wikipedia.org/wiki/Ph%E1%BA%ADt_vi%E1%BB%87n_%C4%90%E1%BB%93ng_D%C6%B0%C6%A1ng> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

