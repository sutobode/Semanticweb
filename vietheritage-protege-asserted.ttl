vhr:registry-2dc9c151de83 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Không gian văn hóa Cồng chiêng Tây Nguyên"@vi ;
    vh:address "Tỉnh Đắk Lắk Tỉnh Đắk Nông Tỉnh Gia Lai Tỉnh Kon Tum Tỉnh Lâm Đồng"^^xsd:string ;
    vh:locatedIn vhr:area-name-0963f7238f98,
        vhr:area-name-574f21fd28ba,
        vhr:area-name-8cb9d0c6b939,
        vhr:area-name-d493cd7e51ad ;
    vh:sourcePageId 57125 ;
    vh:sourceTitle "Không gian văn hóa cồng chiêng Tây Nguyên"^^xsd:string ;
    dcterms:description """Không gian văn hóa cồng chiêng Tây Nguyên được UNESCO công nhận là Kiệt tác truyền khẩu và phi vật thể nhân loại vào ngày 25 tháng 11 năm 2005. Sau Nhã nhạc cung đình Huế, đây là di sản thứ hai của Việt Nam được nhận danh hiệu.\r
Không gian văn hóa Cồng Chiêng Tây Nguyên trải dài ở vùng cao nguyên phía Tây 4 tỉnh Nam Trung Bộ là: Quảng Ngãi, Gia Lai, Đắk Lắk và Lâm Đồng. Chủ thể của không gian văn hóa này gồm nhiều dân tộc khác nhau: Êđê, Jarai, Ba Na, Mạ, Lạch...\r
Không gian văn hóa Cồng Chiêng Tây Nguyên bao gồm các yếu tố bộ phận sau: cồng chiêng, các bản nhạc tấu bằng cồng chiêng, những người chơi cồng chiêng, các lễ hội có sử dụng cồng chiêng (Lễ mừng lúa mới, Lễ cúng Bến nước...), những địa điểm tổ chức các lễ hội đó (nhà dài, nhà rông, nhà gươl, rẫy, bến nước, nhà mồ, các khu rừng cạnh các buôn làng Tây Nguyên,...), v.v.\r
Hiện tại, ở các vùng có cồng chiêng như ở Tây nguyên, Lễ hội Cồng chiêng được tổ chức hàng năm là một hoạt động vừa có ý nghĩa bảo tồn bản sắc văn hóa vừa là một sản phẩm du lịch ăn khách."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Kh%C3%B4ng_gian_v%C4%83n_h%C3%B3a_c%E1%BB%93ng_chi%C3%AAng_T%C3%A2y_Nguy%C3%AAn> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment """Không gian văn hóa cồng chiêng Tây Nguyên được UNESCO công nhận là Kiệt tác truyền khẩu và phi vật thể nhân loại vào ngày 25 tháng 11 năm 2005. Sau Nhã nhạc cung đình Huế, đây là di sản thứ hai của Việt Nam được nhận danh hiệu.\r
Không gian văn hóa Cồng Chiêng Tây Nguyên trải dài ở vùng cao nguyên phía Tây 4 tỉnh Nam Trung Bộ là: Quảng Ngãi, Gia Lai, Đắk Lắk và Lâm Đồng. Chủ thể của không gian văn hóa này gồm nhiều dân tộc khác nhau: Êđê, Jarai, Ba Na, Mạ, Lạch...\r
Không gian văn hóa Cồng Chiêng Tây Nguyên bao gồm các yếu tố bộ phận sau: cồng chiêng, các bản nhạc tấu bằng cồng chiêng, những người chơi cồng chiêng, các lễ hội có sử dụng cồng chiêng (Lễ mừng lúa mới, Lễ cúng Bến nước...), những địa điểm tổ chức các lễ hội đó (nhà dài, nhà rông, nhà gươl, rẫy, bến nước, nhà mồ, các khu rừng cạnh các buôn làng Tây Nguyên,...), v.v.\r
Hiện tại, ở các vùng có cồng chiêng như ở Tây nguyên, Lễ hội Cồng chiêng được tổ chức hàng năm là một hoạt động vừa có ý nghĩa bảo tồn bản sắc văn hóa vừa là một sản phẩm du lịch ăn khách."""@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/Kh%C3%B4ng_gian_v%C4%83n_h%C3%B3a_c%E1%BB%93ng_chi%C3%AAng_T%C3%A2y_Nguy%C3%AAn> ;
