vhr:registry-40889f0bafcb-4c9dbe a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "Động Kính Chủ"@vi ;
    vh:address "Tỉnh Hải Dương"^^xsd:string ;
    vh:locatedIn vhr:area-name-4f99714e585c ;
    vh:recognitionYear "2016"^^xsd:gYear ;
    vh:sourcePageId 783917 ;
    vh:sourceTitle "Động Kính Chủ"^^xsd:string ;
    dcterms:description """Động Kính Chủ hay động Dương Nham là hang động nằm ở vùng đất làng Dương Nham, phường Phạm Sư Mạnh, thành phố Hải Phòng, Việt Nam.\r
Động Kính Chủ được xếp vào hàng Nam thiên đệ lục động (tức là hang động đẹp thứ sáu của trời Nam).\r
Kính Chủ là một trong những di tích quan trọng của tỉnh Hải Dương mà trung tâm là động Kính Chủ. Đây là danh thắng thuộc quần thể An Phụ - Kính Chủ - Nhẫm Dương đã được xếp hạng di tích quốc gia đặc biệt.\r
Động gồm rất nhiều ngọn núi nối liền với nhau. Khi đứng trên đỉnh ngọn núi nhìn ra phía sau ta sẽ nhìn thấy dòng sông Kinh Thầy nằm sát dưới chân núi. Động được mở quanh năm cho khách thập phương đến tham quan, khám phá, cầu nguyện."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%99ng_K%C3%ADnh_Ch%E1%BB%A7> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Động Kính Chủ hay động Dương Nham là hang động nằm ở vùng đất làng Dương Nham, phường Phạm Sư Mạnh, thành phố Hải Phòng, Việt Nam.\r
Động Kính Chủ được xếp vào hàng Nam thiên đệ lục động (tức là hang động đẹp thứ sáu của trời Nam).\r
Kính Chủ là một trong những di tích quan trọng của tỉnh Hải Dương mà trung tâm là động Kính Chủ. Đây là danh thắng thuộc quần thể An Phụ - Kính Chủ - Nhẫm Dương đã được xếp hạng di tích quốc gia đặc biệt.\r
Động gồm rất nhiều ngọn núi nối liền với nhau. Khi đứng trên đỉnh ngọn núi nhìn ra phía sau ta sẽ nhìn thấy dòng sông Kinh Thầy nằm sát dưới chân núi. Động được mở quanh năm cho khách thập phương đến tham quan, khám phá, cầu nguyện."""@vi ;
    geo1:lat 21.032277 ;
    geo1:long 106.505575 ;
    skos:altLabel "DTLS và DLTC Quần thể An Phụ - Kính Chủ - Nhẫm Dương"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%99ng_K%C3%ADnh_Ch%E1%BB%A7> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

vhr:registry-40889f0bafcb-8fa727 a vh:HeritageSite,
        vh:HistoricalSite ;
    rdfs:label "Đền Cao An Phụ"@vi ;
    vh:address "Tỉnh Hải Dương"^^xsd:string ;
    vh:associatedWithPerson vhr:person-wikidata-q704110 ;
    vh:constructionYear "1251"^^xsd:gYear ;
    vh:locatedIn vhr:area-name-4f99714e585c ;
    vh:recognitionYear "2016"^^xsd:gYear ;
    vh:sourcePageId 19709308 ;
    vh:sourceTitle "Đền Cao An Phụ"^^xsd:string ;
    dcterms:description """Đền Cao An Phụ là ngôi đền thờ An Sinh Vương Trần Liễu trên đỉnh núi An Phụ tại phường Phạm Sư Mạnh, thành phố Hải Phòng, trước đây là phường An Sinh, thị xã Kinh Môn, tỉnh Hải Dương.\r
Đền có tên tự là "An Phụ Sơn Từ", tọa lạc trên đỉnh cao nhất của dãy núi An Phụ (246 m). Đây là dãy núi thấp nằm hoàn toàn trên địa bàn thị xã Kinh Môn (cũ) có chiều dài khoảng 17 km, chạy hướng tây bắc - đông nam song song với sông Kinh Thầy."""@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Cao_An_Ph%E1%BB%A5> ;
    dcterms:subject "national_special_monuments" ;
    rdfs:comment """Đền Cao An Phụ là ngôi đền thờ An Sinh Vương Trần Liễu trên đỉnh núi An Phụ tại phường Phạm Sư Mạnh, thành phố Hải Phòng, trước đây là phường An Sinh, thị xã Kinh Môn, tỉnh Hải Dương.\r
Đền có tên tự là "An Phụ Sơn Từ", tọa lạc trên đỉnh cao nhất của dãy núi An Phụ (246 m). Đây là dãy núi thấp nằm hoàn toàn trên địa bàn thị xã Kinh Môn (cũ) có chiều dài khoảng 17 km, chạy hướng tây bắc - đông nam song song với sông Kinh Thầy."""@vi ;
    geo1:lat 21.014192 ;
    geo1:long 106.492662 ;
    skos:altLabel "DTLS và DLTC Quần thể An Phụ - Kính Chủ - Nhẫm Dương"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-tich-quoc-gia-dac-biet-1752>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%81n_Cao_An_Ph%E1%BB%A5> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

