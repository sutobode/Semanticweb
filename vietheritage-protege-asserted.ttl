vhr:registry-59a9f2e4db82 a vh:IntangibleHeritage,
        vh:NationalIntangibleHeritage ;
    rdfs:label "Lễ hội Trường Yên"@vi ;
    vh:address "Xã Trường Yên, huyện Hoa Lư, tỉnh Ninh Bình"^^xsd:string ;
    vh:locatedIn vhr:area-name-dca800e51853 ;
    vh:sourcePageId 182885 ;
    vh:sourceTitle "Lễ hội Hoa Lư"^^xsd:string ;
    dcterms:description "Lễ hội Hoa Lư là một lễ hội truyền thống diễn ra từ ngày 6 đến 10 tháng 3 âm lịch hàng năm tại Quần thể di tích Cố đô Hoa Lư để tôn vinh người anh hùng dân tộc Đinh Bộ Lĩnh đã xây dựng kinh đô Hoa Lư, lập ra nhà nước Đại Cồ Việt và mở đầu thời kỳ độc lập, thống nhất lâu dài của người Việt xuyên suốt các triều đại Đinh - Lê - Lý - Trần. Lễ hội Hoa Lư là di sản văn hóa phi vật thể quốc gia và là lễ hội quan trọng nhất ở Ninh Bình. Lễ hội Hoa Lư có lịch sử lâu đời, phản ánh đậm nét, sinh động về cuộc đời, thân thế và sự nghiệp của đức vua Đinh Tiên Hoàng, được các vương triều phong kiến tổ chức trang trọng ở cấp Nhà nước. Hiện nay, lễ hội Hoa Lư vẫn là lễ hội có tầm ảnh hưởng lớn, bảo lưu được những yếu tố văn hóa, văn nghệ dân gian đặc sắc."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_Hoa_L%C6%B0> ;
    dcterms:subject "national_intangible" ;
    rdfs:comment "Lễ hội Hoa Lư là một lễ hội truyền thống diễn ra từ ngày 6 đến 10 tháng 3 âm lịch hàng năm tại Quần thể di tích Cố đô Hoa Lư để tôn vinh người anh hùng dân tộc Đinh Bộ Lĩnh đã xây dựng kinh đô Hoa Lư, lập ra nhà nước Đại Cồ Việt và mở đầu thời kỳ độc lập, thống nhất lâu dài của người Việt xuyên suốt các triều đại Đinh - Lê - Lý - Trần. Lễ hội Hoa Lư là di sản văn hóa phi vật thể quốc gia và là lễ hội quan trọng nhất ở Ninh Bình. Lễ hội Hoa Lư có lịch sử lâu đời, phản ánh đậm nét, sinh động về cuộc đời, thân thế và sự nghiệp của đức vua Đinh Tiên Hoàng, được các vương triều phong kiến tổ chức trang trọng ở cấp Nhà nước. Hiện nay, lễ hội Hoa Lư vẫn là lễ hội có tầm ảnh hưởng lớn, bảo lưu được những yếu tố văn hóa, văn nghệ dân gian đặc sắc."@vi ;
    skos:altLabel "Lễ hội Hoa Lư"@vi ;
    prov:wasDerivedFrom <https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789>,
        <https://vi.wikipedia.org/wiki/L%E1%BB%85_h%E1%BB%99i_Hoa_L%C6%B0> ;
    prov:wasGeneratedBy vhr:activity-run-7c81f366b12a .

