{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://localhost:3030/vietheritage/schema/identity-review.schema.json",
  "title": "VietHeritageLOD Internal Identity Reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewer", "reviewed_at", "decisions"],
  "properties": {
    "version": {"const": 1},
    "reviewer": {"type": "string", "pattern": ".*\\S.*"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "classification", "decision", "source_record_ids", "evidence", "rationale"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "classification": {"enum": ["MANUAL_DISTINCT", "GRANULARITY_EXCEPTION"]},
          "decision": {"const": "KEEP_DISTINCT"},
          "source_record_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^registry-[a-f0-9]{12}$"}
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "page_id": {"type": "integer", "minimum": 1},
              "wikidata_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"}
            }
          },
          "rationale": {"type": "string", "minLength": 20, "pattern": ".*\\S.*"}
        }
      }
    }
  }
}
