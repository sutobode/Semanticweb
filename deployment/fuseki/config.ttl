@prefix :        <#> .
@prefix fuseki:  <http://jena.apache.org/fuseki#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix tdb2:    <http://jena.apache.org/2016/tdb#> .

[] rdf:type fuseki:Server ;
   fuseki:services (
       :public-service
       :admin-service
       :cq-public-service
       :cq-admin-service
   ) .

:public-service rdf:type fuseki:Service ;
    fuseki:name "vietheritage" ;
    fuseki:dataset :dataset ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceReadGraphStore "data" .

:admin-service rdf:type fuseki:Service ;
    fuseki:name "vietheritage-admin" ;
    fuseki:allowedUsers "admin" ;
    fuseki:dataset :dataset ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceUpload "upload" ;
    fuseki:serviceReadWriteGraphStore "data" .

:cq-public-service rdf:type fuseki:Service ;
    fuseki:name "vietheritage-cq" ;
    fuseki:dataset :cq-dataset ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceReadGraphStore "data" .

:cq-admin-service rdf:type fuseki:Service ;
    fuseki:name "vietheritage-cq-admin" ;
    fuseki:allowedUsers "admin" ;
    fuseki:dataset :cq-dataset ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceUpload "upload" ;
    fuseki:serviceReadWriteGraphStore "data" .

:dataset rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/vietheritage" ;
    tdb2:unionDefaultGraph true .

:cq-dataset rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/vietheritage-cq" ;
    tdb2:unionDefaultGraph true .
